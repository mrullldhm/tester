{
  "metric_version": 1,
  "min_trades": 30,
  "ruin_loss": 25000.0,
  "grid_size": 64,
  "objectives": [
    {
      "key": "net_profit",
      "label": "Net profit",
      "direction": "max",
      "unit": "usd",
      "definition": "Sum of closed-trade profit after commission; excludes open P&L."
    },
    {
      "key": "percent_profitable",
      "label": "Win rate",
      "direction": "max",
      "unit": "percent",
      "definition": "Winning closed trades divided by all closed trades, including breakevens."
    },
    {
      "key": "expectancy",
      "label": "Expectancy",
      "direction": "max",
      "unit": "usd",
      "definition": "Mean net profit per closed trade, including losses and breakevens."
    },
    {
      "key": "profit_factor",
      "label": "Profit factor",
      "direction": "max",
      "unit": "ratio",
      "definition": "Gross winning profit divided by gross losing profit, both after commission. Undefined without losses."
    },
    {
      "key": "payoff_ratio",
      "label": "Payoff ratio",
      "direction": "max",
      "unit": "ratio",
      "definition": "Average net winning trade divided by the absolute average net losing trade. Requires wins and losses."
    },
    {
      "key": "risk_of_ruin",
      "label": "Risk of ruin (estimate)",
      "direction": "min",
      "unit": "percent",
      "definition": "Infinite-horizon diffusion estimate of losing the declared amount from starting capital. Assumes independent, stationary, fixed-size net trade P&L; ignores intratrade losses and margin."
    },
    {
      "key": "max_equity_drawdown",
      "label": "Maximum drawdown",
      "direction": "min",
      "unit": "usd",
      "definition": "Largest equity drawdown under the tester's intrabar TradingView convention, including an open trade at the end."
    },
    {
      "key": "max_consecutive_losses",
      "label": "Consecutive losses",
      "direction": "min",
      "unit": "count",
      "definition": "Longest streak of losing closed trades in execution order. A win or breakeven resets the streak."
    },
    {
      "key": "sharpe_ratio",
      "label": "Sharpe ratio",
      "direction": "max",
      "unit": "ratio",
      "definition": "Monthly marked-to-market excess return divided by population standard deviation, using 2% annual risk-free rate; not annualized."
    },
    {
      "key": "sortino_ratio",
      "label": "Sortino ratio",
      "direction": "max",
      "unit": "ratio",
      "definition": "Monthly marked-to-market excess return divided by downside deviation about the risk-free rate; not annualized."
    },
    {
      "key": "r_multiple",
      "label": "R-multiple",
      "direction": "max",
      "unit": "r",
      "definition": "Mean net trade profit / initial stop risk in dollars. Risk is actual fill to initial stop, before costs. Requires positive initial risk for every closed trade; R standard deviation and mean / standard deviation describe consistency."
    },
    {
      "key": "mae",
      "label": "Maximum adverse excursion (MAE)",
      "direction": "min",
      "unit": "usd",
      "definition": "Mean of each closed trade's maximum adverse price excursion in dollars, before commission; only the exposed intrabar path counts."
    },
    {
      "key": "mfe",
      "label": "Maximum favorable excursion (MFE)",
      "direction": "max",
      "unit": "usd",
      "definition": "Mean of each closed trade's maximum favorable price excursion in dollars, before commission; only the exposed intrabar path counts. Unrealized opportunity, not realized profit."
    }
  ],
