// Swing event rules from docs/SWINGS.md and cltester/swings.py.
const int HIGH = 1
const int LOW = -1
const int UNKNOWN = 0

type SwingZone
    int startsAt
    int endsAt
    float bottom
    float top
    float displayOffset = 0.0
    int approach = 0
    int stoppedAt = na
    bool invalidated = false

type ZoneDrawing
    SwingZone zone
    box drawing

// Choose the price overlap with the most participating candles. If only two
// overlap, prefer the widest pair. Equal widths prefer a pair with candle 2.
findSwingZone(int startsAt, int endsAt, float leftHigh, float leftLow, float centerHigh, float centerLow, float rightHigh, float rightLow) =>
    float bottom = math.max(leftLow, centerLow, rightLow)
    float top = math.min(leftHigh, centerHigh, rightHigh)
    if top <= bottom
        bottom := math.max(leftLow, centerLow)
        top := math.min(leftHigh, centerHigh)

        float centerRightBottom = math.max(centerLow, rightLow)
        float centerRightTop = math.min(centerHigh, rightHigh)
        if centerRightTop - centerRightBottom > top - bottom
            bottom := centerRightBottom
            top := centerRightTop

        float outerBottom = math.max(leftLow, rightLow)
        float outerTop = math.min(leftHigh, rightHigh)
        if outerTop - outerBottom > top - bottom
            bottom := outerBottom
            top := outerTop
    top > bottom ? SwingZone.new(startsAt, endsAt, bottom, top) : na

type SwingPoint
    int side
    float price
    int candleTime
    int plotTime
    int eventIndex
    float displayOffset
    SwingZone zone

type SwingEventLevel
    array<float> highs
    array<float> lows

type ZigZag
    array<SwingPoint> points
    array<SwingEventLevel> eventLevels
    float leftHigh = na
    float leftLow = na
    int leftTime = na
    float centerHigh = na
    float centerLow = na
    int centerTime = na
    float centerOffset = 0.0
    int centerHighChartTime = na
    int centerLowChartTime = na
    float centerHighOffset = 0.0
    float centerLowOffset = 0.0
    int centerOrder = 0
    bool changed = false
    array<polyline> drawings = na
    bool trackZones = false
    array<ZoneDrawing> zoneDrawings = na
    array<SwingZone> openZones = na
    float nextUpperTouch = na
    float nextLowerTouch = na
    bool hasUnclassifiedZones = false
    int bucket = na
    int bucketStart = na
    int bucketEnd = na
    float bucketOffset = 0.0
    float bucketHigh = na
    float bucketLow = na
    float bucketClose = na
    int highMinute = na
    int lowMinute = na
    int highChartTime = na
    int lowChartTime = na
    float highOffset = 0.0
    float lowOffset = 0.0

newZigZag(bool trackZones) =>
    ZigZag.new(array.new<SwingPoint>(), array.from(SwingEventLevel.new(array.new<float>(), array.new<float>())), drawings = array.new<polyline>(), trackZones = trackZones, zoneDrawings = array.new<ZoneDrawing>(), openZones = array.new<SwingZone>())

method appendEvent(ZigZag state, int side, float price) =>
    int level = 0
    int index = state.eventLevels.first().highs.size()
    float eventHigh = side == HIGH ? price : na
    float eventLow = side == LOW ? price : na
    while true
        if level == state.eventLevels.size()
            state.eventLevels.push(SwingEventLevel.new(array.new<float>(), array.new<float>()))
        SwingEventLevel events = state.eventLevels.get(level)
        events.highs.push(eventHigh)
        events.lows.push(eventLow)
        if index % 2 == 0
            break
        float priorHigh = events.highs.get(index - 1)
        float priorLow = events.lows.get(index - 1)
        eventHigh := na(eventHigh) ? priorHigh : math.max(eventHigh, nz(priorHigh, eventHigh))
        eventLow := na(eventLow) ? priorLow : math.min(eventLow, nz(priorLow, eventLow))
        index := int(index / 2)
        level += 1

method removeEvent(ZigZag state) =>
    int level = 0
    int index = state.eventLevels.first().highs.size() - 1
    while true
        SwingEventLevel events = state.eventLevels.get(level)
        events.highs.pop()
        events.lows.pop()
        if index % 2 == 0
            break
        index := int(index / 2)
        level += 1

exceedsExtreme(float other, int side, float price) =>
    not na(other) and (side == HIGH ? other > price : other < price)

method isExtreme(ZigZag state, int side, float price, int firstEvent, int lastEvent) =>
    int left = firstEvent
    int right = lastEvent
    int level = 0
    bool valid = true
    while left <= right
        SwingEventLevel events = state.eventLevels.get(level)
        array<float> prices = side == HIGH ? events.highs : events.lows
        if left % 2 == 1
            if exceedsExtreme(prices.get(left), side, price)
                valid := false
                break
            left += 1
        if left <= right and right % 2 == 0
            if exceedsExtreme(prices.get(right), side, price)
                valid := false
                break
            right -= 1
        if left > right
            break
        left := int(left / 2)
        right := int(right / 2)
        level += 1
    valid

// The first removed prior point determines whether an unknown outside-candle
// order needs to be retried. Keep any other removed points for that rollback.
method offer(ZigZag state, SwingPoint candidate, array<SwingPoint> removed, bool firstRemovalByRange) =>
    bool retry = firstRemovalByRange
    while true
        int count = state.points.size()
        if count == 0
            if state.isExtreme(candidate.side, candidate.price, 0, candidate.eventIndex)
                state.points.push(candidate)
                state.changed := true
            break

        SwingPoint last = state.points.last()
        bool sameSide = last.side == candidate.side
        if sameSide
            if (candidate.side == HIGH ? candidate.price < last.price : candidate.price > last.price)
                break
        else
            if not state.isExtreme(candidate.side, candidate.price, last.eventIndex + 1, candidate.eventIndex)
                break
            int previousEvent = count > 1 ? state.points.get(count - 2).eventIndex + 1 : 0
            if state.isExtreme(last.side, last.price, previousEvent, candidate.eventIndex - 1)
                state.points.push(candidate)
                state.changed := true
                break

        state.points.pop()
        state.changed := true
        if not na(removed) and last.candleTime < candidate.candleTime
            if removed.size() == 0
                retry := not sameSide
            removed.push(last)
    retry

method processCenter(ZigZag state, int firstSide, bool swingHigh, bool swingLow, array<SwingPoint> removed, SwingZone zone) =>
    bool retry = false
    for slot = 0 to 1
        int side = slot == 0 ? firstSide : -firstSide
        int eventIndex = state.eventLevels.first().highs.size()
        float price = side == HIGH ? state.centerHigh : state.centerLow
        state.appendEvent(side, price)
        if (side == HIGH ? swingHigh : swingLow)
            int plotTime = side == HIGH ? state.centerHighChartTime : state.centerLowChartTime
            float plotOffset = side == HIGH ? state.centerHighOffset : state.centerLowOffset
            retry := state.offer(SwingPoint.new(side, price, state.centerTime, plotTime, eventIndex, plotOffset, zone), removed, retry)
    retry

method invalidateTouch(ZigZag state, float tradedHigh, float tradedLow) =>
    int count = state.points.size()
    if count >= 2
        SwingPoint last = state.points.last()
        SwingPoint previous = state.points.get(count - 2)
        if last.candleTime == previous.candleTime and (last.side == HIGH ? tradedHigh >= last.price : tradedLow <= last.price)
            state.points.pop()
            state.changed := true

// A new adverse extreme invalidates the newest swing's zone until an
// opposite swing confirms. A strict break is required for this zone rule.
method invalidateBrokenSwingZone(ZigZag state, float tradedHigh, float tradedLow) =>
    if state.points.size() > 0
        SwingPoint latest = state.points.last()
        if not na(latest.zone) and not latest.zone.invalidated
            bool broken = latest.side == LOW ? tradedLow < latest.price : tradedHigh > latest.price
            if broken
                latest.zone.invalidated := true
                state.changed := true

// Only scan the open zones when one can change. This avoids walking all
// untouched historical zones on every minute of a long trend.
method indexOpenZone(ZigZag state, SwingZone zone) =>
    if zone.approach == LOW
        state.nextUpperTouch := na(state.nextUpperTouch) ? zone.top : math.min(state.nextUpperTouch, zone.top)
    if zone.approach == HIGH
        state.nextLowerTouch := na(state.nextLowerTouch) ? zone.bottom : math.max(state.nextLowerTouch, zone.bottom)
    state.hasUnclassifiedZones := state.hasUnclassifiedZones or zone.approach == UNKNOWN

method updateZoneTouches(ZigZag state, int tradeTime, int chartBarTime, float opening, float highest, float lowest) =>
    if state.hasUnclassifiedZones or highest >= state.nextUpperTouch or lowest <= state.nextLowerTouch
        state.nextUpperTouch := na
        state.nextLowerTouch := na
        state.hasUnclassifiedZones := false
        int count = state.openZones.size()
        if count > 0
            for i = count - 1 to 0
                SwingZone zone = state.openZones.get(i)
                if tradeTime >= zone.endsAt and not zone.invalidated
                    if zone.approach == UNKNOWN
                        if opening <= zone.bottom
                            zone.approach := LOW
                        else if opening >= zone.top
                            zone.approach := HIGH
                        else if highest >= zone.top and lowest <= zone.bottom
                            zone.stoppedAt := chartBarTime
                        else if lowest < zone.bottom
                            zone.approach := LOW
                        else if highest > zone.top
                            zone.approach := HIGH

                    if (zone.approach == LOW and highest >= zone.top) or (zone.approach == HIGH and lowest <= zone.bottom)
                        zone.stoppedAt := chartBarTime

                if zone.invalidated or not na(zone.stoppedAt)
                    // Swap with the tail to remove in constant time.
                    SwingZone tail = state.openZones.pop()
                    if i < state.openZones.size()
                        state.openZones.set(i, tail)
                    continue
                state.indexOpenZone(zone)

method closeCandle(ZigZag state, int candleTime, int candleEnd, float candleHigh, float candleLow, float candleClose, int order, float displayOffset, int highChartTime, int lowChartTime, float highOffset, float lowOffset) =>
    if not na(state.centerTime)
        bool swingHigh = state.centerHigh >= state.leftHigh and state.centerHigh > candleHigh
        bool swingLow = state.centerLow <= state.leftLow and state.centerLow < candleLow
        SwingZone zone = na
        if state.trackZones and (swingHigh or swingLow)
            zone := findSwingZone(state.leftTime, candleEnd, state.leftHigh, state.leftLow, state.centerHigh, state.centerLow, candleHigh, candleLow)
        int count = state.points.size()
        int firstSide = state.centerOrder
        if state.centerOrder == UNKNOWN
            firstSide := count > 0 and state.points.last().side == LOW ? HIGH : LOW

        array<SwingPoint> removed = na
        if state.centerOrder == UNKNOWN and swingHigh and swingLow and count > 0
            removed := array.new<SwingPoint>()
        if state.processCenter(firstSide, swingHigh, swingLow, removed, zone)
            while state.points.size() > 0 and state.points.last().candleTime == state.centerTime
                state.points.pop()
            while removed.size() > 0
                state.points.push(removed.pop())
            for slot = 0 to 1
                state.removeEvent()
            state.processCenter(-firstSide, swingHigh, swingLow, na, zone)

        if not na(zone) and state.points.size() > 0 and state.points.last().candleTime == state.centerTime
            zone.displayOffset := state.centerOffset
            zone.approach := candleClose < zone.bottom ? LOW : candleClose > zone.top ? HIGH : UNKNOWN
            state.openZones.push(zone)
            state.indexOpenZone(zone)

    state.leftHigh := state.centerHigh
    state.leftLow := state.centerLow
    state.leftTime := state.centerTime
    state.centerHigh := candleHigh
    state.centerLow := candleLow
    state.centerTime := candleTime
    state.centerOffset := displayOffset
    state.centerHighChartTime := highChartTime
    state.centerLowChartTime := lowChartTime
    state.centerHighOffset := highOffset
    state.centerLowOffset := lowOffset
    state.centerOrder := order

method draw(ZigZag state, color stroke, string style, int width) =>
    for drawing in state.drawings
        polyline.delete(drawing)
    state.drawings.clear()

    int count = state.points.size()
    if count >= 2
        for first = 0 to count - 2 by 9999
            array<chart.point> coordinates = array.new<chart.point>()
            for i = first to math.min(first + 9999, count - 1)
                SwingPoint point = state.points.get(i)
                coordinates.push(chart.point.from_time(point.plotTime, point.price + point.displayOffset))
            state.drawings.push(polyline.new(coordinates, xloc = xloc.bar_time, line_color = stroke, line_style = style, line_width = width))

method clearZoneDrawings(ZigZag state) =>
    for item in state.zoneDrawings
        box.delete(item.drawing)
    state.zoneDrawings.clear()

method drawZones(ZigZag state, int limit, color fillColor, int chartBarTime) =>
    int count = state.points.size()
    if count > 0
        int lastCandle = na
        for i = count - 1 to 0
            SwingPoint point = state.points.get(i)
            if not na(point.zone) and not point.zone.invalidated and (na(lastCandle) or point.candleTime != lastCandle)
                SwingZone zone = point.zone
                lastCandle := point.candleTime
                int rightTime = na(zone.stoppedAt) ? chartBarTime : zone.stoppedAt
                box drawing = box.new(zone.startsAt, zone.top + zone.displayOffset, rightTime, zone.bottom + zone.displayOffset,
                     xloc = xloc.bar_time, border_color = na, bgcolor = fillColor)
                state.zoneDrawings.push(ZoneDrawing.new(zone, drawing))
                if state.zoneDrawings.size() >= limit
                    break

method extendOpenDrawings(ZigZag state, int chartBarTime) =>
    for item in state.zoneDrawings
        int rightTime = na(item.zone.stoppedAt) ? chartBarTime : item.zone.stoppedAt
        if box.get_right(item.drawing) != rightTime
            box.set_right(item.drawing, rightTime)

method countZones(ZigZag state, int limit) =>
    int total = 0
    int lastCandle = na
    int count = state.points.size()
    if count > 0
        for i = count - 1 to 0
            SwingPoint point = state.points.get(i)
            if not na(point.zone) and not point.zone.invalidated and (na(lastCandle) or point.candleTime != lastCandle)
                lastCandle := point.candleTime
                total += 1
                if total >= limit
                    break
    total

type ZoneLayer
    ZigZag engine
    color fill

renderZones(array<ZoneLayer> layers, int budget) =>
    array<int> demand = array.new<int>()
    array<int> allowance = array.new<int>(layers.size(), 0)
    int remaining = budget
    int needsSlots = 0
    for layer in layers
        int count = layer.engine.countZones(budget)
        demand.push(count)
        if count > 0
            needsSlots += 1

    // Lend unused drawing slots to timeframes with more confirmed zones.
    while remaining > 0 and needsSlots > 0
        int share = math.max(1, int(remaining / needsSlots))
        for [i, count] in demand
            int unmet = count - allowance.get(i)
            if unmet > 0
                int granted = math.min(unmet, share, remaining)
                allowance.set(i, allowance.get(i) + granted)
                remaining -= granted
                if granted == unmet
                    needsSlots -= 1
                if remaining == 0
                    break

    // Clear outgoing drawings first so Pine never evicts another layer's box.
    for [i, layer] in layers
        if layer.engine.changed or layer.engine.zoneDrawings.size() != allowance.get(i)
            layer.engine.clearZoneDrawings()
    for [i, layer] in layers
        int limit = allowance.get(i)
        if limit > 0 and layer.engine.zoneDrawings.size() == 0
            layer.engine.drawZones(limit, layer.fill, time)
        layer.engine.extendOpenDrawings(time)

method finishBucket(ZigZag state) =>
    int order = state.highMinute == state.lowMinute ? UNKNOWN : state.highMinute < state.lowMinute ? HIGH : LOW
    state.closeCandle(state.bucketStart, state.bucketEnd, state.bucketHigh, state.bucketLow, state.bucketClose, order, state.bucketOffset, state.highChartTime, state.lowChartTime, state.highOffset, state.lowOffset)
    state.bucket := na

method ingestSwingMinute(ZigZag state, int key, bool lastMinute, int startsAt, float displayOffset, int endsAt, int chartBarTime, float tradedHigh, float tradedLow, float tradedClose, int highAt = na, int lowAt = na) =>
    state.invalidateBrokenSwingZone(tradedHigh, tradedLow)
    // The next observed minute can close a candle whose scheduled last
    // minute was missing. Its touch applies both before and after that close.
    if not na(state.bucket) and key != state.bucket
        state.invalidateTouch(tradedHigh, tradedLow)
        state.finishBucket()
        state.invalidateBrokenSwingZone(tradedHigh, tradedLow)
    state.invalidateTouch(tradedHigh, tradedLow)

    if na(state.bucket)
        state.bucket := key
        state.bucketStart := startsAt
        state.bucketHigh := tradedHigh
        state.bucketLow := tradedLow
        state.highMinute := nz(highAt, startsAt)
        state.lowMinute := nz(lowAt, startsAt)
        state.highChartTime := na(highAt) ? chartBarTime : chartSeconds >= 3600 ? chartBarTime : highAt - highAt % (chartSeconds * 1000)
        state.lowChartTime := na(lowAt) ? chartBarTime : chartSeconds >= 3600 ? chartBarTime : lowAt - lowAt % (chartSeconds * 1000)
        state.highOffset := displayOffset
        state.lowOffset := displayOffset
    else
        if tradedHigh > state.bucketHigh
            state.bucketHigh := tradedHigh
            state.highMinute := nz(highAt, startsAt)
            state.highChartTime := na(highAt) ? chartBarTime : chartSeconds >= 3600 ? chartBarTime : highAt - highAt % (chartSeconds * 1000)
            state.highOffset := displayOffset
        if tradedLow < state.bucketLow
            state.bucketLow := tradedLow
            state.lowMinute := nz(lowAt, startsAt)
            state.lowChartTime := na(lowAt) ? chartBarTime : chartSeconds >= 3600 ? chartBarTime : lowAt - lowAt % (chartSeconds * 1000)
            state.lowOffset := displayOffset
    state.bucketClose := tradedClose
    state.bucketEnd := endsAt
    state.bucketOffset := displayOffset
    if lastMinute
        state.finishBucket()

const string CHICAGO = "America/Chicago"
const int MINUTE_MS = 60000
const int DAY_MS = 86400000
const int CME_DAY_CLOSE = 1379

clTradingDay(int startsAt, int chicagoMinute) =>
    // UTC midnight is a date key only. The date itself is Chicago-local.
    int dateKey = timestamp("UTC", year(startsAt, CHICAGO), month(startsAt, CHICAGO), dayofmonth(startsAt, CHICAGO), 0, 0)
    dateKey + (chicagoMinute >= 1020 ? DAY_MS : 0)

clBucket(int slot, int startsAt, int tradingDay, int sessionMinute) =>
    bool dayEnd = sessionMinute == CME_DAY_CLOSE
    switch slot
        0 =>
            int tradingMonth = month(tradingDay, "UTC")
            // The last weekday's next business date lies in the following month.
            int nextBusinessDay = tradingDay + (dayofweek(tradingDay, "UTC") == dayofweek.friday ? 3 : 1) * DAY_MS
            [year(tradingDay, "UTC") * 12 + tradingMonth, dayEnd and month(nextBusinessDay, "UTC") != tradingMonth]
        1 =>
            int weekday = dayofweek(tradingDay, "UTC")
            [tradingDay - ((weekday + 5) % 7) * DAY_MS, dayEnd and weekday == dayofweek.friday]
        2 => [tradingDay, dayEnd]
        3 => [int(tradingDay / DAY_MS) * 10 + int(sessionMinute / 240), (sessionMinute + 1) % 240 == 0 or dayEnd]
        =>
            int clockLength = slot == 4 ? 60 : slot == 5 ? 30 : slot == 6 ? 15 : slot == 7 ? 5 : 1
            int unixMinute = int(startsAt / MINUTE_MS)
            [int(unixMinute / clockLength), (unixMinute + 1) % clockLength == 0]

clSessionOpen(int tradingDay) =>
    int priorDate = tradingDay - DAY_MS
    timestamp(CHICAGO, year(priorDate, "UTC"), month(priorDate, "UTC"), dayofmonth(priorDate, "UTC"), 17, 0)

clBucketOpen(int slot, int startsAt, int tradingDay, int sessionMinute) =>
    switch slot
        0 =>
            int monthStart = timestamp("UTC", year(tradingDay, "UTC"), month(tradingDay, "UTC"), 1, 0, 0)
            int weekday = dayofweek(monthStart, "UTC")
            int firstTradingDay = monthStart + (weekday == dayofweek.saturday ? 2 : weekday == dayofweek.sunday ? 1 : 0) * DAY_MS
            clSessionOpen(firstTradingDay)
        1 => clSessionOpen(tradingDay - ((dayofweek(tradingDay, "UTC") + 5) % 7) * DAY_MS)
        2 => clSessionOpen(tradingDay)
        3 => clSessionOpen(tradingDay) + int(sessionMinute / 240) * 240 * MINUTE_MS
        =>
            int lengthMs = (slot == 4 ? 60 : slot == 5 ? 30 : slot == 6 ? 15 : slot == 7 ? 5 : 1) * MINUTE_MS
            startsAt - startsAt % lengthMs

type MonthlyHour
    int startsAt
    int endsAt
    float opening
    float highest
    float lowest
    float closing
    int highAt
    int lowAt

monthlyHour() =>
    [minuteStarts, minuteHighs, minuteLows] = request.security_lower_tf(syminfo.tickerid, "1", [time, high, low], calc_bars_count = 100000)
    int highIndex = minuteHighs.indexof(high)
    int lowIndex = minuteLows.indexof(low)
    int highAt = highIndex >= 0 ? minuteStarts.get(highIndex) : time
    int lowAt = lowIndex >= 0 ? minuteStarts.get(lowIndex) : time
    // No sub-hour order is asserted when one extreme is missing.
    if highIndex < 0 or lowIndex < 0
        highAt := time
        lowAt := time
    MonthlyHour.new(time, time_close, open, high, low, close, highAt, lowAt)

monthlyHours(string symbol, int seconds) =>
    if seconds > 3600
        request.security_lower_tf(symbol, "60", monthlyHour(), calc_bars_count = 100000)
    else
        MonthlyHour prior = request.security(symbol, "60", monthlyHour()[1], lookahead = barmerge.lookahead_on)
        MonthlyHour current = request.security(symbol, "60", monthlyHour(), lookahead = barmerge.lookahead_off)
        array.from(prior, current)

type SwingLayer
    ZigZag engine
    int slot
    color stroke
    string style
    int width
    bool showLine
    color zoneColor
    bool sawFirstMinute = false
    int partialBucket = na


method acceptSwingMinute(SwingLayer layer, int key, int startsAt, int bucketOpen) =>
    if not layer.sawFirstMinute
        layer.sawFirstMinute := true
        if startsAt > bucketOpen
            layer.partialBucket := key
    na(layer.partialBucket) or key != layer.partialBucket

// On sub-minute charts wait for the actual one-minute source to close.
confirmedMinuteFeed(string symbol) =>
    [starts, ends, opens, highs, lows, closes, s0, e0, s1, e1, s2, e2, s3, e3, s4, e4, s5, e5, s6, e6, s7, e7, chartStarts, chartEnds] = request.security(symbol, "1", minuteData(1), lookahead = barmerge.lookahead_on)
    [liveStarts, liveEnds, liveOpens, liveHighs, liveLows, liveCloses, liveS0, liveE0, liveS1, liveE1, liveS2, liveE2, liveS3, liveE3, liveS4, liveE4, liveS5, liveE5, liveS6, liveE6, liveS7, liveE7, liveChartStarts, liveChartEnds] = request.security(symbol, "1", minuteData(0), lookahead = barmerge.lookahead_off)
    MinuteFeed.new(array.from(starts, liveStarts), array.from(ends, liveEnds), array.from(opens, liveOpens), array.from(highs, liveHighs), array.from(lows, liveLows), array.from(closes, liveCloses),
             array.from(MinuteBounds.new(array.from(s0, liveS0), array.from(e0, liveE0)),
                 MinuteBounds.new(array.from(s1, liveS1), array.from(e1, liveE1)),
                 MinuteBounds.new(array.from(s2, liveS2), array.from(e2, liveE2)),
                 MinuteBounds.new(array.from(s3, liveS3), array.from(e3, liveE3)),
                 MinuteBounds.new(array.from(s4, liveS4), array.from(e4, liveE4)),
                 MinuteBounds.new(array.from(s5, liveS5), array.from(e5, liveE5)),
                 MinuteBounds.new(array.from(s6, liveS6), array.from(e6, liveE6)),
                 MinuteBounds.new(array.from(s7, liveS7), array.from(e7, liveE7)),
                 MinuteBounds.new(array.from(starts, liveStarts), array.from(ends, liveEnds)),
                 MinuteBounds.new(array.from(chartStarts, liveChartStarts), array.from(chartEnds, liveChartEnds))))

