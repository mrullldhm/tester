//@version=6
// CL candle ranges, not swing detection. Only completed higher-timeframe candles.
// A box is drawn over its source candle when the next source candle begins.
indicator("Candle Range Box", overlay = true, max_boxes_count = 500)

keep = input.int(30, "Boxes per timeframe", minval = 1, maxval = 60)

show1 = input.bool(true, "1 minute")
show5 = input.bool(true, "5 minutes")
show15 = input.bool(true, "15 minutes")
showH = input.bool(true, "1 hour")
show4H = input.bool(true, "4 hours")
showD = input.bool(true, "Daily")
showW = input.bool(true, "Weekly")
showM = input.bool(true, "Monthly")

if syminfo.root != "CL"
    runtime.error("Use this indicator on a CL chart.")

if not chart.is_standard
    runtime.error("Use a standard candlestick or bar chart.")

// Each written call maintains its own collection of boxes.
drawBoxes(string tf, string name, bool enabled, color tint) =>
    var array<box> history = array.new<box>()

    bool higher = timeframe.in_seconds(tf) > timeframe.in_seconds()

    if enabled and higher
        [startTime, endTime, candleHigh, candleLow] = request.security(
             syminfo.tickerid, tf,
             [time[1], time_close[1], high[1], low[1]],
             lookahead = barmerge.lookahead_on)

        bool newCandle = not na(startTime) and (
             na(startTime[1]) or startTime != startTime[1])

        if newCandle
            box b = box.new(
                 left = startTime,
                 top = candleHigh,
                 right = endTime,
                 bottom = candleLow,
                 xloc = xloc.bar_time,
                 border_color = tint,
                 border_width = 1,
                 bgcolor = color.new(tint, 96),
                 text = name,
                 text_color = tint,
                 text_size = size.tiny,
                 text_halign = text.align_left,
                 text_valign = text.align_top)

            array.push(history, b)

            if array.size(history) > keep
                box.delete(array.shift(history))
    0

drawBoxes("1",   "1m", show1,  color.gray)
drawBoxes("5",   "5m", show5,  color.aqua)
drawBoxes("15", "15m", show15, color.teal)
drawBoxes("60",  "1H", showH,  color.blue)
drawBoxes("240", "4H", show4H, color.orange)
drawBoxes("1D",   "D", showD,  color.red)
drawBoxes("1W",   "W", showW,  color.purple)
drawBoxes("1M",   "M", showM,  color.fuchsia)
