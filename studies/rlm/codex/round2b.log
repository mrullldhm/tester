    83	def rma(x, n: int) -> pd.Series:
    84	    """Wilder smoothing (TradingView ta.rma): seeded with the SMA of the first n values."""
    85	    series = _s(x)
    86	    s = series.to_numpy(float)
    87	    out = np.full(len(s), np.nan)
    88	    ok = np.flatnonzero(~np.isnan(s))
    89	    if len(ok) < n:
    90	        return pd.Series(out, index=series.index)
    91	    start = ok[0] + n - 1
    92	    out[start] = np.mean(s[ok[0]:start + 1])
    93	    a = 1.0 / n
    94	    for k in range(start + 1, len(s)):
    95	        out[k] = out[k - 1] + a * (s[k] - out[k - 1])

