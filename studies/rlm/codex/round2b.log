    52	def table(t: pd.DataFrame, f: str, rng: np.random.Generator, boots: int = 300) -> pd.DataFrame:
    53	    x = t[f]
    54	    grp = pd.qcut(x.rank(method="first"), 5, labels=False) if x.nunique() > 6 else x
    55	    rows = []
    56	    for g, d in t.groupby(grp):
    57	        days = d["trading_day"].to_numpy()
    58	        ud = np.unique(days)
    59	        by = d.groupby("trading_day")["Rmult"].agg(["sum", "count"])
    60	        bs = []
    61	        for _ in range(boots):  # day-clustered bootstrap of avg R
    62	            pick = by.iloc[rng.integers(0, len(by), len(by))]
    63	            bs.append(pick["sum"].sum() / pick["count"].sum())
    64	        win, loss = d.loc[d["net"] > 0, "net"].sum(), -d.loc[d["net"] < 0, "net"].sum()
    65	        rows.append({"feature": f, "bin": g, "lo": round(float(d[f].min()), 3), "hi": round(float(d[f].max()), 3),
    66	                     "trades": len(d), "days": len(ud), "win": round((d["net"] > 0).mean(), 3),
    67	                     "avgR": round(d["Rmult"].mean(), 3), "ci05": round(np.quantile(bs, 0.05), 3),
    68	                     "ci95": round(np.quantile(bs, 0.95), 3), "pf": round(win / loss, 3) if loss else np.nan,
    69	                     "net": round(d["net"].sum())})
    70	    return pd.DataFrame(rows)
