    41	def on_1m(values, avail: np.ndarray, n: int) -> np.ndarray:
    42	    """Per 1m bar, the value of the newest candle complete at that bar's close (NaN before the first)."""
    43	    v = np.asarray(values, dtype=float)
    44	    if len(v) == 0:  # warm-up: no candle complete yet
    45	        return np.full(n, np.nan)
    46	    src = np.full(n, -1, dtype=np.int64)
    47	    ok = avail < n
    48	    src[avail[ok]] = np.flatnonzero(ok)  # several candles on one bar: the last one wins
    49	    src = np.maximum.accumulate(src)
    50	    out = np.where(src >= 0, v[np.maximum(src, 0)], np.nan)
    51	    return out
