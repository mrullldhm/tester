    36	def load_bars(start: str | None = None, end: str | None = None) -> pd.DataFrame:
    37	    """Bars with start <= ts < end (UTC dates or timestamps; end exclusive)."""
    38	    paths = sorted(DATA_DIR.glob("year=*.parquet"))
    39	    if not paths:
