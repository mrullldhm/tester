   296	        else:
   297	            self.refit(s, a)
   298	
   299	    def _merge_overlaps(self, t: int, a: float) -> None:
   300	        for _ in range(MERGE_PASSES):
   301	            again = False
   302	            for k in np.flatnonzero(self.alive)[::-1]:
   303	                if k != t and self.alive[k] and self.lo[k] <= self.hi[t] and self.lo[t] <= self.hi[k]:
   304	                    self._merge(t, int(k), a)
   305	                    again = True
   306	            if not again:
   307	                break
   308	
   309	    def age_cross(self, close: float, decay: float, c: int) -> None:
   310	        al = self.alive
   311	        self.strength[al] *= decay
   312	        self.ls[al] += np.log(decay)
   313	        new = np.where(close > self.hi, 1.0, np.where(close < self.lo, -1.0, self.side))
   314	        ch = al & (new != self.side)
   315	        hit = ch & (self.touches >= MIN_TOUCHES)
   316	        self.crosses[hit] += 1
   317	        self.strength[hit] *= CROSS_PENALTY
   318	        self.ls[hit] += np.log(CROSS_PENALTY)
   319	        self.side[ch] = new[ch]
   320	        self.sidebar[ch] = c
   321	        for s in np.flatnonzero(al & (self.strength < MIN_STRENGTH)):
   322	            self._kill(int(s))
   323	
   324	    def score(self, s) -> np.ndarray:
   325	        polar = (self.ht[s] > 0) & (self.lt[s] > 0)
   326	        return 100.0 * (1.0 - np.exp(-self.strength[s] * np.where(polar, POLARITY_BONUS, 1.0) / SCORE_SCALE))
   327	
   328	    def nearest(self, side: int, close: float) -> np.ndarray:
   329	        cand = np.flatnonzero(self.alive & (self.touches >= MIN_TOUCHES) & (self.side == side))
   330	        if not len(cand):
   331	            return cand
   332	        order = np.argsort(np.abs(close - self.mid[cand]), kind="stable")
   333	        return cand[order[:PER_SIDE]]
   334	
   335	
   336	def candidates(df: pd.DataFrame, sig_tf: str, reg: str, sources: str, weight: str, tol: float) -> pd.DataFrame:
   337	    """Every rejection signal of the level engine, for all COMBOS at once (one row per candle, side and combo)."""
   338	    key = _content_key(df)
   339	    ck = (key, sig_tf, reg, sources, weight, tol)
   340	    if ck in _CANDS:
   341	        return _CANDS[ck]
   342	    cd = build_candles(df, sig_tf)
   343	    n_c = len(cd)
   344	    m_sig = TIMEFRAMES[sig_tf]
   345	    tfs = [t for t in SOURCES if (TIMEFRAMES[t] >= m_sig if sources == "all" else TIMEFRAMES[t] > m_sig)]
   346	    ev = pd.concat([swing_events(df, t, reg, key).assign(tf=i, w=TF_WEIGHT[t] if weight == "tf" else 1.0)
   347	                    for i, t in enumerate(tfs)], ignore_index=True)
   348	    ev = ev.sort_values(["known", "tf", "op"], kind="stable")  # same bar: lower TF first, withdrawals first
   349	    lk = ev[["known", "op", "kind", "price", "first", "last", "ref_first", "candle", "tf", "w"]].to_numpy()
   350	    lk_known = ev["known"].to_numpy()
   351	    h, lo, cl, opn = (cd.h.astype(float), cd.l.astype(float), cd.c.astype(float), cd.o.astype(float))
   352	    sym = pd.factorize(df["raw_symbol"])[0]
   353	    contract = np.cumsum(np.r_[False, sym[1:] != sym[:-1]])
   354	    c_contract = contract[cd.last]
   355	    a34, a14 = np.full(n_c, np.nan), np.full(n_c, np.nan)  # ATR restarts with each contract (no roll gap in TR)
   356	    for g in np.split(np.arange(n_c), np.flatnonzero(np.diff(c_contract)) + 1):
   357	        if len(g):
   358	            a34[g] = atr_rma(h[g], lo[g], cl[g], STRUCT_ATR_LEN).to_numpy()
   359	            a14[g] = atr_rma(h[g], lo[g], cl[g], RISK_ATR_LEN).to_numpy()
   360	    c_start = np.r_[0, np.flatnonzero(np.diff(contract)) + 1][contract[cd.first]]  # 1m bar where its contract began
   361	    tday = pd.factorize(df["trading_day"])[0]
   362	    decay = 0.5 ** (1.0 / HALF_LIFE)
   363	    book = Book(len(COMBOS), tol)
   364	    rows = []
   365	    p = 0  # next lock to register
   366	    for c in range(n_c):
   367	        if c and c_contract[c] != c_contract[c - 1]:
   368	            book.clear()
   369	        av = int(cd.avail[c])
   370	        close = cl[c]
   371	        a = a34[c] if np.isfinite(a34[c]) else 0.0
   372	        if a > 0:
   373	            book.age_cross(close, decay, c)
   374	        while p < len(lk_known) and lk_known[p] <= av:
   375	            kn, op, kind, price, first, last, ref_first, cnd, tfi, w = lk[p]
   376	            p += 1
   377	            pid = (int(tfi), int(kind), int(cnd))
   378	            if op < 0:
   379	                book.withdraw(pid, a, c)
   380	                continue
   381	            # the extreme and its left reference candle must be in the current contract (unadjusted prices)
   382	            if a <= 0 or ref_first < c_start[c] or contract[int(kn)] != c_contract[c]:
   383	                continue
   384	            book.touch(pid, int(kind), int(price), int(first), int(last), float(w), a, close, c)
   385	        # no signal from a candle that straddles a roll or completes in the next session (missing last minute)
   386	        if a <= 0 or cd.first[c] < c_start[c] or not np.isfinite(a14[c]) \
   387	                or tday[cd.first[c]] != tday[av]:
   388	            continue
   389	        rng = h[c] - lo[c]
   390	        for side in (1, -1):
   391	            sel = book.nearest(side, close)
   392	            if not len(sel):
   393	                continue
   394	            if side == 1:
   395	                clv = (close - lo[c]) / rng if rng > 0 else 0.5
   396	                geo = (book.sidebar[sel] < c) & (lo[c] <= book.hi[sel]) & (close > book.hi[sel])
   397	            else:
   398	                clv = (h[c] - close) / rng if rng > 0 else 0.5
   399	                geo = (book.sidebar[sel] < c) & (h[c] >= book.lo[sel]) & (close < book.lo[sel])
   400	            if not geo.any():
   401	                continue
   402	            sc = book.score(sel)
   403	            for ci, (cmin, smin) in enumerate(COMBOS):
   404	                if clv < cmin:
   405	                    continue
   406	                ok = geo & (sc >= smin) & (c - book.lastsig[sel, ci] >= COOLDOWN)
   407	                hit = np.flatnonzero(ok)
   408	                if not len(hit):
   409	                    continue
   410	                s = int(sel[hit[0]])
   411	                book.lastsig[s, ci] = c
   412	                rows.append((c, av, side, ci, book.mid[s], book.lo[s], book.hi[s], float(sc[hit[0]]),
   413	                             book.touches[s], bool(book.ht[s] > 0 and book.lt[s] > 0), book.maxw[s],
   414	                             book.strength[s], book.crosses[s], c - book.first_c[s], a, a14[c], opn[c], h[c], lo[c],
   415	                             close))
   416	    out = pd.DataFrame(rows, columns=CAND_COLS)
   417	    out["sig_tf"] = sig_tf
   418	    _CANDS[ck] = out
   419	    return out
