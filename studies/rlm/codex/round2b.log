    48	
    49	def build_candles(df: pd.DataFrame, tf: str) -> Candles:
    50	    """Candles from 1m bars. 5m-1h: clock aligned. 4h: blocks from the 17:00 CT session open. 1d: trading day.
    51	    1w: trading days Monday-Friday. 1mo: trading days of one calendar month.
    52	    A candle is complete at the close of its last minute (the 15:59 CT bar for the day's last 4h block and the daily
    53	    candle); when that minute has no bar (early closes, quiet minutes), at the close of the next bar."""
    54	    if tf not in TIMEFRAMES:
    55	        raise ValueError(f"timeframe {tf} not in {list(TIMEFRAMES)}")
    56	    if "sess_minute" not in df:
    57	        df = add_session(df)
    58	    n = len(df)
    59	    o, h, l, c = (to_ticks(df[k]) for k in ("open", "high", "low", "close"))
    60	    if n == 0:
    61	        none = np.zeros(0, dtype=np.int64)
    62	        return Candles(pd.DatetimeIndex([], tz="UTC"), none, none, none, none, none, none, none, none)
    63	    if tf == "1m":
    64	        idx = np.arange(n)
    65	        return Candles(pd.DatetimeIndex(df["ts"]), o, h, l, c, np.full(n, UNKNOWN), idx, idx, idx)
    66	    minutes = TIMEFRAMES[tf]
    67	    sess = df["sess_minute"].to_numpy()
    68	    day = pd.factorize(df["trading_day"])[0].astype(np.int64)
    69	    day_close = sess == SESSION_LAST_MINUTE
    70	    if tf == "1d":
    71	        gid, last_minute = day, day_close
    72	    elif tf in ("1w", "1mo"):
    73	        tday = pd.DatetimeIndex(df["trading_day"])
    74	        if tf == "1w":  # Monday-to-Friday trading days (Sunday evening belongs to Monday)
    75	            gid = ((tday.as_unit("ns").asi8 // 86_400_000_000_000) + 3) // 7  # 1970-01-01 was a Thursday
    76	        else:
    77	            gid = (tday.year * 12 + tday.month).to_numpy()
    78	        gid = np.asarray(gid, dtype=np.int64)
    79	        # complete at 15:59 CT of the scheduled last day (Friday / last weekday of the month), from the bar's own
    80	        # date only, so a live prefix agrees with full history. A holiday on that day: complete at the next bar.
    81	        if tf == "1w":
    82	            sched = tday.day_of_week == 4
    83	        else:
    84	            sched = tday == tday + pd.offsets.BMonthEnd(0)
    85	        last_minute = day_close & np.asarray(sched)
    86	    elif tf == "4h":
    87	        gid, last_minute = day * 10 + sess // 240, ((sess + 1) % 240 == 0) | day_close
    88	    else:
    89	        epoch_min = pd.DatetimeIndex(df["ts"]).as_unit("ns").asi8 // 60_000_000_000
    90	        gid, last_minute = epoch_min // minutes, (epoch_min + 1) % minutes == 0
    91	    start = np.flatnonzero(np.r_[True, gid[1:] != gid[:-1]])
    92	    end = np.r_[start[1:], n] - 1
    93	    hi = np.maximum.reduceat(h, start)
    94	    lo = np.minimum.reduceat(l, start)
    95	    first_hi = np.array([s + int(np.argmax(h[s:e + 1] == v)) for s, e, v in zip(start, end, hi, strict=True)])
    96	    first_lo = np.array([s + int(np.argmax(l[s:e + 1] == v)) for s, e, v in zip(start, end, lo, strict=True)])
    97	    order = np.where(first_hi < first_lo, 1, np.where(first_lo < first_hi, 0, UNKNOWN))
    98	    avail = np.where(last_minute[end], end, end + 1)
    99	    done = avail < n  # the last candle is left out until it is complete: it may still print new prices
   100	    return Candles(pd.DatetimeIndex(df["ts"].to_numpy()[start[done]]), o[start[done]], hi[done], lo[done],
   101	                   c[end[done]], order[done], avail[done], start[done], end[done])
   102	
   103	
   104	@dataclass
   105	class Point:
   106	    kind: int  # HIGH or LOW
   107	    price: int  # ticks
   108	    candle: int
   109	    event: int  # position in the event stream (2 per candle)
   110	
   111	
   112	def _extreme_ok(kind: int, price: int, ev_hi: np.ndarray, ev_lo: np.ndarray, a: int, b: int) -> bool:
   113	    """price is the highest high (kind HIGH) / lowest low in events a..b inclusive."""
   114	    if b < a:
   115	        return True
   116	    return bool(price >= ev_hi[a:b + 1].max()) if kind == HIGH else bool(price <= ev_lo[a:b + 1].min())
   117	
   118	
   119	def _offer(stack: list[Point], q: Point, ev_hi: np.ndarray, ev_lo: np.ndarray) -> None:
   120	    while True:
   121	        if not stack:
   122	            if _extreme_ok(q.kind, q.price, ev_hi, ev_lo, 0, q.event):
   123	                stack.append(q)
   124	            return
   125	        t = stack[-1]
   126	        if t.kind == q.kind:  # R5: same type with no opposite point between
   127	            more = q.price >= t.price if q.kind == HIGH else q.price <= t.price
   128	            if not more:
   129	                return
   130	            stack.pop()
   131	            continue
   132	        if not _extreme_ok(q.kind, q.price, ev_hi, ev_lo, t.event + 1, q.event):
   133	            return  # R4: a more extreme price already printed since t
   134	        prev_event = stack[-2].event + 1 if len(stack) > 1 else 0
   135	        if _extreme_ok(t.kind, t.price, ev_hi, ev_lo, prev_event, q.event - 1):
   136	            stack.append(q)
   137	            return
   138	        stack.pop()  # R4: t is not the extreme of its own transition, so it is not a swing point
   139	
   140	
   141	def _process(stack: list[Point], cd: Candles, k: int, high_first: int, is_low: bool, is_high: bool,
   142	             ev_hi: np.ndarray, ev_lo: np.ndarray) -> None:
   143	    """Offer candle k's two events in the given order."""
   144	    first, second = (HIGH, LOW) if high_first == 1 else (LOW, HIGH)
   145	    for slot, kind in enumerate((first, second)):
   146	        e = 2 * k + slot
   147	        ev_hi[e], ev_lo[e] = (cd.h[k], np.inf) if kind == HIGH else (-np.inf, cd.l[k])
   148	        if kind == LOW and is_low:
   149	            _offer(stack, Point(LOW, int(cd.l[k]), k, e), ev_hi, ev_lo)
   150	        elif kind == HIGH and is_high:
   151	            _offer(stack, Point(HIGH, int(cd.h[k]), k, e), ev_hi, ev_lo)
   152	
   153	
   154	def _record(stack: list[Point], state: dict[str, np.ndarray], k: int) -> None:
   155	    """State after candle k: the newest and the previous swing high and swing low in the structure
   156	    (points alternate, so they are the top four of the stack)."""
   157	    state["newest"][k] = stack[-1].kind if stack else 0
   158	    seen = {HIGH: 0, LOW: 0}
   159	    for p in stack[-1:-5:-1]:
   160	        key = ("sh" if p.kind == HIGH else "sl") + ("" if seen[p.kind] == 0 else "2")
   161	        seen[p.kind] += 1
   162	        state[f"{key}_price"][k], state[f"{key}_candle"][k] = p.price, p.candle
   163	
   164	
   165	def detect(cd: Candles) -> tuple[list[Point], dict[str, np.ndarray]]:
   166	    """Run the rule over all candles. Returns the final swing points and the state as known after each candle's
   167	    processing (candle k is processed when candle k+1 closes): last swing high / low price (ticks) and candle
   168	    (sh, sl) and the ones before them (sh2, sl2), or -1 when none; newest: kind of the newest point (0 when none)."""
   169	    n = len(cd)
   170	    ev_hi = np.full(2 * n, -np.inf)  # high of a high event; -inf on low events
   171	    ev_lo = np.full(2 * n, np.inf)
   172	    stack: list[Point] = []
   173	    state = {f"{key}_{f}": np.full(n, -1, dtype=np.int64) for key in ("sh", "sl", "sh2", "sl2")
   174	             for f in ("price", "candle")}
   175	    state["newest"] = np.zeros(n, dtype=np.int64)
   176	    for k in range(n):
   177	        is_low = 0 < k < n - 1 and cd.l[k - 1] >= cd.l[k] and cd.l[k + 1] > cd.l[k]
   178	        is_high = 0 < k < n - 1 and cd.h[k - 1] <= cd.h[k] and cd.h[k + 1] < cd.h[k]
   179	        high_first = int(cd.high_first[k])
   180	        if high_first == UNKNOWN:
   181	            high_first = 1 if stack and stack[-1].kind == LOW else 0  # continue the order
   182	            if is_low and is_high and stack:
   183	                cut = max(len(stack) - UNDO_DEPTH, 0)
   184	                saved, last = stack[cut:], stack[-1]
   185	                _process(stack, cd, k, high_first, is_low, is_high, ev_hi, ev_lo)
   186	                if len(stack) < cut:
   187	                    raise RuntimeError(f"swing cascade deeper than {UNDO_DEPTH} points at candle {k}")
   188	                if all(p is not last for p in stack[cut:]):  # that order breaks rule 4 for the last point
   189	                    del stack[cut:]
   190	                    stack.extend(saved)
   191	                    high_first = 1 - high_first
   192	                else:
   193	                    _record(stack, state, k)
   194	                    continue
   195	        _process(stack, cd, k, high_first, is_low, is_high, ev_hi, ev_lo)
   196	        _record(stack, state, k)
   197	    return stack, state
   198	
   199	
   200	def swing_points(df: pd.DataFrame, tf: str = "1m") -> pd.DataFrame:
   201	    """Final swing points over the whole frame (for charts and studies, NOT for signals: later candles can
   202	    replace a point). Columns: kind (SH/SL), price, ts (candle open), known_at (1m bar index)."""
   203	    cd = build_candles(df, tf)
   204	    pts, _ = detect(cd)
   205	    return pd.DataFrame({
   206	        "kind": ["SH" if p.kind == HIGH else "SL" for p in pts],
   207	        "price": [round(p.price * TICK, 2) for p in pts],
   208	        "ts": [cd.ts[p.candle] for p in pts],
   209	        "known_at": [int(cd.avail[p.candle + 1]) for p in pts],
   210	    })
   211	
   212	
   213	def swing_state(df: pd.DataFrame, tf: str = "1m", prev: bool = False, newest: bool = False) -> pd.DataFrame:
   214	    """Point-in-time swing state for every 1m bar of df: the last swing high and swing low as they were known at
   215	    that bar's close. Safe for signals. NaN until a swing exists, and NaN again when rule 4 removes it. The newest
   216	    point can still be replaced (rule 5). prev=True adds the swing high and low before them ({tf}_sh2, {tf}_sl2).
   217	    newest=True adds {tf}_newest: 1 when the newest point is the swing high, -1 the swing low, 0 none. It settles
   218	    which came last when one candle is both (same _ts)."""
   219	    cols = ("sh", "sl", "sh2", "sl2") if prev else ("sh", "sl")
   220	    cd = build_candles(df, tf)
   221	    n = len(df)
   222	    out = pd.DataFrame(index=df.index)
   223	    if len(cd) == 0:  # warm-up: no candle is complete yet
   224	        for col in cols:
   225	            out[f"{tf}_{col}"] = np.nan
   226	            out[f"{tf}_{col}_ts"] = pd.Series(pd.NaT, index=df.index, dtype="datetime64[ns, UTC]")
   227	        if newest:
   228	            out[f"{tf}_newest"] = 0
   229	        return out
   230	    _, st = detect(cd)
   231	    when = np.full(len(cd), n, dtype=np.int64)  # candle k is processed when candle k+1 is complete
   232	    when[:-1] = cd.avail[1:]
   233	    updated = np.flatnonzero(when < n)
   234	    src = np.full(n, -1, dtype=np.int64)
   235	    src[when[updated]] = updated  # several candles on one bar: the last one wins
   236	    src = np.maximum.accumulate(src)  # each bar shows the newest full snapshot, never a mix of old and new
   237	    known = src >= 0
   238	    for col in cols:
   239	        candle = np.where(known, st[f"{col}_candle"][np.maximum(src, 0)], -1)
   240	        ok = candle >= 0
   241	        price = np.where(ok, st[f"{col}_price"][np.maximum(src, 0)] * TICK, np.nan)
   242	        out[f"{tf}_{col}"] = np.round(price, 2)
   243	        ts = pd.Series(pd.NaT, index=df.index, dtype="datetime64[ns, UTC]")
   244	        ts.iloc[np.flatnonzero(ok)] = cd.ts[candle[ok]]
   245	        out[f"{tf}_{col}_ts"] = ts
   246	    if newest:
   247	        out[f"{tf}_newest"] = np.where(known, st["newest"][np.maximum(src, 0)], 0)
   248	    return out
     1	"""Bar-by-bar backtest of limit-entry bracket orders on CL 1-minute bars. Rules: docs/ENGINE.md.
     2	
     3	A strategy returns signals: one row per bar i where, after bar i closes, it places a limit entry order.
     4	Columns: side (+1 long / -1 short), limit, stop (required), target (optional, NaN = none),
     5	expire (bars the order stays working, default 30) or expire_min (minutes of clock time after the signal bar's
     6	close; replaces expire, so missing minutes cannot stretch the order), hold (max bars in the trade, optional),
     7	qty (default 1), kill (optional: a price beyond the limit on the winning side, e.g. the target; a touch cancels
     8	the unfilled order, see docs/ENGINE.md),
     9	part_qty / part_target (optional partial exit: part_qty contracts leave at part_target, the rest runs on).
    10	
    11	Optional trade management: `manage(ctx)` is called on every held bar m after the fill bar, before that bar's
    12	exits are checked, with data up to bar m-1 only. It returns (stop, close_now): the stop for bar m (any price, in
    13	the trade's own side space, see below) and whether to close the whole position at bar m's open.
    14	
    15	Short trades run through the same code with prices negated, so every rule is written once, for longs.
    16	`manage` sees those side-space prices too: for a short, ctx.E, ctx.S, ctx.best are negated ticks, and the stop it
    17	returns must be negated ticks as well (helpers: ctx.side, ctx.to_side(price_ticks)).
    18	"""
    19	
    20	from collections.abc import Callable
    21	from dataclasses import dataclass, field
    22	
    23	import numpy as np
    24	import pandas as pd
    25	
    26	from .config import COMBINE_50K, FEE_ROUND_TURN, TICK, TICK_VALUE
    27	from .data import Bars, session_minute, to_ticks
    28	
    29	
    30	@dataclass(frozen=True)
    31	class Fills:
    32	    fee: float = FEE_ROUND_TURN  # $ per contract round turn
    33	    flatten: int = session_minute(COMBINE_50K.flatten)  # session minute: no orders or positions from here
    34	    through: int = 0  # 0: a touch fills (owner rule). N: the bar must trade N ticks beyond the limit (sensitivity)
    35	
    36	    def __post_init__(self) -> None:
    37	        if not isinstance(self.through, int) or isinstance(self.through, bool) or self.through < 0:
    38	            raise ValueError(f"through must be a whole number of ticks >= 0, got {self.through!r}")
    39	
    40	
    41	@dataclass
    42	class Ctx:
    43	    """What `manage` may look at on held bar m. Prices are integer ticks in side space (negated for shorts)."""
    44	
    45	    i: int  # signal bar
    46	    j: int  # fill bar
    47	    m: int  # bar about to be checked (data up to m-1 may be used)
    48	    side: int
    49	    E: int  # entry
    50	    S: int  # current stop
    51	    T: int | None  # target
    52	    qty: int  # contracts still open
    53	    best: int  # highest side-space high from the fill bar through bar m-1 (the fill bar's high may predate the fill)
    54	    state: dict = field(default_factory=dict)  # free per-trade memory for the strategy
    55	
    56	    def to_side(self, ticks: int) -> int:
    57	        return self.side * ticks
    58	
    59	
    60	TRADE_COLUMNS = ["signal_bar", "entry_bar", "exit_bar", "entry_ts", "exit_ts", "trading_day", "side", "qty",
    61	                 "entry", "exit", "reason", "ticks", "part_exit", "part_bar", "part_qty", "gross", "fee", "net", "mae",
    62	                 "mfe", "path"]
    63	# ticks: exit - entry of the final leg per contract (side-adjusted). part_exit: price of the partial exit or NaN;
    64	# part_bar / part_qty: its bar and contracts (-1 / 0 without a partial).
    65	# path: (open P&L per held bar, worst P&L per held bar) in $ incl. fee; first entry = the fill bar.
    66	# The Combine simulator walks it so a gap through a loss limit executes at the open, not at the limit.
    67	
    68	
    69	def _prepare(signals: pd.DataFrame, n: int) -> pd.DataFrame:
    70	    s = signals.copy()
    71	    for col, default in (("target", np.nan), ("expire", 30), ("expire_min", np.nan), ("hold", np.nan), ("qty", 1),
    72	                         ("part_qty", 0), ("part_target", np.nan), ("void", np.nan), ("kill", np.nan)):
    73	        if col not in s:
    74	            s[col] = default
    75	    missing = {"side", "limit", "stop"} - set(s.columns)
    76	    if missing:
    77	        raise ValueError(f"signals miss columns {sorted(missing)}")
    78	    if not s.index.is_unique or s.index.min() < 0 or s.index.max() >= n:
    79	        raise ValueError("signal index must be unique bar positions inside the bars")
    80	    if not s["side"].isin([1, -1]).all():
    81	        raise ValueError("side must be +1 or -1")
    82	    if not np.isfinite(s[["limit", "stop"]].to_numpy(float)).all():
    83	        raise ValueError("limit and stop must be finite prices")
    84	    if not np.isfinite(s[["qty", "expire", "part_qty"]].to_numpy(float)).all():
    85	        raise ValueError("qty, expire and part_qty must be finite")
    86	    if (s["qty"] < 1).any() or (s["expire"] < 1).any() or (s["hold"] < 0).any() or (s["expire_min"] < 1).any():
    87	        raise ValueError("qty, expire and expire_min must be >= 1, hold >= 0")
    88	    pq, q = s["part_qty"].to_numpy(np.int64), s["qty"].to_numpy(np.int64)
    89	    if (pq < 0).any() or ((pq > 0) & (pq >= q)).any():
    90	        raise ValueError("part_qty must be 0 or below qty")
    91	    if ((pq > 0) & ~np.isfinite(s["part_target"].to_numpy(float))).any():
    92	        raise ValueError("part_qty needs a finite part_target")
    93	    return s.sort_index()
    94	
    95	
    96	def _ticks_or_zero(prices: pd.Series) -> tuple[np.ndarray, np.ndarray]:
    97	    """Prices as float and as integer ticks; NaN (no order) becomes 0 ticks."""
    98	    v = prices.to_numpy(float)
    99	    return v, np.where(np.isnan(v), 0, np.round(np.nan_to_num(v) / TICK)).astype(np.int64)
   100	
   101	
   102	def _check_stop(stop, signal_bar: int) -> int:
   103	    """manage() must return a finite whole number of ticks (side space: use ctx.to_side for shorts)."""
   104	    if not np.isfinite(stop) or stop != int(stop):
   105	        raise ValueError(f"signal at bar {signal_bar}: manage returned stop {stop}; need whole side-space ticks")
   106	    return int(stop)
   107	
   108	
   109	def _open_qty(held: list[tuple[int, int, int, int, int]], bar: int) -> int:
   110	    """Contracts still open at the close of `bar` (held: entry bar, exit bar, contracts, partial bar, partial
   111	    contracts; partial bar -1 when none)."""
   112	    return sum(q - (pq if 0 <= pb <= bar else 0) for e, x, q, pb, pq in held if e <= bar < x)
   113	
   114	
   115	def backtest(bars: Bars, signals: pd.DataFrame, fills: Fills = Fills(),
   116	             manage: Callable[[Ctx], tuple[int, bool]] | None = None, overlap: bool = False,
   117	             max_contracts: int = COMBINE_50K.max_contracts) -> pd.DataFrame:
   118	    """overlap=False: one order or position at a time. overlap=True: a new signal cancels an unfilled order but
   119	    open positions keep running, up to max_contracts open at once (a signal that would exceed it is ignored)."""
   120	    n = len(bars)
   121	    sig = _prepare(signals, n)
   122	    flat = fills.flatten
   123	    views = {1: (bars.o, bars.h, bars.l, bars.c), -1: (-bars.o, -bars.l, -bars.h, -bars.c)}
   124	    lim, stp = to_ticks(sig["limit"]), to_ticks(sig["stop"])
   125	    tgt, tgt_t = _ticks_or_zero(sig["target"])
   126	    _, ptg_t = _ticks_or_zero(sig["part_target"])
   127	    void, void_t = _ticks_or_zero(sig["void"])
   128	    kill, kill_t = _ticks_or_zero(sig["kill"])
   129	    sides, qtys = sig["side"].to_numpy(np.int64), sig["qty"].to_numpy(np.int64)
   130	    pqtys = sig["part_qty"].to_numpy(np.int64)
   131	    expires, holds = sig["expire"].to_numpy(np.int64), sig["hold"].to_numpy(float)
   132	    expire_min = sig["expire_min"].to_numpy(float)
   133	    minute = bars.ts.as_unit("ns").asi8 // 60_000_000_000  # bar open, minutes since epoch
   134	    rows = []
   135	    next_free = -1
   136	    sig_bars = sig.index.to_numpy()
   137	    held: list[tuple[int, int, int, int, int]] = []  # overlap: trades that may be open (see _open_qty)
   138	    for r, i in enumerate(sig_bars):
   139	        if i + 1 >= n:
   140	            continue
   141	        side, qty, pq = int(sides[r]), int(qtys[r]), int(pqtys[r])
   142	        cancel_at = n  # overlap: the next accepted signal's bar; this order works through it at most
   143	        if overlap:
   144	            held = [t for t in held if t[1] > i]
   145	            if _open_qty(held, i) + qty > max_contracts:
   146	                continue
   147	            for r2 in range(r + 1, len(sig_bars)):
   148	                if sig_bars[r2] + 1 < n and _open_qty(held, sig_bars[r2]) + qtys[r2] <= max_contracts:
   149	                    cancel_at = int(sig_bars[r2])
   150	                    break
   151	        elif i < next_free:
   152	            continue
   153	        o, h, l, c = views[side]
   154	        L, S = side * lim[r], side * stp[r]
   155	        T = None if np.isnan(tgt[r]) else side * tgt_t[r]
   156	        P = side * ptg_t[r] if pq > 0 else None
   157	        V = None if np.isnan(void[r]) else side * void_t[r]
   158	        if V is not None and V > L:
   159	            raise ValueError(f"signal at bar {i}: void must be at or beyond the limit on the losing side")
   160	        K = None if np.isnan(kill[r]) else side * kill_t[r]
   161	        if K is not None and K <= L:
   162	            raise ValueError(f"signal at bar {i}: kill must be beyond the limit on the winning side")
   163	        if S >= L or (T is not None and T <= L) or (P is not None and (P <= L or (T is not None and P > T))):
   164	            raise ValueError(f"signal at bar {i}: stop must be on the losing side and targets on the winning side")
