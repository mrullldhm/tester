   453	class Strategy(Base):
   454	    NAME = "rlm"
   455	    ABOUT = ("Reaction Level Matrix (WillyAlgoTrader) on CL: price levels from owner-rule swing points weighted by "
   456	             "timeframe; buy a rejection candle at support (sell at resistance) with a limit, wick or band stop, "
   457	             "R-multiple target.")
   458	    PARAMS = {"sig_tf": "15m", "reg": "lock", "sources": "all", "weight": "tf", "tol": 0.6, "score": 50, "clv": 0.6,
   459	              "entry": "close", "stop": "wick", "exit": "be3", "session": "all"}
   460	    GRID = {"sig_tf": ["5m", "15m", "1h"], "reg": ["lock", "confirm"], "sources": ["all", "htf"],
   461	            "weight": ["tf", "flat"], "tol": [0.4, 0.6, 1.0], "score": [0, 50, 70], "clv": [0.6, 0.75],
   462	            "entry": ["close", "band"],
   463	            "stop": ["wick", "band"], "exit": ["r1", "r2", "r3", "be3"], "session": ["all", "rth"]}
   464	
   465	    def __init__(self) -> None:
   466	        self._p: dict = {}
   467	        self._opp: dict[int, list[int]] = {}
   468	        self._side_hi: dict[int, np.ndarray] = {}
   469	
   470	    def orders(self, df: pd.DataFrame, p: dict) -> pd.DataFrame:
   471	        cand = candidates(df, p["sig_tf"], p["reg"], p["sources"], p["weight"], float(p["tol"]))
   472	        return build_orders(cand, df, p)
   473	
   474	    def signals(self, df: pd.DataFrame, p: dict) -> pd.DataFrame:
   475	        self._p = p
   476	        o = self.orders(df, p)
   477	        cols = ["side", "limit", "stop", "target", "expire_min", "kill"]
   478	        if o.empty:
   479	            return pd.DataFrame(columns=cols)
   480	        side = o["side"].to_numpy()
   481	        self._opp = {sd: sorted(o.loc[o["side"] == -sd, "bar"].astype(int)) for sd in (1, -1)}
   482	        self._side_hi = {1: to_ticks(df["high"]), -1: -to_ticks(df["low"])}
   483	        tgt = side * o["T"].to_numpy() * TICK
   484	        return pd.DataFrame({"side": side, "limit": np.round(side * o["E"].to_numpy() * TICK, 2),
   485	                             "stop": np.round(side * o["S"].to_numpy() * TICK, 2), "target": np.round(tgt, 2),
   486	                             "expire_min": EXPIRE_BARS * TIMEFRAMES[p["sig_tf"]], "kill": np.round(tgt, 2)},
   487	                            index=o["bar"].astype(int).to_numpy())
   488	
   489	    def manage(self, ctx):
   490	        """be3: stop to entry once a bar after the fill bar reached entry + 1R (R = (target - entry) / 3), effective
   491	        from the next bar. be3opp: also close at the open after an opposite signal bar (signal at or after the fill
   492	        bar, original reversal exit)."""
   493	        ex = self._p.get("exit")
   494	        if ex not in ("be3", "be3opp"):
   495	            return ctx.S, False
   496	        st = ctx.state
   497	        if "mx" not in st:
   498	            st["mx"], st["R"] = -10**12, (ctx.T - ctx.E) // 3
   499	        if ctx.m - 1 > ctx.j:
   500	            st["mx"] = max(st["mx"], int(self._side_hi[ctx.side][ctx.m - 1]))
   501	        stop = ctx.E if st["mx"] >= ctx.E + st["R"] else ctx.S
   502	        stop = max(stop, ctx.S)
   503	        if ex == "be3opp":
   504	            opp = self._opp[ctx.side]
   505	            k = bisect_left(opp, ctx.j)
   506	            if k < len(opp) and opp[k] <= ctx.m - 1:
   507	                return stop, True
   508	        return stop, False

