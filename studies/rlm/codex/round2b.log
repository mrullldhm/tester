    41	    lo = pd.Timestamp(start, tz="UTC") if start else None
    42	    hi = pd.Timestamp(end, tz="UTC") if end else None
    43	    hi_year = None if hi is None else (hi - pd.Timedelta(microseconds=1)).year
    44	    keep = [p for p in paths if (lo is None or int(p.stem[5:]) >= lo.year)
    45	            and (hi_year is None or int(p.stem[5:]) <= hi_year)]
    46	    if not keep:
    47	        dtypes = ["datetime64[ns, UTC]", "str", *["float64"] * 4, "int64", "str"]
    48	        return pd.DataFrame({c: pd.Series(dtype=t) for c, t in zip(COLUMNS, dtypes, strict=True)})
    49	    df = pd.concat((pd.read_parquet(p) for p in keep), ignore_index=True)
    50	    if lo is not None:
