   422	def build_orders(cand: pd.DataFrame, df: pd.DataFrame, p: dict) -> pd.DataFrame:
   423	    """Orders (ticks, side space resolved) from the candidates of one combo. One row per signal bar; a long and a
   424	    short on one candle: long only (original). Columns include features for the trade study."""
   425	    ci = COMBOS.index((float(p["clv"]), int(p["score"])))
   426	    s = cand[cand["combo"] == ci].copy()
   427	    if s.empty:
   428	        return s
   429	    s = s.sort_values(["bar", "side"], ascending=[True, False], kind="stable").drop_duplicates("bar", keep="first")
   430	    ctm = df["ct_minute"].to_numpy()[s["bar"].to_numpy()]
   431	    s["ct_min"] = ctm
   432	    if p["session"] == "rth":
   433	        s = s[(s["ct_min"] >= RTH[0]) & (s["ct_min"] < RTH[1])]
   434	    side = s["side"].to_numpy()
   435	    # side space: long as is, short negated
   436	    cl, lo_c = (side * s["cl"]).to_numpy(), np.where(side == 1, s["l"], -s["h"])
   437	    lvl_near = np.where(side == 1, s["hi"], -s["lo"])  # band edge price came back to
   438	    lvl_far = np.where(side == 1, s["lo"], -s["hi"])
   439	    a14 = s["atr14"].to_numpy()
   440	    entry = np.where(p["entry"] == "close", cl, np.floor(lvl_near)).astype(float)
   441	    if p["stop"] == "wick":
   442	        raw = np.minimum(lo_c - WICK_BUFFER_ATR * a14, entry - WICK_MIN_ATR * a14)
   443	    else:
   444	        raw = np.minimum(lvl_far - WICK_BUFFER_ATR * a14, entry - WICK_MIN_ATR * a14)
   445	    stop = np.floor(raw)
   446	    risk = entry - stop
   447	    k = {"r1": 1, "r2": 2, "r3": 3, "be3": 3, "be3opp": 3}[p["exit"]]
   448	    target = entry + np.ceil(k * risk)
   449	    s = s.assign(E=entry, S=stop, R=risk, T=target)
   450	    return s[s["R"] >= MIN_RISK]
   451	
