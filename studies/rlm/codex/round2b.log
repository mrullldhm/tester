    54	def new_candle(avail: np.ndarray, n: int) -> np.ndarray:
    55	    """Bool per 1m bar: a candle of this timeframe completed at this bar's close."""
    56	    m = np.zeros(n, dtype=bool)
    57	    m[avail[avail < n]] = True
    58	    return m
