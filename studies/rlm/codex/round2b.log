    31	def in_session(df: pd.DataFrame, cd: pd.DataFrame) -> np.ndarray:
    32	    """Bool per candle: complete inside its own trading day. False when its last minute is missing and it only
    33	    completes on the next session's first bar: a signal then would trade a stale candle in a new session."""
    34	    av = cd["avail"].to_numpy()
    35	    ok = av < len(df)
    36	    out = np.zeros(len(cd), dtype=bool)
    37	    out[ok] = df["trading_day"].to_numpy()[av[ok]] == cd["day"].to_numpy()[ok]
