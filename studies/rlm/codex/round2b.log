    35	def study(df: pd.DataFrame, p: dict, through: int = 0) -> pd.DataFrame:
    36	    s = Strategy()
    37	    o = s.orders(df, p).set_index("bar")
    38	    tr = backtest(Bars.from_frame(df), s.signals(df, p), Fills(through=through), s.manage)
    39	    t = tr.drop(columns="path").join(o, on="signal_bar", rsuffix="_o")
    40	    rng = (t["h"] - t["l"]).replace(0, np.nan)
    41	    t["clv"] = np.where(t["side"] == 1, (t["cl"] - t["l"]) / rng, (t["h"] - t["cl"]) / rng)
    42	    t["band_atr"] = (t["hi"] - t["lo"]) / t["atr34"]
    43	    t["pen_atr"] = np.where(t["side"] == 1, t["hi"] - t["l"], t["h"] - t["lo"]) / t["atr34"]  # wick depth into band
    44	    t["dist_atr"] = np.where(t["side"] == 1, t["cl"] - t["hi"], t["lo"] - t["cl"]) / t["atr34"]  # close away
    45	    t["risk"] = t["R"]
    46	    t["ct_hour"] = t["ct_min"] // 60
    47	    t["Rmult"] = t["net"] / (t["R"] * TICK_VALUE)
    48	    t["year"] = pd.to_datetime(t["trading_day"]).dt.year
    49	    return t
