    72	def add_session(df: pd.DataFrame) -> pd.DataFrame:
    73	    """Add Chicago fields. trading_day = CME/Topstep day: 17:00 CT opens the next day's session
    74	    (Sunday 17:00 CT belongs to Monday)."""
    75	    out = df.copy()
    76	    ct = out["ts"].dt.tz_convert(EXCHANGE_TZ)
    77	    out["ct"] = ct
