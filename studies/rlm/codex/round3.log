"""Random-entry null for one RLM version (README step 2, Codex round 1).

Keeps everything of the version's orders except the level logic: each signal keeps its CT minute of day, side,
entry offset from the signal close (0 for `close`, band edge - close for `band`), risk ticks, target multiple,
expiry and the BE rule, but is moved to a random dev trading day (same CT minute, bar must exist). The engine runs
these brackets as usual. If the real version is not better than most null runs, the levels add nothing.
Run: .venv/bin/python -m studies.rlm.null --set sig_tf=1h ... [--runs 500] [--through 0]
Memory: one dev frame (~1.1 GB); keep it alone beside a running grid.
"""

import argparse

import numpy as np
import pandas as pd

from cltester.config import ROOT, TICK
from cltester.data import Bars, load_period, to_ticks
from cltester.engine import Fills, backtest
from cltester.swings import TIMEFRAMES
from strategies.rlm import EXPIRE_BARS, Strategy
from studies.rlm.trades import parse

OUT = ROOT / "studies" / "rlm" / "null"


def pf(net: pd.Series) -> float:
    loss = -net[net < 0].sum()
    return float(net[net > 0].sum() / loss) if loss else np.nan


def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("--set", nargs="*", default=[])
    ap.add_argument("--runs", type=int, default=500)
    ap.add_argument("--through", type=int, default=0)
    ap.add_argument("--tag", default="null")
    a = ap.parse_args()
    p = {**Strategy.PARAMS, **parse(a.set)}
    df = load_period("dev")
    bars, fills = Bars.from_frame(df), Fills(through=a.through)
    s = Strategy()
    real = backtest(bars, s.signals(df, p), fills, s.manage)
    o = s.orders(df, p)
    side = o["side"].to_numpy()
    k = {"r1": 1, "r2": 2, "r3": 3, "be3": 3}[p["exit"]]
    off = (o["E"] - side * o["cl"]).to_numpy()  # side space: limit - signal close
    risk = o["R"].to_numpy().astype(np.int64)
    minute = o["ct_min"].to_numpy()
    close = to_ticks(df["close"])
    day = df["trading_day"].to_numpy()
    days = np.unique(day)
    ctm = df["ct_minute"].to_numpy()
    # bar index of (trading day, CT minute)
    key = pd.Series(np.arange(len(df)), index=pd.MultiIndex.from_arrays([day, ctm]))
    side_hi = {1: to_ticks(df["high"]), -1: -to_ticks(df["low"])}
    rng = np.random.default_rng(11)
    exp = EXPIRE_BARS * TIMEFRAMES[p["sig_tf"]]
    rows = []
    for r in range(a.runs):
        pick = days[rng.integers(0, len(days), len(o) * 2)]
        bar = key.reindex(pd.MultiIndex.from_arrays([pick, np.r_[minute, minute]])).to_numpy()
        bar = np.where(np.isnan(bar[: len(o)]), bar[len(o):], bar[: len(o)])  # one retry when the minute is missing
        ok = ~np.isnan(bar)
        b = bar[ok].astype(np.int64)
        sd, E = side[ok], side[ok] * close[b] + off[ok]
        S, T = E - risk[ok], E + k * risk[ok]
        sig = pd.DataFrame({"side": sd, "limit": sd * E * TICK, "stop": sd * S * TICK, "target": sd * T * TICK,
                            "expire_min": exp, "kill": sd * T * TICK, "bar": b, "tp1": E + risk[ok]})
        sig = sig.drop_duplicates("bar").set_index("bar").sort_index()
        s._p, s._side_hi = p, side_hi
        s._tp1 = dict(zip(sig.index, sig["tp1"].astype(int), strict=True))
        t = backtest(bars, sig[["side", "limit", "stop", "target", "expire_min", "kill"]], fills, s.manage)
        rows.append({"run": r, "trades": len(t), "net": t["net"].sum(), "pf": pf(t["net"])})
        if r % 50 == 0:
            print(r, flush=True)
    n = pd.DataFrame(rows)
    OUT.mkdir(parents=True, exist_ok=True)
    n.to_csv(OUT / f"{a.tag}.csv", index=False)
    rpf = pf(real["net"])
    print(p)
    print(f"real: trades {len(real)} net {real['net'].sum():.0f} PF {rpf:.3f}  (dev, in-sample)")
    print(f"null: median PF {n['pf'].median():.3f}, share net>0 {(n['net'] > 0).mean():.1%}, "
          f"runs with PF >= real {(n['pf'] >= rpf).mean():.1%} of {len(n)}")


if __name__ == "__main__":
    main()
No look-ahead found in swing availability, candidate processing, order construction, or management’s `m-1` reads. Short rounding and kill/expiry handling match the documented execution rules. Ten existing tests passed; bounded probes reproduced the issues below. No files changed.

1. **bug — `strategies/rlm.py:227,281` — TF provenance overwrites surviving points.** A registry entry stores one weight per TF, but multiple point IDs from that TF can reference it. Withdrawing either deletes that TF’s entire contribution. Reproduction: one HTF point plus two nested lower-TF points; withdrawing the first lower point and HTF point leaves the second PID registered but no live level. **Fix:** store contributions by full PID; derive the touch’s maximum weight from surviving PIDs.

2. **bug — `strategies/rlm.py:164,181,284` — stale strength shares survive level death.** `_kill()` removes ownership but retains `base`; withdrawing an ownerless point leaves its registry entry behind. Re-registering that extreme can reuse its old base. Probe: level strength was 2 while recorded shares totaled 3; withdrawing one touch left another touch with zero strength. **Fix:** delete bases on death/full withdrawal, clean empty registry entries, and initialize a resurrected touch’s base from zero.

3. **bug — `strategies/rlm.py:498` — improved fills distort the break-even threshold.** `(T-E)//3` reconstructs risk using the actual fill and a target calculated from the intended limit. Example: limit 1000, stop 990, target 1030, fill 995 gives “R” 11, versus intended risk 10 and actual risk 5. **Fix:** preserve the signal’s frozen TP1 (`limit + intended risk`) and move the stop to actual entry after that threshold; explicitly document any alternative convention.

4. **bug — `strategies/rlm.py:354,360,386` — mixed-contract rejection is ineffective.** `c_start` selects the contract containing `cd.first`, making `cd.first < c_start` impossible. ATR grouping by the last bar can also include mixed-contract OHLC. The bounded sample contained six mixed 4h and six mixed daily candles; none were rejected by this comparison. No mixed signal-TF candles occurred in that sample. **Fix:** explicitly require matching contracts at `first`, `last`, and signal availability; exclude mixed candles before ATR seeding and validate source extreme/reference candle endpoints.

5. **bug — `studies/rlm/grid.py:58,84`; `studies/rlm/screen.py:29` — screen integrity is unchecked.** Resume trusts filenames without a code/data fingerprint. Merge accepts incomplete families; missing neighbours disappear from the denominator. Consequently, stale or partial results can appear comparable and pass screening. **Fix:** fingerprint strategy/engine/data/configuration, reject incompatible parts, and require exactly 13,824 unique expected combinations before screening.

6. **minor — `strategies/rlm.py:286,297` — strongest-touch feature remains stale.** Downgrading a 3.5-weight touch to 1 leaves `maxw=3.5`. This mislabels the predeclared trade-study feature. **Fix:** recompute `maxw` from surviving touch weights after withdrawals.

7. **minor — `strategies/rlm.py:121` — withdrawal reconciliation remains heuristic.** The reported three spurious withdrawals still remove valid contributions prospectively, although no withdrawals were missed in that check. **Fix:** expose exact removal events from the swing engine, retaining only bounded state, rather than infer removals from fresh-point counts."""RLM trade study: every filled trade of one version joined to its signal features, then win/loss correlations.

Features are the predeclared list in docs/strategies/rlm/README.md (step 4). Outcome: net $ and R (net / risk $).
Per feature: quintile (or category) table of trades, win rate, avg R, PF, and a day-clustered bootstrap CI of avg R.
Any filter read off this table is a NEW trial; it needs data it was not found on (validation once, or forward).
Run: .venv/bin/python -m studies.rlm.trades --set sig_tf=15m exit=r2 ... [--period dev] [--tag name]
"""

import argparse

import numpy as np
import pandas as pd

from cltester.config import ROOT, TICK_VALUE
from cltester.data import Bars, load_period
from cltester.engine import Fills, backtest
from strategies.rlm import Strategy

OUT = ROOT / "studies" / "rlm" / "trades"
FEATURES = ["maxw", "touches", "score", "polar", "age", "crosses", "band_atr", "clv", "risk", "ct_hour", "side",
            "atr14", "pen_atr", "dist_atr"]


def parse(items: list[str]) -> dict:
    out = {}
    for it in items:
        k, v = it.split("=")
        try:
            out[k] = float(v) if "." in v else int(v)
        except ValueError:
            out[k] = v
    return out


def study(df: pd.DataFrame, p: dict, through: int = 0) -> pd.DataFrame:
    s = Strategy()
    o = s.orders(df, p).set_index("bar")
    tr = backtest(Bars.from_frame(df), s.signals(df, p), Fills(through=through), s.manage)
    t = tr.drop(columns="path").join(o, on="signal_bar", rsuffix="_o")
    rng = (t["h"] - t["l"]).replace(0, np.nan)
    t["clv"] = np.where(t["side"] == 1, (t["cl"] - t["l"]) / rng, (t["h"] - t["cl"]) / rng)
    t["band_atr"] = (t["hi"] - t["lo"]) / t["atr34"]
    t["pen_atr"] = np.where(t["side"] == 1, t["hi"] - t["l"], t["h"] - t["lo"]) / t["atr34"]  # wick depth into band
    t["dist_atr"] = np.where(t["side"] == 1, t["cl"] - t["hi"], t["lo"] - t["cl"]) / t["atr34"]  # close away
    t["risk"] = t["R"]
    t["ct_hour"] = t["ct_min"] // 60
    t["Rmult"] = t["net"] / (t["R"] * TICK_VALUE)
    t["year"] = pd.to_datetime(t["trading_day"]).dt.year
    return t


def table(t: pd.DataFrame, f: str, rng: np.random.Generator, boots: int = 300) -> pd.DataFrame:
    x = t[f]
    grp = pd.qcut(x.rank(method="first"), 5, labels=False) if x.nunique() > 6 else x
    rows = []
    for g, d in t.groupby(grp):
        days = d["trading_day"].to_numpy()
        ud = np.unique(days)
        by = d.groupby("trading_day")["Rmult"].agg(["sum", "count"])
        bs = []
        for _ in range(boots):  # day-clustered bootstrap of avg R
            pick = by.iloc[rng.integers(0, len(by), len(by))]
            bs.append(pick["sum"].sum() / pick["count"].sum())
        win, loss = d.loc[d["net"] > 0, "net"].sum(), -d.loc[d["net"] < 0, "net"].sum()
        rows.append({"feature": f, "bin": g, "lo": round(float(d[f].min()), 3), "hi": round(float(d[f].max()), 3),
                     "trades": len(d), "days": len(ud), "win": round((d["net"] > 0).mean(), 3),
                     "avgR": round(d["Rmult"].mean(), 3), "ci05": round(np.quantile(bs, 0.05), 3),
                     "ci95": round(np.quantile(bs, 0.95), 3), "pf": round(win / loss, 3) if loss else np.nan,
                     "net": round(d["net"].sum())})
    return pd.DataFrame(rows)


def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("--set", nargs="*", default=[])
    ap.add_argument("--period", default="dev", choices=["dev"])
    ap.add_argument("--through", type=int, default=0)
    ap.add_argument("--tag", default="study")
    a = ap.parse_args()
    p = {**Strategy.PARAMS, **parse(a.set)}
    df = load_period(a.period)
    t = study(df, p, a.through)
    OUT.mkdir(parents=True, exist_ok=True)
    t.to_csv(OUT / f"{a.tag}_{a.period}.csv", index=False)
    rng = np.random.default_rng(7)
    tabs = pd.concat([table(t, f, rng) for f in FEATURES], ignore_index=True)
    tabs.to_csv(OUT / f"{a.tag}_{a.period}_features.csv", index=False)
    print(p, f"\ntrades {len(t)} net {t['net'].sum():.0f} avgR {t['Rmult'].mean():.3f} (in-sample, {a.period})")
    with pd.option_context("display.width", 200, "display.max_rows", 200):
        print(tabs.to_string(index=False))


if __name__ == "__main__":
    main()

