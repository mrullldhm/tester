"""Reaction Level Matrix [WillyAlgoTrader] mapped to CL (2026-11-19, Claude + Codex).
Spec, CL mapping and trial budget: docs/strategies/rlm/README.md. Original logic: studies/rlm/rlm_logic.pine.

Levels are price bands built online from swing points. The original finds swings with ta.pivothigh(6, 6) and weights
each touch by its reaction size; here every swing is an owner-rule point (cltester.swings) on one of several
timeframes and its weight is the TIMEFRAME (owner: the bigger the TF, the stronger the swing). One turning point counts
once: when a higher TF confirms the same extreme, the touch is upgraded to the higher weight.

A point becomes a touch when it is LOCKED: a newer opposite point exists after it in the structure, so rule 5 can no
longer replace it. Known at the close of the candle that makes it locked (detect state[k] is known when candle k+1
completes).

The level engine runs on completed candles of the signal timeframe S: age + cross with the candle close, register the
touches locked up to the candle's completion, pick the 3 nearest active levels per side, test the rejection candle.
Levels reset at every contract change (prices are not back-adjusted).
"""

import hashlib
from bisect import bisect_left

import numpy as np
import pandas as pd

from cltester.config import TICK
from cltester.data import to_ticks
from cltester.indicators import atr_rma
from cltester.strategy import Base
from cltester.swings import HIGH, LOW, TIMEFRAMES, build_candles, detect

# --- original constants (rlm_logic.pine) ---
STRUCT_ATR_LEN = 34
RISK_ATR_LEN = 14
MIN_HALF_WIDTH_ATR = 0.15
SCORE_SCALE = 6.0
POLARITY_BONUS = 1.25
CROSS_PENALTY = 0.7
MIN_STRENGTH = 0.25
MAX_LEVELS = 60
MERGE_PASSES = 5
MIN_TOUCHES = 2
HALF_LIFE = 500  # signal-TF bars
PER_SIDE = 3
COOLDOWN = 10  # signal-TF bars per level
WICK_BUFFER_ATR = 0.25
WICK_MIN_ATR = 0.5

# --- CL mapping ---
SOURCES = ("5m", "15m", "1h", "4h", "1d")
# same 1..3.5 range as the original reaction weight
TF_WEIGHT = {"5m": 1.0, "15m": 1.5, "1h": 2.0, "4h": 3.0, "1d": 3.5}
COMBOS = [(clv, score) for clv in (0.6, 0.75) for score in (0, 50, 70)]  # rejection close strength x min level score
MIN_RISK = 5  # ticks
EXPIRE_BARS = 1  # signal-TF bars an unfilled entry works (also killed by a target touch)
RTH = (8 * 60 + 30, 13 * 60 + 30)  # CT minutes: signal candle completes inside [08:30, 13:30)
CAP = MAX_LEVELS + 2

CAND_COLS = ["c", "bar", "side", "combo", "mid", "lo", "hi", "score", "touches", "polar", "maxw", "strength",
             "crosses", "age", "atr34", "atr14", "o", "h", "l", "cl"]


def _content_key(df: pd.DataFrame) -> str:
    hsh = hashlib.sha256()
    hsh.update(str(len(df)).encode())
    hsh.update(df["ts"].to_numpy("datetime64[ns]").view("int64").tobytes())
    for k in ("open", "high", "low", "close"):
        hsh.update(to_ticks(df[k]).tobytes())
    hsh.update(pd.util.hash_pandas_object(df["raw_symbol"], index=False).to_numpy().tobytes())
    return hsh.hexdigest()


_EVENTS: dict[tuple, pd.DataFrame] = {}
_CANDS: dict[tuple, pd.DataFrame] = {}
EV_COLS = ["known", "op", "kind", "price", "first", "last", "ref_first", "candle"]


def swing_events(df: pd.DataFrame, tf: str, reg: str, key: str | None = None) -> pd.DataFrame:
    """Owner swing points on tf as touch events, in the order they become known (1m bar `known`, at whose close the
    detect state of candle k is known = avail[k+1]).
    reg="lock": op +1 when the point is locked (a newer opposite point exists above it in the structure, so rule 5
    can no longer replace it). reg="confirm": op +1 when the point first appears, op -1 when it leaves the structure
    (rule-5 replacement or rule-4 removal) while it is still among the top four points.
    first / last: 1m bars of the extreme's candle; ref_first: first 1m bar of the candle left of it (its rule-2/3
    reference, used by the roll guard)."""
    key = key or _content_key(df)
    if (key, tf, reg) in _EVENTS:
        return _EVENTS[(key, tf, reg)]
    cd = build_candles(df, tf)
    n_c, n = len(cd), len(df)
    _, st = detect(cd)
    cols = (("sh", HIGH), ("sl", LOW), ("sh2", HIGH), ("sl2", LOW))
    seen: set[tuple[int, int]] = set()
    prev: dict[tuple[int, int], tuple[int, int]] = {}  # (kind, candle) -> (depth, price) after candle k-1
    rows = []
    for k in range(n_c - 1):
        known = int(cd.avail[k + 1])
        if known >= n:
            break
        nw = st["newest"][k]
        if nw == 0:
            continue
        order = ("sh", "sl", "sh2", "sl2") if nw == HIGH else ("sl", "sh", "sl2", "sh2")
        cur: dict[tuple[int, int], tuple[int, int]] = {}
        for depth, col in enumerate(order):
            kind = dict(cols)[col]
            cnd = int(st[f"{col}_candle"][k])
            if cnd >= 0:
                cur[(kind, cnd)] = (depth, int(st[f"{col}_price"][k]))

        def row(op: int, kind: int, cnd: int, price: int, known: int = known) -> tuple:
            return (known, op, kind, price, int(cd.first[cnd]), int(cd.last[cnd]), int(cd.first[max(cnd - 1, 0)]),
                    cnd)

        if reg == "lock":
            for (kind, cnd), (depth, price) in cur.items():
                if depth > 0 and (kind, cnd) not in seen:
                    seen.add((kind, cnd))
                    rows.append(row(1, kind, cnd, price))
        else:
            fresh = [pt for pt in cur if pt not in prev]
            for pt, (depth, price) in prev.items():
                if pt not in cur and depth + len(fresh) < 4:  # not pushed down: replaced or removed
                    rows.append(row(-1, pt[0], pt[1], price))
                    seen.discard(pt)
            for pt in fresh:
                if pt not in seen:
                    seen.add(pt)
                    rows.append(row(1, pt[0], pt[1], cur[pt][1]))
        prev = cur
    out = pd.DataFrame(rows, columns=EV_COLS)
    _EVENTS[(key, tf, reg)] = out
    return out


class Book:
    """Level memory in fixed-size numpy arrays (slot per level, `alive` mask). Prices in ticks (float).

    A touch is one turning point (key = int). Its entry holds the weight of every swing point (pid = (tf, kind,
    candle)) that confirmed the same extreme; the touch weighs max of them. Strength share of a touch:
    base[key] * exp(ls[slot]), ls = log of every decay and cross penalty the slot took. When a level dies its touches
    die with it (entries, pids and shares are purged)."""

    def __init__(self, n_combo: int, tol: float):
        self.tol = tol
        z = lambda: np.zeros(CAP)  # noqa: E731
        self.lo, self.hi, self.mid = z(), z(), z()
        self.sw, self.swp, self.swp2, self.strength = z(), z(), z(), z()
        self.touches, self.ht, self.lt, self.crosses = z(), z(), z(), z()
        self.side, self.sidebar, self.first_c, self.maxw, self.ls = z(), z(), z(), z(), z()
        self.alive = np.zeros(CAP, dtype=bool)
        self.lastsig = np.full((CAP, n_combo), -1e9)
        self.decay = 0.5 ** (1.0 / HALF_LIFE)
        self.clear()

    def clear(self) -> None:
        self.alive[:] = False
# Topstep 50K Trading Combine: rules as simulated

Target account: **Topstep 50K Trading Combine** on TopstepX. Market: **CL only** (MCL banned, non-syariah for the
owner). Code: `cltester/config.py` (`Combine`) and `cltester/topstep.py`.

Source status (2026-11-12): Topstep's help centre could not be read from this machine. The numbers below come from
several 2026 third-party guides that agree with each other. Every row marked **VERIFY** must be checked against the
owner's Topstep dashboard or help.topstep.com, and this file and `config.py` updated together.

| Rule | Value used | Status |
|---|---|---|
| Starting balance | $50,000 | agreed by all sources |
| Profit target | $3,000 | agreed by all sources |
| Maximum Loss Limit (MLL) | $2,000 below the highest end-of-day balance; checked against intraday equity (open P&L included) | agreed |
| MLL stops trailing | at $50,000 (starting balance) | VERIFY |
| Daily Loss Limit (DLL) | off by default (optional on TopstepX; $1,000 when on). A DLL hit liquidates and ends the day, it does not fail the account | VERIFY |
| Consistency target | best day ≤ 55% of total profit; if broken, target becomes best_day / 0.55 (account does not fail) | VERIFY (older pages say 50%) |
| Max size | 5 CL | agreed |
| Flatten time | 3:10 PM CT, all positions closed | VERIFY for CL |
| Trading day | 5:00 PM CT to 4:00 PM CT next day | CME standard |
| CL fee | $4.04 per contract round turn (commission + exchange + NFA) | VERIFY (CME fee change 2026-10-01; Rithmic rate is higher) |
| Subscription / reset | $49 / $49 | VERIFY |

## How the simulator applies them

1. Trades come from the engine with net P&L and a per-bar path (open and worst P&L, fees included).
2. Within a day, each trade is walked bar by bar. Trades open at the same time (overlap mode) are merged into one:
   per bar, open and worst P&L are summed over the open trades, and a trade that already closed counts with its
   net. Summing each trade's worst P&L assumes they all hit their worst in the same bar (conservative). More than
   5 contracts held in one bar (partial exits release theirs after their bar) is refused.
   - A bar that **opens** at or past a limit executes at the open: below the MLL the account **fails**; below only
     the DLL the trade is liquidated at that open price (worse than the DLL) and the day ends.
   - Inside a bar price moves continuously, so the higher limit is hit first: DLL first means liquidation at exactly
     −DLL for the day; MLL first means the account **fails**.
3. End of day: balance += day P&L; MLL = min(max(MLL, highest EOD balance − $2,000), $50,000).
4. Pass at end of day when profit ≥ max($3,000, best day / 0.55).

Reported per run:
- **Rolling**: one attempt starting on every trading day. Gives the pass rate and days to pass/fail. Attempts overlap,
  so they are not independent samples.
- **Sequential**: back-to-back attempts as lived: after a pass or fail, restart the next day. Gives passes, fails and
  cost per pass. Billing model (VERIFY): a subscription starts with the first attempt and again after every pass,
  paid at the start and every 30 days until the pass; each fail inside it costs one reset.

## Not modelled yet

- Express Funded Account (XFA) rules and payouts: the next stage after the Combine passes.
- Tier-1 news restrictions (none listed for the standard Combine; check before relying on news trades).
- MAE uses 1-minute bar extremes, so it is the worst case inside each bar, not a tick path.
