"""Owner swing point rule (mandatory for every strategy that uses swings). Spec: docs/SWINGS.md.

Each candle gives two price events, its high and its low, in the order they printed. Swing points are found on
that event stream:
  R2/R3  candidate low at candle k: low[k-1] >= low[k] and low[k+1] > low[k]  (high: mirror). Known when k+1 closes.
  R1     points alternate: low, high, low, high ...
  R4     a swing low is the lowest price between the swing highs around it (every candle counts, also the swing
         high candles' own lows when they printed inside the transition); high: mirror.
  R5     a second low with no high between replaces the first if lower or equal (equal: the later one wins),
         otherwise it is dropped; high: mirror.
Event order inside a candle: from its 1-minute bars (higher timeframes). When unknown (a 1m candle, or both
extremes in the same 1m bar), continue the order: after a swing high the low comes first, after a swing low the
high. Owner example: after a swing high, the candle holding the lowest low becomes swing low, then swing high,
when the candle after it has a higher low and a lower high.
"""

from dataclasses import dataclass

import numpy as np
import pandas as pd

from .config import TICK
from .data import add_session, to_ticks

HIGH, LOW = 1, -1
UNKNOWN = -1
SESSION_LAST_MINUTE = 1379  # 15:59 CT, minutes since the 17:00 CT open: the last minute of a CME trading day
UNDO_DEPTH = 64  # points an outside-candle trial may rewrite; a deeper cascade raises
# 1w, 1mo: trading-day groups (minutes are nominal); "1mo", never "1M", so it cannot be misread as 1m
TIMEFRAMES = {"1m": 1, "5m": 5, "15m": 15, "30m": 30, "1h": 60, "4h": 240, "1d": 1440, "1w": 7200, "1mo": 30000}


@dataclass
class Candles:
    ts: pd.DatetimeIndex  # candle open (UTC)
    o: np.ndarray  # ticks
    h: np.ndarray
    l: np.ndarray  # noqa: E741
    c: np.ndarray
    high_first: np.ndarray  # 1 high printed first, 0 low first, -1 unknown
    avail: np.ndarray  # 1m bar index at whose close the candle is complete
    first: np.ndarray  # 1m bar index of the candle's first bar
    last: np.ndarray  # 1m bar index of the candle's last bar (avail can be later when its last minute is missing)

    def __len__(self) -> int:
        return len(self.o)


def build_candles(df: pd.DataFrame, tf: str) -> Candles:
    """Candles from 1m bars. 5m-1h: clock aligned. 4h: blocks from the 17:00 CT session open. 1d: trading day.
    1w: trading days Monday-Friday. 1mo: trading days of one calendar month.
    A candle is complete at the close of its last minute (the 15:59 CT bar for the day's last 4h block and the daily
    candle); when that minute has no bar (early closes, quiet minutes), at the close of the next bar."""
    if tf not in TIMEFRAMES:
        raise ValueError(f"timeframe {tf} not in {list(TIMEFRAMES)}")
    if "sess_minute" not in df:
        df = add_session(df)
    n = len(df)
    o, h, l, c = (to_ticks(df[k]) for k in ("open", "high", "low", "close"))
    if n == 0:
        none = np.zeros(0, dtype=np.int64)
        return Candles(pd.DatetimeIndex([], tz="UTC"), none, none, none, none, none, none, none, none)
    if tf == "1m":
        idx = np.arange(n)
        return Candles(pd.DatetimeIndex(df["ts"]), o, h, l, c, np.full(n, UNKNOWN), idx, idx, idx)
    minutes = TIMEFRAMES[tf]
    sess = df["sess_minute"].to_numpy()
    day = pd.factorize(df["trading_day"])[0].astype(np.int64)
    day_close = sess == SESSION_LAST_MINUTE
    if tf == "1d":
        gid, last_minute = day, day_close
    elif tf in ("1w", "1mo"):
        tday = pd.DatetimeIndex(df["trading_day"])
        if tf == "1w":  # Monday-to-Friday trading days (Sunday evening belongs to Monday)
            gid = ((tday.as_unit("ns").asi8 // 86_400_000_000_000) + 3) // 7  # 1970-01-01 was a Thursday
        else:
            gid = (tday.year * 12 + tday.month).to_numpy()
        gid = np.asarray(gid, dtype=np.int64)
        # complete at 15:59 CT of the scheduled last day (Friday / last weekday of the month), from the bar's own
        # date only, so a live prefix agrees with full history. A holiday on that day: complete at the next bar.
        if tf == "1w":
            sched = tday.day_of_week == 4
        else:
            sched = tday == tday + pd.offsets.BMonthEnd(0)
        last_minute = day_close & np.asarray(sched)
    elif tf == "4h":
        gid, last_minute = day * 10 + sess // 240, ((sess + 1) % 240 == 0) | day_close
    else:
        epoch_min = pd.DatetimeIndex(df["ts"]).as_unit("ns").asi8 // 60_000_000_000
        gid, last_minute = epoch_min // minutes, (epoch_min + 1) % minutes == 0
    start = np.flatnonzero(np.r_[True, gid[1:] != gid[:-1]])
    end = np.r_[start[1:], n] - 1
    hi = np.maximum.reduceat(h, start)
    lo = np.minimum.reduceat(l, start)
    first_hi = np.array([s + int(np.argmax(h[s:e + 1] == v)) for s, e, v in zip(start, end, hi, strict=True)])
    first_lo = np.array([s + int(np.argmax(l[s:e + 1] == v)) for s, e, v in zip(start, end, lo, strict=True)])
    order = np.where(first_hi < first_lo, 1, np.where(first_lo < first_hi, 0, UNKNOWN))
    avail = np.where(last_minute[end], end, end + 1)
    done = avail < n  # the last candle is left out until it is complete: it may still print new prices
    return Candles(pd.DatetimeIndex(df["ts"].to_numpy()[start[done]]), o[start[done]], hi[done], lo[done],
                   c[end[done]], order[done], avail[done], start[done], end[done])


@dataclass
class Point:
    kind: int  # HIGH or LOW
    price: int  # ticks
    candle: int
    event: int  # position in the event stream (2 per candle)


def _extreme_ok(kind: int, price: int, ev_hi: np.ndarray, ev_lo: np.ndarray, a: int, b: int) -> bool:
    """price is the highest high (kind HIGH) / lowest low in events a..b inclusive."""
    if b < a:
        return True
    return bool(price >= ev_hi[a:b + 1].max()) if kind == HIGH else bool(price <= ev_lo[a:b + 1].min())


def _offer(stack: list[Point], q: Point, ev_hi: np.ndarray, ev_lo: np.ndarray) -> None:
    while True:
        if not stack:
            if _extreme_ok(q.kind, q.price, ev_hi, ev_lo, 0, q.event):
                stack.append(q)
            return
        t = stack[-1]
        if t.kind == q.kind:  # R5: same type with no opposite point between
            more = q.price >= t.price if q.kind == HIGH else q.price <= t.price
            if not more:
                return
            stack.pop()
            continue
        if not _extreme_ok(q.kind, q.price, ev_hi, ev_lo, t.event + 1, q.event):
            return  # R4: a more extreme price already printed since t
        prev_event = stack[-2].event + 1 if len(stack) > 1 else 0
        if _extreme_ok(t.kind, t.price, ev_hi, ev_lo, prev_event, q.event - 1):
            stack.append(q)
            return
        stack.pop()  # R4: t is not the extreme of its own transition, so it is not a swing point


def _process(stack: list[Point], cd: Candles, k: int, high_first: int, is_low: bool, is_high: bool,
             ev_hi: np.ndarray, ev_lo: np.ndarray) -> None:
    """Offer candle k's two events in the given order."""
    first, second = (HIGH, LOW) if high_first == 1 else (LOW, HIGH)
    for slot, kind in enumerate((first, second)):
        e = 2 * k + slot
        ev_hi[e], ev_lo[e] = (cd.h[k], np.inf) if kind == HIGH else (-np.inf, cd.l[k])
        if kind == LOW and is_low:
            _offer(stack, Point(LOW, int(cd.l[k]), k, e), ev_hi, ev_lo)
        elif kind == HIGH and is_high:
            _offer(stack, Point(HIGH, int(cd.h[k]), k, e), ev_hi, ev_lo)


def _record(stack: list[Point], state: dict[str, np.ndarray], k: int) -> None:
    """State after candle k: the newest and the previous swing high and swing low in the structure
    (points alternate, so they are the top four of the stack)."""
    state["newest"][k] = stack[-1].kind if stack else 0
    seen = {HIGH: 0, LOW: 0}
    for p in stack[-1:-5:-1]:
        key = ("sh" if p.kind == HIGH else "sl") + ("" if seen[p.kind] == 0 else "2")
        seen[p.kind] += 1
        state[f"{key}_price"][k], state[f"{key}_candle"][k] = p.price, p.candle


def detect(cd: Candles) -> tuple[list[Point], dict[str, np.ndarray]]:
    """Run the rule over all candles. Returns the final swing points and the state as known after each candle's
    processing (candle k is processed when candle k+1 closes): last swing high / low price (ticks) and candle
    (sh, sl) and the ones before them (sh2, sl2), or -1 when none; newest: kind of the newest point (0 when none)."""
    n = len(cd)
    ev_hi = np.full(2 * n, -np.inf)  # high of a high event; -inf on low events
    ev_lo = np.full(2 * n, np.inf)
    stack: list[Point] = []
    state = {f"{key}_{f}": np.full(n, -1, dtype=np.int64) for key in ("sh", "sl", "sh2", "sl2")
             for f in ("price", "candle")}
    state["newest"] = np.zeros(n, dtype=np.int64)
    for k in range(n):
        is_low = 0 < k < n - 1 and cd.l[k - 1] >= cd.l[k] and cd.l[k + 1] > cd.l[k]
        is_high = 0 < k < n - 1 and cd.h[k - 1] <= cd.h[k] and cd.h[k + 1] < cd.h[k]
        high_first = int(cd.high_first[k])
        if high_first == UNKNOWN:
            high_first = 1 if stack and stack[-1].kind == LOW else 0  # continue the order
            if is_low and is_high and stack:
                cut = max(len(stack) - UNDO_DEPTH, 0)
                saved, last = stack[cut:], stack[-1]
                _process(stack, cd, k, high_first, is_low, is_high, ev_hi, ev_lo)
                if len(stack) < cut:
                    raise RuntimeError(f"swing cascade deeper than {UNDO_DEPTH} points at candle {k}")
                if all(p is not last for p in stack[cut:]):  # that order breaks rule 4 for the last point
                    del stack[cut:]
                    stack.extend(saved)
                    high_first = 1 - high_first
                else:
                    _record(stack, state, k)
                    continue
        _process(stack, cd, k, high_first, is_low, is_high, ev_hi, ev_lo)
        _record(stack, state, k)
    return stack, state


def swing_points(df: pd.DataFrame, tf: str = "1m") -> pd.DataFrame:
    """Final swing points over the whole frame (for charts and studies, NOT for signals: later candles can
    replace a point). Columns: kind (SH/SL), price, ts (candle open), known_at (1m bar index)."""
    cd = build_candles(df, tf)
    pts, _ = detect(cd)
    return pd.DataFrame({
        "kind": ["SH" if p.kind == HIGH else "SL" for p in pts],
        "price": [round(p.price * TICK, 2) for p in pts],
        "ts": [cd.ts[p.candle] for p in pts],
        "known_at": [int(cd.avail[p.candle + 1]) for p in pts],
    })


def swing_state(df: pd.DataFrame, tf: str = "1m", prev: bool = False, newest: bool = False) -> pd.DataFrame:
    """Point-in-time swing state for every 1m bar of df: the last swing high and swing low as they were known at
    that bar's close. Safe for signals. NaN until a swing exists, and NaN again when rule 4 removes it. The newest
    point can still be replaced (rule 5). prev=True adds the swing high and low before them ({tf}_sh2, {tf}_sl2).
    newest=True adds {tf}_newest: 1 when the newest point is the swing high, -1 the swing low, 0 none. It settles
    which came last when one candle is both (same _ts)."""
    cols = ("sh", "sl", "sh2", "sl2") if prev else ("sh", "sl")
    cd = build_candles(df, tf)
    n = len(df)
    out = pd.DataFrame(index=df.index)
    if len(cd) == 0:  # warm-up: no candle is complete yet
        for col in cols:
            out[f"{tf}_{col}"] = np.nan
            out[f"{tf}_{col}_ts"] = pd.Series(pd.NaT, index=df.index, dtype="datetime64[ns, UTC]")
        if newest:
            out[f"{tf}_newest"] = 0
        return out
    _, st = detect(cd)
    when = np.full(len(cd), n, dtype=np.int64)  # candle k is processed when candle k+1 is complete
    when[:-1] = cd.avail[1:]
    updated = np.flatnonzero(when < n)
    src = np.full(n, -1, dtype=np.int64)
    src[when[updated]] = updated  # several candles on one bar: the last one wins
    src = np.maximum.accumulate(src)  # each bar shows the newest full snapshot, never a mix of old and new
    known = src >= 0
    for col in cols:
        candle = np.where(known, st[f"{col}_candle"][np.maximum(src, 0)], -1)
        ok = candle >= 0
        price = np.where(ok, st[f"{col}_price"][np.maximum(src, 0)] * TICK, np.nan)
        out[f"{tf}_{col}"] = np.round(price, 2)
        ts = pd.Series(pd.NaT, index=df.index, dtype="datetime64[ns, UTC]")
        ts.iloc[np.flatnonzero(ok)] = cd.ts[candle[ok]]
        out[f"{tf}_{col}_ts"] = ts
    if newest:
        out[f"{tf}_newest"] = np.where(known, st["newest"][np.maximum(src, 0)], 0)
    return out
"""Bar-by-bar backtest of limit-entry bracket orders on CL 1-minute bars. Rules: docs/ENGINE.md.

A strategy returns signals: one row per bar i where, after bar i closes, it places a limit entry order.
Columns: side (+1 long / -1 short), limit, stop (required), target (optional, NaN = none),
expire (bars the order stays working, default 30) or expire_min (minutes of clock time after the signal bar's
close; replaces expire, so missing minutes cannot stretch the order), hold (max bars in the trade, optional),
qty (default 1), kill (optional: a price beyond the limit on the winning side, e.g. the target; a touch cancels
the unfilled order, see docs/ENGINE.md),
part_qty / part_target (optional partial exit: part_qty contracts leave at part_target, the rest runs on).

Optional trade management: `manage(ctx)` is called on every held bar m after the fill bar, before that bar's
exits are checked, with data up to bar m-1 only. It returns (stop, close_now): the stop for bar m (any price, in
the trade's own side space, see below) and whether to close the whole position at bar m's open.

Short trades run through the same code with prices negated, so every rule is written once, for longs.
`manage` sees those side-space prices too: for a short, ctx.E, ctx.S, ctx.best are negated ticks, and the stop it
returns must be negated ticks as well (helpers: ctx.side, ctx.to_side(price_ticks)).
"""

from collections.abc import Callable
from dataclasses import dataclass, field

import numpy as np
import pandas as pd

from .config import COMBINE_50K, FEE_ROUND_TURN, TICK, TICK_VALUE
from .data import Bars, session_minute, to_ticks


@dataclass(frozen=True)
class Fills:
    fee: float = FEE_ROUND_TURN  # $ per contract round turn
    flatten: int = session_minute(COMBINE_50K.flatten)  # session minute: no orders or positions from here
    through: int = 0  # 0: a touch fills (owner rule). N: the bar must trade N ticks beyond the limit (sensitivity)

    def __post_init__(self) -> None:
        if not isinstance(self.through, int) or isinstance(self.through, bool) or self.through < 0:
            raise ValueError(f"through must be a whole number of ticks >= 0, got {self.through!r}")


@dataclass
class Ctx:
    """What `manage` may look at on held bar m. Prices are integer ticks in side space (negated for shorts)."""

    i: int  # signal bar
    j: int  # fill bar
    m: int  # bar about to be checked (data up to m-1 may be used)
    side: int
    E: int  # entry
    S: int  # current stop
    T: int | None  # target
    qty: int  # contracts still open
    best: int  # highest side-space high from the fill bar through bar m-1 (the fill bar's high may predate the fill)
    state: dict = field(default_factory=dict)  # free per-trade memory for the strategy

    def to_side(self, ticks: int) -> int:
        return self.side * ticks


TRADE_COLUMNS = ["signal_bar", "entry_bar", "exit_bar", "entry_ts", "exit_ts", "trading_day", "side", "qty",
                 "entry", "exit", "reason", "ticks", "part_exit", "part_bar", "part_qty", "gross", "fee", "net", "mae",
                 "mfe", "path"]
# ticks: exit - entry of the final leg per contract (side-adjusted). part_exit: price of the partial exit or NaN;
# part_bar / part_qty: its bar and contracts (-1 / 0 without a partial).
# path: (open P&L per held bar, worst P&L per held bar) in $ incl. fee; first entry = the fill bar.
# The Combine simulator walks it so a gap through a loss limit executes at the open, not at the limit.


def _prepare(signals: pd.DataFrame, n: int) -> pd.DataFrame:
    s = signals.copy()
    for col, default in (("target", np.nan), ("expire", 30), ("expire_min", np.nan), ("hold", np.nan), ("qty", 1),
                         ("part_qty", 0), ("part_target", np.nan), ("void", np.nan), ("kill", np.nan)):
        if col not in s:
            s[col] = default
    missing = {"side", "limit", "stop"} - set(s.columns)
    if missing:
        raise ValueError(f"signals miss columns {sorted(missing)}")
    if not s.index.is_unique or s.index.min() < 0 or s.index.max() >= n:
        raise ValueError("signal index must be unique bar positions inside the bars")
    if not s["side"].isin([1, -1]).all():
        raise ValueError("side must be +1 or -1")
    if not np.isfinite(s[["limit", "stop"]].to_numpy(float)).all():
        raise ValueError("limit and stop must be finite prices")
    if not np.isfinite(s[["qty", "expire", "part_qty"]].to_numpy(float)).all():
        raise ValueError("qty, expire and part_qty must be finite")
    if (s["qty"] < 1).any() or (s["expire"] < 1).any() or (s["hold"] < 0).any() or (s["expire_min"] < 1).any():
        raise ValueError("qty, expire and expire_min must be >= 1, hold >= 0")
    pq, q = s["part_qty"].to_numpy(np.int64), s["qty"].to_numpy(np.int64)
    if (pq < 0).any() or ((pq > 0) & (pq >= q)).any():
        raise ValueError("part_qty must be 0 or below qty")
    if ((pq > 0) & ~np.isfinite(s["part_target"].to_numpy(float))).any():
        raise ValueError("part_qty needs a finite part_target")
    return s.sort_index()


def _ticks_or_zero(prices: pd.Series) -> tuple[np.ndarray, np.ndarray]:
    """Prices as float and as integer ticks; NaN (no order) becomes 0 ticks."""
    v = prices.to_numpy(float)
    return v, np.where(np.isnan(v), 0, np.round(np.nan_to_num(v) / TICK)).astype(np.int64)


def _check_stop(stop, signal_bar: int) -> int:
    """manage() must return a finite whole number of ticks (side space: use ctx.to_side for shorts)."""
    if not np.isfinite(stop) or stop != int(stop):
        raise ValueError(f"signal at bar {signal_bar}: manage returned stop {stop}; need whole side-space ticks")
    return int(stop)


def _open_qty(held: list[tuple[int, int, int, int, int]], bar: int) -> int:
    """Contracts still open at the close of `bar` (held: entry bar, exit bar, contracts, partial bar, partial
    contracts; partial bar -1 when none)."""
    return sum(q - (pq if 0 <= pb <= bar else 0) for e, x, q, pb, pq in held if e <= bar < x)


def backtest(bars: Bars, signals: pd.DataFrame, fills: Fills = Fills(),
             manage: Callable[[Ctx], tuple[int, bool]] | None = None, overlap: bool = False,
             max_contracts: int = COMBINE_50K.max_contracts) -> pd.DataFrame:
    """overlap=False: one order or position at a time. overlap=True: a new signal cancels an unfilled order but
    open positions keep running, up to max_contracts open at once (a signal that would exceed it is ignored)."""
    n = len(bars)
    sig = _prepare(signals, n)
    flat = fills.flatten
    views = {1: (bars.o, bars.h, bars.l, bars.c), -1: (-bars.o, -bars.l, -bars.h, -bars.c)}
    lim, stp = to_ticks(sig["limit"]), to_ticks(sig["stop"])
    tgt, tgt_t = _ticks_or_zero(sig["target"])
    _, ptg_t = _ticks_or_zero(sig["part_target"])
    void, void_t = _ticks_or_zero(sig["void"])
    kill, kill_t = _ticks_or_zero(sig["kill"])
    sides, qtys = sig["side"].to_numpy(np.int64), sig["qty"].to_numpy(np.int64)
    pqtys = sig["part_qty"].to_numpy(np.int64)
    expires, holds = sig["expire"].to_numpy(np.int64), sig["hold"].to_numpy(float)
    expire_min = sig["expire_min"].to_numpy(float)
    minute = bars.ts.as_unit("ns").asi8 // 60_000_000_000  # bar open, minutes since epoch
    rows = []
    next_free = -1
    sig_bars = sig.index.to_numpy()
    held: list[tuple[int, int, int, int, int]] = []  # overlap: trades that may be open (see _open_qty)
    for r, i in enumerate(sig_bars):
        if i + 1 >= n:
            continue
        side, qty, pq = int(sides[r]), int(qtys[r]), int(pqtys[r])
        cancel_at = n  # overlap: the next accepted signal's bar; this order works through it at most
        if overlap:
            held = [t for t in held if t[1] > i]
            if _open_qty(held, i) + qty > max_contracts:
                continue
            for r2 in range(r + 1, len(sig_bars)):
                if sig_bars[r2] + 1 < n and _open_qty(held, sig_bars[r2]) + qtys[r2] <= max_contracts:
                    cancel_at = int(sig_bars[r2])
                    break
        elif i < next_free:
            continue
        o, h, l, c = views[side]
        L, S = side * lim[r], side * stp[r]
        T = None if np.isnan(tgt[r]) else side * tgt_t[r]
        P = side * ptg_t[r] if pq > 0 else None
        V = None if np.isnan(void[r]) else side * void_t[r]
        if V is not None and V > L:
            raise ValueError(f"signal at bar {i}: void must be at or beyond the limit on the losing side")
        K = None if np.isnan(kill[r]) else side * kill_t[r]
        if K is not None and K <= L:
            raise ValueError(f"signal at bar {i}: kill must be beyond the limit on the winning side")
        if S >= L or (T is not None and T <= L) or (P is not None and (P <= L or (T is not None and P > T))):
            raise ValueError(f"signal at bar {i}: stop must be on the losing side and targets on the winning side")
        hold = None if np.isnan(holds[r]) else int(holds[r])
        day, sym = bars.day_id[i], bars.sym_id[i]
        # --- working entry order: bars i+1 .. i+expire ---
        entry_bar, last_active, voided = -1, i, -1
        timed = not np.isnan(expire_min[r])
        deadline = minute[i] + 1 + int(expire_min[r]) if timed else 0  # first minute the order no longer works
        for j in range(i + 1, n if timed else min(n, i + 1 + int(expires[r]))):
            if bars.day_id[j] != day or bars.sym_id[j] != sym or bars.sess_minute[j] >= flat:
                break
            if (timed and minute[j] >= deadline) or j > cancel_at:
                break
            F = L - fills.through  # a touch fills (owner rule); `through` asks for a trade beyond the limit
            if V is not None and o[j] < V:  # opened beyond the void: cancelled before any fill
                voided = j
                break
            if l[j] <= F:
                # From the open price falls through F before V - 1 (the void break) unless V - 1 >= F: then the
                # void breaks first (same price: order unknown, cancelled).
                if V is None or o[j] <= F or F >= V:
                    if K is not None and o[j] > F and h[j] >= K:  # fill level and kill in one bar: order unknown
                        voided = j
                        break
                    entry_bar, E = j, min(o[j], L)
                    break
                voided = j
                break
            if V is not None and l[j] < V:  # void broken without reaching the fill level: cancelled
                voided = j
                break
            if K is not None and h[j] >= K:  # kill touched before any fill: cancelled
                voided = j
                break
            last_active = j
        if entry_bar < 0:
            if voided >= 0:  # the order worked into bar j until the void or kill cancelled it: free from j's close
                next_free = voided
                continue
            next_free = last_active
            if timed and last_active + 1 < n and minute[last_active + 1] >= deadline \
                    and minute[last_active] + 1 < deadline:
                next_free = last_active + 1  # a gap spans the deadline: the order still worked at last_active's close
            continue
        # --- position: per held bar, the open and worst price feed the Combine path check ---
        j = entry_bar
        X, reason = None, ""
        rem, realized, PX, PB = qty, 0, None, -1  # contracts open, side-space ticks*contracts booked by the partial
        p_open, p_worst = [0], [(l[j] - E) * qty]
        best = h[j]
        best_pnl = (h[j] - E) * qty  # best open P&L (ticks x contracts) for mfe
        ctx = Ctx(i=int(i), j=j, m=j, side=side, E=int(E), S=int(S), T=None if T is None else int(T),
                  qty=rem, best=int(best)) if manage is not None else None
        if l[j] <= S:  # stop on the fill bar: assume it came after the fill
            X, reason = min(E, S), "stop"
            p_worst[0] = (X - E) * qty  # the bar low before the fill is not part of the trade
        m = j
        while X is None:
            if m > j:
                close_now = False
                if manage is not None and ctx is not None:
                    ctx.m, ctx.S, ctx.qty, ctx.best = m, int(S), rem, int(best)
                    new_s, close_now = manage(ctx)
                    S = _check_stop(new_s, i)
                real0, rem0 = realized, rem  # booked P&L and contracts at the bar's open
                part_at_open = False
                if bars.sess_minute[m] >= flat:
                    X, reason = o[m], "flatten"
                elif close_now:
                    X, reason = o[m], "manage"
                elif o[m] <= S:
                    X, reason = o[m], "stop"
                elif T is not None and o[m] >= T:
                    X, reason = o[m], "target"
                else:
                    if P is not None and PX is None and o[m] >= P:  # partial at the open (gap in our favour)
                        PX, PB, realized, rem = o[m], m, realized + (o[m] - E) * pq, rem - pq
                        part_at_open = True
// Reaction Level Matrix [WillyAlgoTrader] v1.0.0 — LOGIC EXCERPT (owner paste 2026-11-19).
// Visuals, dashboard, alerts, colors and input tooltips removed; trading logic copied verbatim.

STRUCT_ATR_LEN     = 34
MIN_HALF_WIDTH_ATR = 0.15
REACTION_CAP       = 2.5
SCORE_SCALE        = 6.0
POLARITY_BONUS     = 1.25
CROSS_PENALTY      = 0.7
MIN_STRENGTH       = 0.25
MAX_LEVELS         = 60
MERGE_PASSES       = 5
WICK_BUFFER_ATR   = 0.25
WICK_MIN_ATR      = 0.5

swingLenInput      = 6      // ta.pivothigh/pivotlow left=right=6
levelTolInput      = 0.6    // ×ATR34
minTouchesInput    = 2
halfLifeInput      = 500    // bars
levelsPerSideInput = 3
minScoreInput      = 50
rejectClvInput     = 0.6
cooldownInput      = 10     // bars per level
riskPreset "Balanced" => SL 1.5×ATR (ATR mode), TP 1R/2R/3R
slModeInput        = "Wick-Anchored"
atrLenRiskInput    = 14
beInput            = true, beOffset 0

type Level: lo, hi, mid, sumW, sumWP, sumWP2, strength, touches, highTouches, lowTouches, firstTime, firstBar,
            activeTime, lastTouchBar, crosses, side (+1 price above = support, -1 below = resistance), sideBar,
            lastSignalBar, shown

levelScore(lv) = 100 * (1 - exp(-(strength * (polar ? 1.25 : 1)) / 6))     // polar = touched by highs AND lows

refitBand: mid = Σw·p/Σw ; hw = clamp(weighted std, 0.15·ATR, tol·ATR) ; lo/hi = mid ∓ hw
addTouch: sums += w, strength += w, touches += 1, high/lowTouches, lastTouchBar; activeTime when touches >= 2; refit
newLevel(price, w, ...): side = close > price ? 1 : -1 ; sideBar = bar_index ; addTouch

registerSwing(lvls, price, w, isHigh, pBar, pTime, a):
    join the level with the nearest mid within tol·ATR (|mid - price| <= tol·ATR), else push newLevel
    after a join: up to 5 passes, merge every other level whose [lo,hi] overlaps the joined level's [lo,hi]
        (sums/strength/touches add; crosses = max; lastSignalBar = max)
    while size > 60: remove the weakest-strength level

ageAndCross(lvls, decay) once per confirmed bar, BEFORE registering this bar's new swings:
    strength *= decay (decay = 0.5^(1/500))
    newSide = close > hi ? 1 : close < lo ? -1 : side
    if newSide != side:
        if touches >= 2: crosses += 1 ; strength *= 0.7 ; (count break of shown levels for trend display)
        side = newSide ; sideBar = bar_index
    remove if strength < 0.25

selectNearest(lvls, sideWanted, 3): the 3 levels with touches >= 2 and side == sideWanted nearest to close (|close-mid|)

Per bar (confirmed only):
    structAtr = ATR(34) ; swHigh = pivothigh(high,6,6) ; swLow = pivotlow(low,6,6)
    wHigh = 1 + min((swHigh - lowest(low,6)) / ATR34[6], 2.5)      // reaction during the 6 confirmation bars
    wLow  = 1 + min((highest(high,6) - swLow) / ATR34[6], 2.5)
    ageAndCross ; registerSwing(high) ; registerSwing(low)
    selRes = selectNearest(-1, 3) ; selSup = selectNearest(+1, 3)

checkBuyRejection(sup): clv = (close-low)/(high-low) (0.5 if range 0); for each shown support, nearest first:
    approached = side == 1 and sideBar < bar_index
    touched    = low <= hi
    heldAbove  = close > hi
    strongBar  = clv >= 0.6
    scoreOk    = levelScore >= 50
    rested     = lastSignalBar na or bar_index - lastSignalBar >= 10
    all true -> fire, lastSignalBar = bar_index, break
checkSellRejection: mirror (high >= lo, close < lo, (high-close)/range >= 0.6)
long wins if both fire; signals only after warmup (bar >= max(34, 13)).

Trade engine (one position, no pyramiding):
    entry = signal bar close (market)
    Wick SL long = min(low - 0.25·ATR14, close - 0.5·ATR14)    ; short mirror
    TP1/2/3 = entry ± 1R/2R/3R (R = |entry - SL|)
    hit checks from the bar after entry, confirmed bars, intrabar: TP touch registered even if SL touched same bar
    ("TP priority": optimistic); SL close blocked when TP1 or TP3 first touched on that bar
    BE after TP1: stop -> entry (+offset)
    close on TP3 touch or SL; opposite signal = reversal (close, count, then enter new side)
    WIN = TP1 was touched (a BE stop after TP1 is a win; P&L never computed, no fees/slippage)

