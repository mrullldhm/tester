     1	"""Owner swing point rule (mandatory for every strategy that uses swings). Spec: docs/SWINGS.md.
     2	
     3	Each candle gives two price events, its high and its low, in the order they printed. Swing points are found on
     4	that event stream:
     5	  R2/R3  candidate low at candle k: low[k-1] >= low[k] and low[k+1] > low[k]  (high: mirror). Known when k+1 closes.
     6	  R1     points alternate: low, high, low, high ...
     7	  R4     a swing low is the lowest price between the swing highs around it (every candle counts, also the swing
     8	         high candles' own lows when they printed inside the transition); high: mirror.
     9	  R5     a second low with no high between replaces the first if lower or equal (equal: the later one wins),
    10	         otherwise it is dropped; high: mirror.
    11	Event order inside a candle: from its 1-minute bars (higher timeframes). When unknown (a 1m candle, or both
    12	extremes in the same 1m bar), continue the order: after a swing high the low comes first, after a swing low the
    13	high. Owner example: after a swing high, the candle holding the lowest low becomes swing low, then swing high,
    14	when the candle after it has a higher low and a lower high.
    15	"""
    16	
    17	from dataclasses import dataclass
    18	
    19	import numpy as np
    20	import pandas as pd
    21	
    22	from .config import TICK
    23	from .data import add_session, to_ticks
    24	
    25	HIGH, LOW = 1, -1
    26	UNKNOWN = -1
    27	SESSION_LAST_MINUTE = 1379  # 15:59 CT, minutes since the 17:00 CT open: the last minute of a CME trading day
    28	UNDO_DEPTH = 64  # points an outside-candle trial may rewrite; a deeper cascade raises
    29	# 1w, 1mo: trading-day groups (minutes are nominal); "1mo", never "1M", so it cannot be misread as 1m
    30	TIMEFRAMES = {"1m": 1, "5m": 5, "15m": 15, "30m": 30, "1h": 60, "4h": 240, "1d": 1440, "1w": 7200, "1mo": 30000}
    31	
    32	
    33	@dataclass
    34	class Candles:
    35	    ts: pd.DatetimeIndex  # candle open (UTC)
    36	    o: np.ndarray  # ticks
    37	    h: np.ndarray
    38	    l: np.ndarray  # noqa: E741
    39	    c: np.ndarray
    40	    high_first: np.ndarray  # 1 high printed first, 0 low first, -1 unknown
    41	    avail: np.ndarray  # 1m bar index at whose close the candle is complete
    42	    first: np.ndarray  # 1m bar index of the candle's first bar
    43	    last: np.ndarray  # 1m bar index of the candle's last bar (avail can be later when its last minute is missing)
    44	
    45	    def __len__(self) -> int:
    46	        return len(self.o)
    47	
    48	
    49	def build_candles(df: pd.DataFrame, tf: str) -> Candles:
    50	    """Candles from 1m bars. 5m-1h: clock aligned. 4h: blocks from the 17:00 CT session open. 1d: trading day.
    51	    1w: trading days Monday-Friday. 1mo: trading days of one calendar month.
    52	    A candle is complete at the close of its last minute (the 15:59 CT bar for the day's last 4h block and the daily
    53	    candle); when that minute has no bar (early closes, quiet minutes), at the close of the next bar."""
    54	    if tf not in TIMEFRAMES:
    55	        raise ValueError(f"timeframe {tf} not in {list(TIMEFRAMES)}")
    56	    if "sess_minute" not in df:
    57	        df = add_session(df)
    58	    n = len(df)
    59	    o, h, l, c = (to_ticks(df[k]) for k in ("open", "high", "low", "close"))
    60	    if n == 0:
    61	        none = np.zeros(0, dtype=np.int64)
    62	        return Candles(pd.DatetimeIndex([], tz="UTC"), none, none, none, none, none, none, none, none)
    63	    if tf == "1m":
    64	        idx = np.arange(n)
    65	        return Candles(pd.DatetimeIndex(df["ts"]), o, h, l, c, np.full(n, UNKNOWN), idx, idx, idx)
    66	    minutes = TIMEFRAMES[tf]
    67	    sess = df["sess_minute"].to_numpy()
    68	    day = pd.factorize(df["trading_day"])[0].astype(np.int64)
    69	    day_close = sess == SESSION_LAST_MINUTE
    70	    if tf == "1d":
    71	        gid, last_minute = day, day_close
    72	    elif tf in ("1w", "1mo"):
    73	        tday = pd.DatetimeIndex(df["trading_day"])
    74	        if tf == "1w":  # Monday-to-Friday trading days (Sunday evening belongs to Monday)
    75	            gid = ((tday.as_unit("ns").asi8 // 86_400_000_000_000) + 3) // 7  # 1970-01-01 was a Thursday
    76	        else:
    77	            gid = (tday.year * 12 + tday.month).to_numpy()
    78	        gid = np.asarray(gid, dtype=np.int64)
    79	        # complete at 15:59 CT of the scheduled last day (Friday / last weekday of the month), from the bar's own
    80	        # date only, so a live prefix agrees with full history. A holiday on that day: complete at the next bar.
    81	        if tf == "1w":
    82	            sched = tday.day_of_week == 4
    83	        else:
    84	            sched = tday == tday + pd.offsets.BMonthEnd(0)
    85	        last_minute = day_close & np.asarray(sched)
    86	    elif tf == "4h":
    87	        gid, last_minute = day * 10 + sess // 240, ((sess + 1) % 240 == 0) | day_close
    88	    else:
    89	        epoch_min = pd.DatetimeIndex(df["ts"]).as_unit("ns").asi8 // 60_000_000_000
    90	        gid, last_minute = epoch_min // minutes, (epoch_min + 1) % minutes == 0
    91	    start = np.flatnonzero(np.r_[True, gid[1:] != gid[:-1]])
    92	    end = np.r_[start[1:], n] - 1
    93	    hi = np.maximum.reduceat(h, start)
    94	    lo = np.minimum.reduceat(l, start)
    95	    first_hi = np.array([s + int(np.argmax(h[s:e + 1] == v)) for s, e, v in zip(start, end, hi, strict=True)])
    96	    first_lo = np.array([s + int(np.argmax(l[s:e + 1] == v)) for s, e, v in zip(start, end, lo, strict=True)])
    97	    order = np.where(first_hi < first_lo, 1, np.where(first_lo < first_hi, 0, UNKNOWN))
    98	    avail = np.where(last_minute[end], end, end + 1)
    99	    done = avail < n  # the last candle is left out until it is complete: it may still print new prices
   100	    return Candles(pd.DatetimeIndex(df["ts"].to_numpy()[start[done]]), o[start[done]], hi[done], lo[done],
   101	                   c[end[done]], order[done], avail[done], start[done], end[done])
   102	
   103	
   104	@dataclass
   105	class Point:
   106	    kind: int  # HIGH or LOW
   107	    price: int  # ticks
   108	    candle: int
   109	    event: int  # position in the event stream (2 per candle)
   110	
   111	
   112	def _extreme_ok(kind: int, price: int, ev_hi: np.ndarray, ev_lo: np.ndarray, a: int, b: int) -> bool:
   113	    """price is the highest high (kind HIGH) / lowest low in events a..b inclusive."""
   114	    if b < a:
   115	        return True
   116	    return bool(price >= ev_hi[a:b + 1].max()) if kind == HIGH else bool(price <= ev_lo[a:b + 1].min())
   117	
   118	
   119	def _offer(stack: list[Point], q: Point, ev_hi: np.ndarray, ev_lo: np.ndarray) -> None:
   120	    while True:
   121	        if not stack:
   122	            if _extreme_ok(q.kind, q.price, ev_hi, ev_lo, 0, q.event):
   123	                stack.append(q)
   124	            return
   125	        t = stack[-1]
   126	        if t.kind == q.kind:  # R5: same type with no opposite point between
   127	            more = q.price >= t.price if q.kind == HIGH else q.price <= t.price
   128	            if not more:
   129	                return
   130	            stack.pop()
   131	            continue
   132	        if not _extreme_ok(q.kind, q.price, ev_hi, ev_lo, t.event + 1, q.event):
   133	            return  # R4: a more extreme price already printed since t
   134	        prev_event = stack[-2].event + 1 if len(stack) > 1 else 0
   135	        if _extreme_ok(t.kind, t.price, ev_hi, ev_lo, prev_event, q.event - 1):
   136	            stack.append(q)
   137	            return
   138	        stack.pop()  # R4: t is not the extreme of its own transition, so it is not a swing point
   139	
   140	
   141	def _process(stack: list[Point], cd: Candles, k: int, high_first: int, is_low: bool, is_high: bool,
   142	             ev_hi: np.ndarray, ev_lo: np.ndarray) -> None:
   143	    """Offer candle k's two events in the given order."""
   144	    first, second = (HIGH, LOW) if high_first == 1 else (LOW, HIGH)
   145	    for slot, kind in enumerate((first, second)):
   146	        e = 2 * k + slot
   147	        ev_hi[e], ev_lo[e] = (cd.h[k], np.inf) if kind == HIGH else (-np.inf, cd.l[k])
   148	        if kind == LOW and is_low:
   149	            _offer(stack, Point(LOW, int(cd.l[k]), k, e), ev_hi, ev_lo)
   150	        elif kind == HIGH and is_high:
   151	            _offer(stack, Point(HIGH, int(cd.h[k]), k, e), ev_hi, ev_lo)
   152	
   153	
   154	def _record(stack: list[Point], state: dict[str, np.ndarray], k: int) -> None:
   155	    """State after candle k: the newest and the previous swing high and swing low in the structure
   156	    (points alternate, so they are the top four of the stack)."""
   157	    state["newest"][k] = stack[-1].kind if stack else 0
   158	    seen = {HIGH: 0, LOW: 0}
   159	    for p in stack[-1:-5:-1]:
   160	        key = ("sh" if p.kind == HIGH else "sl") + ("" if seen[p.kind] == 0 else "2")
   161	        seen[p.kind] += 1
   162	        state[f"{key}_price"][k], state[f"{key}_candle"][k] = p.price, p.candle
   163	
   164	
   165	def detect(cd: Candles) -> tuple[list[Point], dict[str, np.ndarray]]:
   166	    """Run the rule over all candles. Returns the final swing points and the state as known after each candle's
   167	    processing (candle k is processed when candle k+1 closes): last swing high / low price (ticks) and candle
   168	    (sh, sl) and the ones before them (sh2, sl2), or -1 when none; newest: kind of the newest point (0 when none)."""
   169	    n = len(cd)
   170	    ev_hi = np.full(2 * n, -np.inf)  # high of a high event; -inf on low events
   171	    ev_lo = np.full(2 * n, np.inf)
   172	    stack: list[Point] = []
   173	    state = {f"{key}_{f}": np.full(n, -1, dtype=np.int64) for key in ("sh", "sl", "sh2", "sl2")
   174	             for f in ("price", "candle")}
   175	    state["newest"] = np.zeros(n, dtype=np.int64)
   176	    for k in range(n):
   177	        is_low = 0 < k < n - 1 and cd.l[k - 1] >= cd.l[k] and cd.l[k + 1] > cd.l[k]
   178	        is_high = 0 < k < n - 1 and cd.h[k - 1] <= cd.h[k] and cd.h[k + 1] < cd.h[k]
   179	        high_first = int(cd.high_first[k])
   180	        if high_first == UNKNOWN:
   181	            high_first = 1 if stack and stack[-1].kind == LOW else 0  # continue the order
   182	            if is_low and is_high and stack:
   183	                cut = max(len(stack) - UNDO_DEPTH, 0)
   184	                saved, last = stack[cut:], stack[-1]
   185	                _process(stack, cd, k, high_first, is_low, is_high, ev_hi, ev_lo)
   186	                if len(stack) < cut:
   187	                    raise RuntimeError(f"swing cascade deeper than {UNDO_DEPTH} points at candle {k}")
   188	                if all(p is not last for p in stack[cut:]):  # that order breaks rule 4 for the last point
   189	                    del stack[cut:]
   190	                    stack.extend(saved)
   191	                    high_first = 1 - high_first
   192	                else:
   193	                    _record(stack, state, k)
   194	                    continue
   195	        _process(stack, cd, k, high_first, is_low, is_high, ev_hi, ev_lo)
   196	        _record(stack, state, k)
   197	    return stack, state
   198	
   199	
   200	def swing_points(df: pd.DataFrame, tf: str = "1m") -> pd.DataFrame:
   201	    """Final swing points over the whole frame (for charts and studies, NOT for signals: later candles can
   202	    replace a point). Columns: kind (SH/SL), price, ts (candle open), known_at (1m bar index)."""
   203	    cd = build_candles(df, tf)
   204	    pts, _ = detect(cd)
   205	    return pd.DataFrame({
   206	        "kind": ["SH" if p.kind == HIGH else "SL" for p in pts],
   207	        "price": [round(p.price * TICK, 2) for p in pts],
   208	        "ts": [cd.ts[p.candle] for p in pts],
   209	        "known_at": [int(cd.avail[p.candle + 1]) for p in pts],
   210	    })
   211	
   212	
   213	def swing_state(df: pd.DataFrame, tf: str = "1m", prev: bool = False, newest: bool = False) -> pd.DataFrame:
   214	    """Point-in-time swing state for every 1m bar of df: the last swing high and swing low as they were known at
   215	    that bar's close. Safe for signals. NaN until a swing exists, and NaN again when rule 4 removes it. The newest
   216	    point can still be replaced (rule 5). prev=True adds the swing high and low before them ({tf}_sh2, {tf}_sl2).
   217	    newest=True adds {tf}_newest: 1 when the newest point is the swing high, -1 the swing low, 0 none. It settles
   218	    which came last when one candle is both (same _ts)."""
   219	    cols = ("sh", "sl", "sh2", "sl2") if prev else ("sh", "sl")
   220	    cd = build_candles(df, tf)
