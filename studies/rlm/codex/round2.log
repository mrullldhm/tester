    71	def main() -> None:
    72	    ap = argparse.ArgumentParser()
    73	    ap.add_argument("--through", type=int, default=0)
    74	    ap.add_argument("--workers", type=int, default=min(5, os.cpu_count() or 1))
    75	    ap.add_argument("--only", nargs="*", help="unit filters key=value (e.g. sig_tf=1h)")
    76	    ap.add_argument("--merge", action="store_true")
    77	    a = ap.parse_args()
    78	    tag = f"through{a.through}_" if a.through else ""
    79	    (OUT / "grid_parts").mkdir(exist_ok=True)
    80	    if a.merge:
    81	        parts = sorted((OUT / "grid_parts").glob(f"{tag}*.csv"))
    82	        if not a.through:
    83	            parts = [q for q in parts if not q.name.startswith("through")]
    84	        g = pd.concat([pd.read_csv(q) for q in parts], ignore_index=True)
    85	        g.to_csv(OUT / f"grid_dev{'_' + tag.rstrip('_') if tag else ''}.csv", index=False)
    86	        print("merged", len(parts), "units", len(g), "rows")
    87	        return
    88	    df = load_period("dev")
    89	    for reg in ("lock", "confirm"):
    90	        for tf in SOURCES:
    91	            swing_events(df, tf, reg)  # once in the parent; forked workers inherit the cache
    92	    _G.update(df=df, bars=Bars.from_frame(df), days=topstep.trading_days(df), fills=Fills(through=a.through), tag=tag)
    93	    units = [dict(zip(LEVEL_KEYS, v, strict=True)) for v in itertools.product(*(Strategy.GRID[k] for k in LEVEL_KEYS))]
    94	    for f in a.only or []:
    95	        k, v = f.split("=")
    96	        units = [u for u in units if str(u[k]) == v]
    97	    order = {"5m": 0, "15m": 1, "1h": 2}
    98	    units.sort(key=lambda u: order[u["sig_tf"]])  # longest first
    99	    print(f"{len(units)} level units, through={a.through}, workers={a.workers}", flush=True)
   100	    with get_context("fork").Pool(a.workers, maxtasksperchild=1) as pool:
   101	        for msg in pool.imap_unordered(run_unit, units):
   102	            print(msg, flush=True)
