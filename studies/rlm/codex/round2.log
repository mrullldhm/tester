    51	def run_unit(unit: dict) -> str:
    52	    df, bars, days, fills, tag = _G["df"], _G["bars"], _G["days"], _G["fills"], _G["tag"]
    53	    name = "_".join(str(unit[k]) for k in LEVEL_KEYS)
    54	    path = OUT / "grid_parts" / f"{tag}{name}.csv"
    55	    if path.exists():
    56	        return f"skip {name}"
    57	    candidates(df, unit["sig_tf"], unit["reg"], unit["sources"], unit["weight"], float(unit["tol"]))
    58	    g = {k: v for k, v in Strategy.GRID.items() if k not in LEVEL_KEYS}
    59	    rows = []
    60	    for vals in itertools.product(*g.values()):
    61	        p = {**unit, **dict(zip(g, vals, strict=True))}
    62	        s = Strategy()
    63	        trades = backtest(bars, s.signals(df, p), fills, s.manage)
    64	        rows.append({**p, **evaluate(trades, days)})
    65	    tmp = path.with_suffix(".tmp")
    66	    pd.DataFrame(rows).to_csv(tmp, index=False)
    67	    tmp.rename(path)
    68	    return f"done {name}"
