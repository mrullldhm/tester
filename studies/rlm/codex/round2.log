    35	    return round(sum(by.get(y, 0.0) > 0 for y in years) / len(years), 3)
    36	
    37	
    38	def evaluate(trades: pd.DataFrame, days: list) -> dict:
    39	    st = metrics.summary(trades, days)
    40	    cb = topstep.summary(topstep.rolling(trades, days), topstep.sequential(trades, days), days)
    41	    td = pd.to_datetime(trades["trading_day"]) if len(trades) else pd.Series(dtype="datetime64[ns]")
    42	    net = trades["net"] if len(trades) else pd.Series(dtype=float)
    43	    return {"trades": st.get("trades", 0), "net": st.get("net", 0.0), "pf": st.get("profit_factor"),
    44	            "win": st.get("win_rate"), "avg": st.get("avg_trade"), "maxdd": st.get("max_drawdown"),
    45	            "years_pos_all": years_pos(trades, days), "pass_rate": cb["pass_rate"], "seq_passes": cb["seq_passes"],
    46	            "seq_fails": cb["seq_fails"], "cost_per_pass": cb["seq_cost_per_pass_usd"],
    47	            "net_h1": float(net[td < SPLIT].sum()), "net_h2": float(net[td >= SPLIT].sum()),
    48	            "longs": int((trades["side"] == 1).sum()) if len(trades) else 0}
    49	
