   440	class Strategy(Base):
   441	    NAME = "rlm"
   442	    ABOUT = ("Reaction Level Matrix (WillyAlgoTrader) on CL: price levels from owner-rule swing points weighted by "
   443	             "timeframe; buy a rejection candle at support (sell at resistance) with a limit, wick or band stop, "
   444	             "R-multiple target.")
   445	    PARAMS = {"sig_tf": "15m", "reg": "lock", "sources": "all", "weight": "tf", "tol": 0.6, "score": 50, "clv": 0.6,
   446	              "entry": "close", "stop": "wick", "exit": "be3", "session": "all"}
   447	    GRID = {"sig_tf": ["5m", "15m", "1h"], "reg": ["lock", "confirm"], "sources": ["all", "htf"],
   448	            "weight": ["tf", "flat"], "tol": [0.4, 0.6, 1.0], "score": [0, 50, 70], "clv": [0.6, 0.75],
   449	            "entry": ["close", "band"],
   450	            "stop": ["wick", "band"], "exit": ["r1", "r2", "r3", "be3"], "session": ["all", "rth"]}
   451	
   452	    def __init__(self) -> None:
   453	        self._p: dict = {}
   454	        self._opp: dict[int, list[int]] = {}
   455	        self._side_hi: dict[int, np.ndarray] = {}
   456	
   457	    def orders(self, df: pd.DataFrame, p: dict) -> pd.DataFrame:
   458	        cand = candidates(df, p["sig_tf"], p["reg"], p["sources"], p["weight"], float(p["tol"]))
   459	        return build_orders(cand, df, p)
   460	
   461	    def signals(self, df: pd.DataFrame, p: dict) -> pd.DataFrame:
   462	        self._p = p
   463	        o = self.orders(df, p)
   464	        cols = ["side", "limit", "stop", "target", "expire_min", "kill"]
   465	        if o.empty:
   466	            return pd.DataFrame(columns=cols)
   467	        side = o["side"].to_numpy()
   468	        self._opp = {sd: sorted(o.loc[o["side"] == -sd, "bar"].astype(int)) for sd in (1, -1)}
   469	        self._side_hi = {1: to_ticks(df["high"]), -1: -to_ticks(df["low"])}
   470	        tgt = side * o["T"].to_numpy() * TICK
   471	        return pd.DataFrame({"side": side, "limit": np.round(side * o["E"].to_numpy() * TICK, 2),
   472	                             "stop": np.round(side * o["S"].to_numpy() * TICK, 2), "target": np.round(tgt, 2),
   473	                             "expire_min": EXPIRE_BARS * TIMEFRAMES[p["sig_tf"]], "kill": np.round(tgt, 2)},
   474	                            index=o["bar"].astype(int).to_numpy())
   475	
   476	    def manage(self, ctx):
   477	        """be3: stop to entry once a bar after the fill bar reached entry + 1R (R = (target - entry) / 3), effective
   478	        from the next bar. be3opp: also close at the open after an opposite signal bar (signal at or after the fill
   479	        bar, original reversal exit)."""
   480	        ex = self._p.get("exit")
   481	        if ex not in ("be3", "be3opp"):
   482	            return ctx.S, False
   483	        st = ctx.state
   484	        if "mx" not in st:
   485	            st["mx"], st["R"] = -10**12, (ctx.T - ctx.E) // 3
   486	        if ctx.m - 1 > ctx.j:
   487	            st["mx"] = max(st["mx"], int(self._side_hi[ctx.side][ctx.m - 1]))
   488	        stop = ctx.E if st["mx"] >= ctx.E + st["R"] else ctx.S
   489	        stop = max(stop, ctx.S)
   490	        if ex == "be3opp":
   491	            opp = self._opp[ctx.side]
   492	            k = bisect_left(opp, ctx.j)
   493	            if k < len(opp) and opp[k] <= ctx.m - 1:
   494	                return stop, True
   495	        return stop, False

