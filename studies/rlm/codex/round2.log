"""rlm: level book accounting (join, TF dedupe/upgrade, withdraw, cross penalty), order geometry for both sides,
break-even management that ignores the fill-bar high, and swing-event timing (docs/strategies/rlm/README.md)."""

import numpy as np
import pandas as pd
import pytest

from cltester.data import add_session
from cltester.engine import Ctx
from cltester.swings import HIGH, LOW
from strategies.rlm import COMBOS, CROSS_PENALTY, Book, Strategy, build_orders, swing_events

A = 10.0  # ATR34 in ticks


def _book(tol: float = 0.6) -> Book:
    return Book(len(COMBOS), tol)


def test_two_touches_join_one_level_weighted_mean():
    b = _book()
    b.touch((0, LOW, 1), LOW, 1000, 10, 14, 1.0, A, 1010.0, 5)
    b.touch((2, HIGH, 9), HIGH, 1004, 100, 159, 2.0, A, 990.0, 50)  # within 0.6 * 10 ticks
    al = np.flatnonzero(b.alive)
    assert len(al) == 1
    s = al[0]
    assert b.touches[s] == 2 and b.ht[s] == 1 and b.lt[s] == 1
    assert b.mid[s] == pytest.approx((1000 * 1 + 1004 * 2) / 3)
    assert b.strength[s] == pytest.approx(3.0) and b.maxw[s] == 2.0


def test_same_extreme_on_higher_tf_upgrades_weight_not_touches():
    b = _book()
    b.touch((0, LOW, 3), LOW, 1000, 15, 19, 1.0, A, 1010.0, 5)  # 5m candle bars 15..19
    b.touch((2, LOW, 0), LOW, 1000, 0, 59, 2.0, A, 1010.0, 9)  # 1h candle bars 0..59 holds the same low
    s = np.flatnonzero(b.alive)[0]
    assert b.touches[s] == 1 and b.strength[s] == pytest.approx(2.0) and b.maxw[s] == 2.0
    b.touch((1, LOW, 1), LOW, 1000, 15, 29, 1.5, A, 1010.0, 9)  # a weaker TF of it later adds nothing
    assert b.touches[s] == 1 and b.strength[s] == pytest.approx(2.0)


def test_withdraw_drops_to_next_tf_then_removes():
    b = _book()
    b.touch((0, LOW, 3), LOW, 1000, 15, 19, 1.0, A, 1010.0, 5)
    b.touch((2, LOW, 0), LOW, 1000, 0, 59, 2.0, A, 1010.0, 5)
    s = np.flatnonzero(b.alive)[0]
    b.withdraw((2, LOW, 0), A, 5)
    assert b.alive[s] and b.touches[s] == 1 and b.strength[s] == pytest.approx(1.0)
    b.withdraw((0, LOW, 3), A, 5)
    assert not b.alive.any()


def test_cross_flips_side_and_costs_strength_only_when_active():
    b = _book()
    b.touch((0, LOW, 1), LOW, 1000, 10, 14, 1.0, A, 1010.0, 5)
    s = np.flatnonzero(b.alive)[0]
    b.age_cross(980.0, 1.0, 6)  # one touch: side changes, no penalty
    assert b.side[s] == -1 and b.strength[s] == pytest.approx(1.0) and b.crosses[s] == 0
    b.touch((0, LOW, 7), LOW, 1001, 40, 44, 1.0, A, 980.0, 8)
    b.age_cross(1020.0, 1.0, 9)
    assert b.side[s] == 1 and b.crosses[s] == 1 and b.strength[s] == pytest.approx(2.0 * CROSS_PENALTY)


def _cand(side: int) -> pd.DataFrame:
    # support band 1000..1004 (long) / resistance band 1000..1004 (short); ATR14 10 ticks
    if side == 1:
        o, h, lo, c = 1003.0, 1012.0, 1001.0, 1010.0
    else:
        o, h, lo, c = 1001.0, 1003.0, 992.0, 994.0
    return pd.DataFrame([{"c": 40, "bar": 5, "side": side, "combo": 0, "mid": 1002.0, "lo": 1000.0, "hi": 1004.0,
                          "score": 60.0, "touches": 3, "polar": True, "maxw": 2.0, "strength": 5.0, "crosses": 0,
                          "age": 10, "atr34": 10.0, "atr14": 10.0, "o": o, "h": h, "l": lo, "cl": c}])


def _df() -> pd.DataFrame:
    ts = pd.date_range("2024-12-09 15:00", periods=10, freq="1min", tz="UTC")
    df = pd.DataFrame({"ts": ts, "raw_symbol": "CLF5", "open": 70.0, "high": 70.0, "low": 70.0, "close": 70.0})
    return add_session(df)


@pytest.mark.parametrize("side,entry,stop,target", [
    (1, 1010, 998, 1022),     # long: wick stop min(1001 - 2.5, 1010 - 5) = 998.5 -> floor 998; r1 target 1010 + 12
    (-1, -994, -1006, -982),  # short in side space: stop min(-992 - 2.5, -994 - 5) = -1005.5 -> floor -1006 (1006)
])
def test_order_geometry_close_entry_wick_stop(side, entry, stop, target):
    p = {**Strategy.PARAMS, "clv": 0.6, "score": 0, "entry": "close", "stop": "wick", "exit": "r1"}
    o = build_orders(_cand(side), _df(), p)
    assert (o["E"].iat[0], o["S"].iat[0], o["T"].iat[0]) == (entry, stop, target)


def test_band_entry_and_band_stop_long():
    p = {**Strategy.PARAMS, "clv": 0.6, "score": 0, "entry": "band", "stop": "band", "exit": "r2"}
    o = build_orders(_cand(1), _df(), p)
    # limit at band top 1004; stop min(1000 - 2.5, 1004 - 5) = 997.5 -> 997; risk 7, target 1004 + 14
    assert (o["E"].iat[0], o["S"].iat[0], o["T"].iat[0]) == (1004, 997, 1018)


def test_break_even_ignores_fill_bar_high():
    s = Strategy()
    s._p = {"exit": "be3"}
    hi = np.array([0, 0, 1020, 1005, 1011, 1000], dtype=np.int64)  # fill bar j=2 high 1020 (may predate the fill)
    s._side_hi = {1: hi}
    ctx = Ctx(i=1, j=2, m=3, side=1, E=1000, S=990, T=1030, qty=1, best=1020)
    assert s.manage(ctx) == (990, False)  # only the fill bar seen so far: no BE
    ctx.m = 4
    assert s.manage(ctx) == (990, False)  # bar 3 high 1005 < 1000 + 10
    ctx.m = 5
    assert s.manage(ctx) == (1000, False)  # bar 4 high 1011 >= 1R: stop to entry from bar 5


def _swing_df() -> pd.DataFrame:
    """5m candles: down, swing low at candle 2, up to a swing high at candle 5, then down (locks the low)."""
    lows = [10.0, 9.8, 9.5, 9.7, 9.9, 10.1, 9.9, 9.7, 9.6]
    rows = []
    t0 = pd.Timestamp("2024-12-09 18:00", tz="America/Chicago")
    for k, lo in enumerate(lows):
        hi = lo + 0.3
        for i in range(5):
            rows.append((t0 + pd.Timedelta(minutes=5 * k + i), "CLF5", lo + 0.1, hi if i == 2 else lo + 0.2,
                         lo if i == 3 else lo + 0.1, lo + 0.15))
    df = pd.DataFrame(rows, columns=["ts", "raw_symbol", "open", "high", "low", "close"])
    df["ts"] = df["ts"].dt.tz_convert("UTC")
    return add_session(df)


def test_swing_event_timing_lock_after_confirm():
    df = _swing_df()
    conf = swing_events(df, "5m", "confirm")
    lock = swing_events(df, "5m", "lock")
    low_c = conf[(conf["kind"] == LOW) & (conf["op"] == 1)].iloc[0]
    assert low_c["candle"] == 2 and low_c["known"] == 3 * 5 + 4  # known at the close of candle 3 (its right candle)
    low_l = lock[lock["kind"] == LOW].iloc[0]
    assert low_l["candle"] == 2 and low_l["known"] == 6 * 5 + 4  # locked when the swing high (candle 5) confirms
# Research protocol

Goal: find an intraday CL strategy that passes the Topstep 50K Combine consistently and keeps passing on data it
was not built on. The protocol exists to stop curve-fitting: with enough tries, something always looks good
in-sample.

## Periods (`cltester/config.py`, by CME trading day, end exclusive)

Periods are cut on `trading_day`, never mid-session. Any `test` period that overlaps holdout (`holdout`, `all`)
needs the holdout guard.

| Period | Range | Use |
|---|---|---|
| dev | 2010-06 to 2021-12 | build and tune. Unlimited looks, but every run is logged |
| validation | 2022 to 2024 | frozen parameters, one run per candidate. No tuning after looking |
| holdout | 2025 to 2026-11-12 | once per strategy (the CLI refuses a second run without `--unlock`) |
| forward | after 2026-11-12 | new bars only, then paper/live on TopstepX |

Honesty note: before the 2026-11-12 reset the owner had already researched every year up to 2026. Validation and
holdout are therefore "not used in this repo", not truly unseen. Only **forward** is clean.

## Stages

1. **Hypothesis first.** Before any run, write `docs/strategies/<name>/README.md`: the idea, why CL should behave
   that way, exact entry/exit rules, parameters, the trial budget (how many combinations will be tried) and the pass
   criteria. Template: `docs/strategies/TEMPLATE.md`.
2. **Dev.** `python -m cltester.cli test <name> --period dev`. Tune within the declared budget.
3. **Robustness on dev.** Neighbouring parameters must also be profitable;
   positive in most years; not carried by a few days.
4. **Validation.** Frozen parameters, one run. Record the result whatever it is.
5. **Holdout.** Once. A fail ends the candidate (a new idea is a new strategy, not a retune).
6. **Forward.** New bars and paper trading on TopstepX before real money.

## Proposed gates (owner may change)

| Gate | dev | validation |
|---|---|---|
| Trades | ≥ 200 | ≥ 60 |
| Profit factor (net) | ≥ 1.25 | ≥ 1.10 |
| Years positive | ≥ 70% | — |
| Combine rolling pass rate | ≥ 50% of finished attempts | ≥ 40% |
| Sequential cost per pass | ≤ $500 | ≤ $750 |

## Reporting rules

- Every `test` run appends to `results/ledger.csv` (strategy, code+params hash, period, fills, key stats).
  Never delete ledger rows.
- Every reported number says its period and **in-sample**, and for tuned results **best of N** (N from the ledger).
- Fills follow docs/ENGINE.md (touch fills, no exit slippage). Never call fees "slippage" or slippage "commission".
- A result is not real until the trade list has been spot-checked against raw bars.
"""CL1! 1-minute bars: storage, loading, Chicago session fields, and integer-tick arrays for the engine.

Layout: data/cl1/year=YYYY.parquet, one row per minute, ts = bar open time (UTC), prices in $.
Front month (raw_symbol) = Databento CL.v.0: highest previous-UTC-day volume, switching at 00:00 UTC.
Prices are not back-adjusted: a raw_symbol change is a price jump, so the engine never holds across it.
"""

import os
from dataclasses import dataclass
from datetime import timedelta
from pathlib import Path

import numpy as np
import pandas as pd

from .config import DATA_DIR, EXCHANGE_TZ, PERIODS, SESSION_OPEN, TICK

COLUMNS = ["ts", "raw_symbol", "open", "high", "low", "close", "volume", "vendor"]


def year_path(year: int) -> Path:
    return DATA_DIR / f"year={year}.parquet"


def write_year(df: pd.DataFrame, year: int) -> Path:
    out = df[COLUMNS].sort_values("ts").reset_index(drop=True)
    if not out["ts"].is_unique:
        raise ValueError(f"duplicate bar times in {year}")
    path = year_path(year)
    tmp = path.with_suffix(".parquet.tmp")
    out.to_parquet(tmp, index=False)
    os.replace(tmp, path)  # readers never see a half-written file
    return path


def load_bars(start: str | None = None, end: str | None = None) -> pd.DataFrame:
    """Bars with start <= ts < end (UTC dates or timestamps; end exclusive)."""
    paths = sorted(DATA_DIR.glob("year=*.parquet"))
    if not paths:
        raise FileNotFoundError(f"no bars in {DATA_DIR}")
    lo = pd.Timestamp(start, tz="UTC") if start else None
    hi = pd.Timestamp(end, tz="UTC") if end else None
    hi_year = None if hi is None else (hi - pd.Timedelta(microseconds=1)).year
    keep = [p for p in paths if (lo is None or int(p.stem[5:]) >= lo.year)
            and (hi_year is None or int(p.stem[5:]) <= hi_year)]
    if not keep:
        dtypes = ["datetime64[ns, UTC]", "str", *["float64"] * 4, "int64", "str"]
        return pd.DataFrame({c: pd.Series(dtype=t) for c, t in zip(COLUMNS, dtypes, strict=True)})
    df = pd.concat((pd.read_parquet(p) for p in keep), ignore_index=True)
    if lo is not None:
        df = df[df["ts"] >= lo]
    if hi is not None:
        df = df[df["ts"] < hi]
    return df.sort_values("ts").reset_index(drop=True)


def load_period(name: str) -> pd.DataFrame:
    """Bars whose trading_day lies in [start, end). Periods cut on whole CME trading days, never mid-session."""
    start, end = PERIODS[name]
    pad = pd.Timedelta(days=1)
    # trading day D runs 17:00 CT D-1 to 16:59 CT D, i.e. before 00:00 UTC D+1: only the start needs padding,
    # so a period never reads the next period's year file (dev does not load 2022)
    df = add_session(load_bars(str(pd.Timestamp(start) - pad) if start else None, end))
    keep = np.ones(len(df), dtype=bool)
    if start:
        keep &= df["trading_day"] >= pd.Timestamp(start)
    if end:
        keep &= df["trading_day"] < pd.Timestamp(end)
    return df[keep].reset_index(drop=True)


def add_session(df: pd.DataFrame) -> pd.DataFrame:
    """Add Chicago fields. trading_day = CME/Topstep day: 17:00 CT opens the next day's session
    (Sunday 17:00 CT belongs to Monday)."""
    out = df.copy()
    ct = out["ts"].dt.tz_convert(EXCHANGE_TZ)
    out["ct"] = ct
    out["ct_minute"] = (ct.dt.hour * 60 + ct.dt.minute).astype("int32")
    open_min = SESSION_OPEN.hour * 60 + SESSION_OPEN.minute
    out["sess_minute"] = ((out["ct_minute"] - open_min) % 1440).astype("int32")  # minutes since 17:00 CT
    day = ct.dt.tz_localize(None).dt.normalize()
    out["trading_day"] = day.where(out["ct_minute"] < open_min, day + timedelta(days=1))
    return out


def session_minute(t) -> int:
    """CT clock time -> minutes since the 17:00 CT session open."""
    return (t.hour * 60 + t.minute - SESSION_OPEN.hour * 60 - SESSION_OPEN.minute) % 1440


def to_ticks(prices) -> np.ndarray:
    return np.round(np.asarray(prices, dtype=float) / TICK).astype(np.int64)


@dataclass
class Bars:
    """Arrays the engine runs on. Index i = i-th bar. Prices in integer ticks so comparisons are exact."""

    ts: pd.DatetimeIndex
    o: np.ndarray
    h: np.ndarray
    l: np.ndarray  # noqa: E741
    c: np.ndarray
    sess_minute: np.ndarray  # minutes since 17:00 CT session open
    trading_day: np.ndarray  # datetime64 date of the CME/Topstep trading day
    day_id: np.ndarray  # trading day as an int code
    sym_id: np.ndarray  # raw_symbol as an int code
    last_of_day: np.ndarray  # last bar of its trading day
    last_of_sym: np.ndarray  # last bar before raw_symbol changes


