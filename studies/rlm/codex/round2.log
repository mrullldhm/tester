   144	        self.alive = np.zeros(CAP, dtype=bool)
   145	        self.lastsig = np.full((CAP, n_combo), -1e9)
   146	        self.keys: list[list] = [[] for _ in range(CAP)]  # touch keys owned by each slot
   147	        self.owner: dict = {}  # touch key -> slot
   148	        self.registry: dict = {}  # (kind, price) -> list of [first, last, {tf: w}, key, price, is_high]
   149	        self.pid: dict = {}  # (tf, kind, candle) -> registry entry
   150	        self.added: dict = {}  # touch key -> candle when its touch was added
   151	        self.decay = 0.5 ** (1.0 / HALF_LIFE)
   152	
   153	    def clear(self) -> None:
   154	        self.alive[:] = False
   155	        self.keys = [[] for _ in range(CAP)]
   156	        self.owner.clear()
   157	        self.registry.clear()
   158	        self.pid.clear()
   159	        self.added.clear()
   160	
   161	    def _kill(self, s: int) -> None:
   162	        self.alive[s] = False
   163	        for k in self.keys[s]:
   164	            self.owner.pop(k, None)
   165	        self.keys[s] = []
   166	
   167	    def refit(self, s: int, a: float) -> None:
   168	        m = self.swp[s] / self.sw[s]
   169	        vr = self.swp2[s] / self.sw[s] - m * m
   170	        hw = min(max(np.sqrt(max(vr, 0.0)), a * MIN_HALF_WIDTH_ATR), a * self.tol)
   171	        self.mid[s], self.lo[s], self.hi[s] = m, m - hw, m + hw
   172	
   173	    def _add(self, s: int, price: float, w: float, is_high: bool, a: float, key) -> None:
   174	        self.sw[s] += w
   175	        self.swp[s] += w * price
   176	        self.swp2[s] += w * price * price
   177	        self.strength[s] += w
   178	        self.touches[s] += 1
   179	        self.ht[s] += is_high
   180	        self.lt[s] += not is_high
   181	        self.maxw[s] = max(self.maxw[s], w)
   182	        self.keys[s].append(key)
   183	        self.owner[key] = s
   184	        self.refit(s, a)
   185	
   186	    def _merge(self, t: int, o: int, a: float) -> None:
   187	        for arr in (self.sw, self.swp, self.swp2, self.strength, self.touches, self.ht, self.lt):
   188	            arr[t] += arr[o]
   189	        self.crosses[t] = max(self.crosses[t], self.crosses[o])
   190	        self.first_c[t] = min(self.first_c[t], self.first_c[o])
   191	        self.maxw[t] = max(self.maxw[t], self.maxw[o])
   192	        self.lastsig[t] = np.maximum(self.lastsig[t], self.lastsig[o])
   193	        for k in self.keys[o]:
   194	            self.owner[k] = t
   195	        self.keys[t].extend(self.keys[o])
   196	        self.keys[o] = []
   197	        self.alive[o] = False
   198	        self.refit(t, a)
   199	
   200	    def _shift(self, s: int, dw: float, price: float, age: int = 0) -> None:
   201	        """Change one touch's weight by dw on slot s. A removal (dw < 0) takes back its strength share decayed over
   202	        `age` bars (cross penalties since then are ignored)."""
   203	        self.sw[s] += dw
   204	        self.swp[s] += dw * price
   205	        self.swp2[s] += dw * price * price
   206	        self.strength[s] = max(self.strength[s] + dw * self.decay ** age, 0.0)
   207	
   208	    def touch(self, pid: tuple, kind: int, price: int, first: int, last: int, w: float, a: float, close: float,
   209	              c: int) -> None:
   210	        """Register a swing point (pid = (tf, kind, candle)). Same extreme already known on another TF (same kind
   211	        and price, one candle inside the other): the touch takes the larger weight, no extra touch."""
   212	        reg = self.registry.setdefault((kind, price), [])
   213	        for e in reg:
   214	            if (first <= e[0] and e[1] <= last) or (e[0] <= first and last <= e[1]):
   215	                old = max(e[2].values()) if e[2] else 0.0
   216	                e[2][pid[0]] = w
   217	                self.pid[pid] = e
   218	                s = self.owner.get(e[3])
   219	                if s is not None and self.alive[s]:
   220	                    if w > old:
   221	                        self._shift(s, w - old, price)
   222	                        self.maxw[s] = max(self.maxw[s], w)
   223	                        self.refit(s, a)
   224	                        self._merge_overlaps(s, a)
   225	                    return
   226	                if old > 0:
   227	                    return  # its level is gone (decayed / evicted): a later TF of the same extreme adds nothing
   228	                break
   229	        else:
   230	            e = [first, last, {pid[0]: w}, (kind, price, first), price, kind == HIGH]
   231	            reg.append(e)
   232	            self.pid[pid] = e
   233	        key = e[3]
   234	        is_high = kind == HIGH
   235	        alive = np.flatnonzero(self.alive)
   236	        t = -1
   237	        if len(alive):
   238	            d = np.abs(self.mid[alive] - price)
   239	            ok = np.flatnonzero(d <= a * self.tol)
   240	            if len(ok):
   241	                best = d[ok].min()
   242	                t = int(alive[ok[np.flatnonzero(d[ok] == best)[-1]]])  # ties: the later level (Pine `<=`)
   243	        if t >= 0:
   244	            self._add(t, price, w, is_high, a, key)
   245	            self._merge_overlaps(t, a)
   246	        else:
   247	            s = int(np.flatnonzero(~self.alive)[0])
   248	            for arr in (self.sw, self.swp, self.swp2, self.strength, self.touches, self.ht, self.lt, self.crosses,
   249	                        self.maxw):
   250	                arr[s] = 0.0
   251	            self.lastsig[s] = -1e9
   252	            self.keys[s] = []
   253	            self.side[s] = 1 if close > price else -1
   254	            self.sidebar[s] = c
   255	            self.first_c[s] = c
   256	            self.alive[s] = True
   257	            self._add(s, price, w, is_high, a, key)
   258	        self.added[key] = c
   259	        while self.alive.sum() > MAX_LEVELS:
   260	            al = np.flatnonzero(self.alive)
   261	            self._kill(int(al[np.argmin(self.strength[al])]))
   262	
   263	    def withdraw(self, pid: tuple, a: float, c: int) -> None:
   264	        """confirm mode: a point left the owner structure. Its TF's weight leaves the touch (the touch drops to the
   265	        next TF that still holds the same extreme, or goes away). History is not rewritten."""
   266	        e = self.pid.pop(pid, None)
   267	        if e is None or pid[0] not in e[2]:
   268	            return
   269	        old = max(e[2].values())
   270	        del e[2][pid[0]]
   271	        new = max(e[2].values()) if e[2] else 0.0
   272	        s = self.owner.get(e[3])
   273	        if s is None or not self.alive[s] or new >= old:
   274	            return
   275	        self._shift(s, new - old, e[4], c - self.added.get(e[3], c))
   276	        if new == 0.0:
   277	            self.touches[s] -= 1
   278	            self.ht[s] -= e[5]
   279	            self.lt[s] -= not e[5]
   280	            self.keys[s].remove(e[3])
   281	            self.owner.pop(e[3], None)
   282	            self.registry[(e[3][0], e[3][1])].remove(e)
   283	        if self.touches[s] <= 0 or self.sw[s] <= 1e-9:
   284	            self._kill(s)
   285	        else:
   286	            self.refit(s, a)
   287	
   288	    def _merge_overlaps(self, t: int, a: float) -> None:
   289	        for _ in range(MERGE_PASSES):
   290	            again = False
   291	            for k in np.flatnonzero(self.alive)[::-1]:
   292	                if k != t and self.alive[k] and self.lo[k] <= self.hi[t] and self.lo[t] <= self.hi[k]:
   293	                    self._merge(t, int(k), a)
   294	                    again = True
   295	            if not again:
   296	                break
   297	
   298	    def age_cross(self, close: float, decay: float, c: int) -> None:
   299	        al = self.alive
   300	        self.strength[al] *= decay
   301	        new = np.where(close > self.hi, 1.0, np.where(close < self.lo, -1.0, self.side))
   302	        ch = al & (new != self.side)
   303	        hit = ch & (self.touches >= MIN_TOUCHES)
   304	        self.crosses[hit] += 1
   305	        self.strength[hit] *= CROSS_PENALTY
   306	        self.side[ch] = new[ch]
   307	        self.sidebar[ch] = c
   308	        for s in np.flatnonzero(al & (self.strength < MIN_STRENGTH)):
   309	            self._kill(int(s))
   310	
   311	    def score(self, s) -> np.ndarray:
   312	        polar = (self.ht[s] > 0) & (self.lt[s] > 0)
   313	        return 100.0 * (1.0 - np.exp(-self.strength[s] * np.where(polar, POLARITY_BONUS, 1.0) / SCORE_SCALE))
   314	
   315	    def nearest(self, side: int, close: float) -> np.ndarray:
   316	        cand = np.flatnonzero(self.alive & (self.touches >= MIN_TOUCHES) & (self.side == side))
   317	        if not len(cand):
   318	            return cand
   319	        order = np.argsort(np.abs(close - self.mid[cand]), kind="stable")
   320	        return cand[order[:PER_SIDE]]
   321	
   322	
   323	def candidates(df: pd.DataFrame, sig_tf: str, reg: str, sources: str, weight: str, tol: float) -> pd.DataFrame:
   324	    """Every rejection signal of the level engine, for all COMBOS at once (one row per candle, side and combo)."""
   325	    key = _content_key(df)
   326	    ck = (key, sig_tf, reg, sources, weight, tol)
   327	    if ck in _CANDS:
   328	        return _CANDS[ck]
   329	    cd = build_candles(df, sig_tf)
   330	    n_c = len(cd)
   331	    m_sig = TIMEFRAMES[sig_tf]
   332	    tfs = [t for t in SOURCES if (TIMEFRAMES[t] >= m_sig if sources == "all" else TIMEFRAMES[t] > m_sig)]
   333	    ev = pd.concat([swing_events(df, t, reg, key).assign(tf=i, w=TF_WEIGHT[t] if weight == "tf" else 1.0)
   334	                    for i, t in enumerate(tfs)], ignore_index=True)
   335	    ev = ev.sort_values(["known", "tf", "op"], kind="stable")  # same bar: lower TF first, withdrawals first
   336	    lk = ev[["known", "op", "kind", "price", "first", "last", "ref_first", "candle", "tf", "w"]].to_numpy()
   337	    lk_known = ev["known"].to_numpy()
   338	    h, lo, cl, opn = (cd.h.astype(float), cd.l.astype(float), cd.c.astype(float), cd.o.astype(float))
   339	    sym = pd.factorize(df["raw_symbol"])[0]
   340	    contract = np.cumsum(np.r_[False, sym[1:] != sym[:-1]])
   341	    c_contract = contract[cd.last]
   342	    a34, a14 = np.full(n_c, np.nan), np.full(n_c, np.nan)  # ATR restarts with each contract (no roll gap in TR)
   343	    for g in np.split(np.arange(n_c), np.flatnonzero(np.diff(c_contract)) + 1):
   344	        if len(g):
   345	            a34[g] = atr_rma(h[g], lo[g], cl[g], STRUCT_ATR_LEN).to_numpy()
   346	            a14[g] = atr_rma(h[g], lo[g], cl[g], RISK_ATR_LEN).to_numpy()
   347	    c_start = np.r_[0, np.flatnonzero(np.diff(contract)) + 1][contract[cd.first]]  # 1m bar where its contract began
   348	    tday = pd.factorize(df["trading_day"])[0]
   349	    decay = 0.5 ** (1.0 / HALF_LIFE)
   350	    book = Book(len(COMBOS), tol)
   351	    rows = []
   352	    p = 0  # next lock to register
   353	    for c in range(n_c):
   354	        if c and c_contract[c] != c_contract[c - 1]:
   355	            book.clear()
   356	        av = int(cd.avail[c])
   357	        close = cl[c]
   358	        a = a34[c] if np.isfinite(a34[c]) else 0.0
   359	        if a > 0:
   360	            book.age_cross(close, decay, c)
   361	        while p < len(lk_known) and lk_known[p] <= av:
   362	            kn, op, kind, price, first, last, ref_first, cnd, tfi, w = lk[p]
   363	            p += 1
   364	            pid = (int(tfi), int(kind), int(cnd))
   365	            if op < 0:
   366	                book.withdraw(pid, a, c)
   367	                continue
   368	            # the extreme and its left reference candle must be in the current contract (unadjusted prices)
   369	            if a <= 0 or ref_first < c_start[c] or contract[int(kn)] != c_contract[c]:
   370	                continue
   371	            book.touch(pid, int(kind), int(price), int(first), int(last), float(w), a, close, c)
   372	        # no signal from a candle that straddles a roll or completes in the next session (missing last minute)
   373	        if a <= 0 or cd.first[c] < c_start[c] or not np.isfinite(a14[c]) \
   374	                or tday[cd.first[c]] != tday[av]:
   375	            continue
   376	        rng = h[c] - lo[c]
   377	        for side in (1, -1):
   378	            sel = book.nearest(side, close)
   379	            if not len(sel):
   380	                continue
   381	            if side == 1:
   382	                clv = (close - lo[c]) / rng if rng > 0 else 0.5
   383	                geo = (book.sidebar[sel] < c) & (lo[c] <= book.hi[sel]) & (close > book.hi[sel])
   384	            else:
   385	                clv = (h[c] - close) / rng if rng > 0 else 0.5
   386	                geo = (book.sidebar[sel] < c) & (h[c] >= book.lo[sel]) & (close < book.lo[sel])
   387	            if not geo.any():
   388	                continue
   389	            sc = book.score(sel)
   390	            for ci, (cmin, smin) in enumerate(COMBOS):
   391	                if clv < cmin:
   392	                    continue
   393	                ok = geo & (sc >= smin) & (c - book.lastsig[sel, ci] >= COOLDOWN)
   394	                hit = np.flatnonzero(ok)
   395	                if not len(hit):
   396	                    continue
   397	                s = int(sel[hit[0]])
   398	                book.lastsig[s, ci] = c
   399	                rows.append((c, av, side, ci, book.mid[s], book.lo[s], book.hi[s], float(sc[hit[0]]),
   400	                             book.touches[s], bool(book.ht[s] > 0 and book.lt[s] > 0), book.maxw[s],
   401	                             book.strength[s], book.crosses[s], c - book.first_c[s], a, a14[c], opn[c], h[c], lo[c],
   402	                             close))
   403	    out = pd.DataFrame(rows, columns=CAND_COLS)
   404	    out["sig_tf"] = sig_tf
   405	    _CANDS[ck] = out
   406	    return out
