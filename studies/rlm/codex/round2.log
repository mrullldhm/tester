   409	def build_orders(cand: pd.DataFrame, df: pd.DataFrame, p: dict) -> pd.DataFrame:
   410	    """Orders (ticks, side space resolved) from the candidates of one combo. One row per signal bar; a long and a
   411	    short on one candle: long only (original). Columns include features for the trade study."""
   412	    ci = COMBOS.index((float(p["clv"]), int(p["score"])))
   413	    s = cand[cand["combo"] == ci].copy()
   414	    if s.empty:
   415	        return s
   416	    s = s.sort_values(["bar", "side"], ascending=[True, False], kind="stable").drop_duplicates("bar", keep="first")
   417	    ctm = df["ct_minute"].to_numpy()[s["bar"].to_numpy()]
   418	    s["ct_min"] = ctm
   419	    if p["session"] == "rth":
   420	        s = s[(s["ct_min"] >= RTH[0]) & (s["ct_min"] < RTH[1])]
   421	    side = s["side"].to_numpy()
   422	    # side space: long as is, short negated
   423	    cl, lo_c = (side * s["cl"]).to_numpy(), np.where(side == 1, s["l"], -s["h"])
   424	    lvl_near = np.where(side == 1, s["hi"], -s["lo"])  # band edge price came back to
   425	    lvl_far = np.where(side == 1, s["lo"], -s["hi"])
   426	    a14 = s["atr14"].to_numpy()
   427	    entry = np.where(p["entry"] == "close", cl, np.floor(lvl_near)).astype(float)
   428	    if p["stop"] == "wick":
   429	        raw = np.minimum(lo_c - WICK_BUFFER_ATR * a14, entry - WICK_MIN_ATR * a14)
   430	    else:
   431	        raw = np.minimum(lvl_far - WICK_BUFFER_ATR * a14, entry - WICK_MIN_ATR * a14)
   432	    stop = np.floor(raw)
   433	    risk = entry - stop
   434	    k = {"r1": 1, "r2": 2, "r3": 3, "be3": 3, "be3opp": 3}[p["exit"]]
   435	    target = entry + np.ceil(k * risk)
   436	    s = s.assign(E=entry, S=stop, R=risk, T=target)
   437	    return s[s["R"] >= MIN_RISK]
   438	
