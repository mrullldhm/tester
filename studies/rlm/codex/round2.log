   140	            continue
   141	        side, qty, pq = int(sides[r]), int(qtys[r]), int(pqtys[r])
   142	        cancel_at = n  # overlap: the next accepted signal's bar; this order works through it at most
   143	        if overlap:
   144	            held = [t for t in held if t[1] > i]
   145	            if _open_qty(held, i) + qty > max_contracts:
   146	                continue
   147	            for r2 in range(r + 1, len(sig_bars)):
   148	                if sig_bars[r2] + 1 < n and _open_qty(held, sig_bars[r2]) + qtys[r2] <= max_contracts:
   149	                    cancel_at = int(sig_bars[r2])
   150	                    break
   151	        elif i < next_free:
   152	            continue
   153	        o, h, l, c = views[side]
   154	        L, S = side * lim[r], side * stp[r]
   155	        T = None if np.isnan(tgt[r]) else side * tgt_t[r]
   156	        P = side * ptg_t[r] if pq > 0 else None
   157	        V = None if np.isnan(void[r]) else side * void_t[r]
   158	        if V is not None and V > L:
   159	            raise ValueError(f"signal at bar {i}: void must be at or beyond the limit on the losing side")
   160	        K = None if np.isnan(kill[r]) else side * kill_t[r]
   161	        if K is not None and K <= L:
   162	            raise ValueError(f"signal at bar {i}: kill must be beyond the limit on the winning side")
   163	        if S >= L or (T is not None and T <= L) or (P is not None and (P <= L or (T is not None and P > T))):
   164	            raise ValueError(f"signal at bar {i}: stop must be on the losing side and targets on the winning side")
   165	        hold = None if np.isnan(holds[r]) else int(holds[r])
   166	        day, sym = bars.day_id[i], bars.sym_id[i]
   167	        # --- working entry order: bars i+1 .. i+expire ---
   168	        entry_bar, last_active, voided = -1, i, -1
   169	        timed = not np.isnan(expire_min[r])
   170	        deadline = minute[i] + 1 + int(expire_min[r]) if timed else 0  # first minute the order no longer works
   171	        for j in range(i + 1, n if timed else min(n, i + 1 + int(expires[r]))):
   172	            if bars.day_id[j] != day or bars.sym_id[j] != sym or bars.sess_minute[j] >= flat:
   173	                break
   174	            if (timed and minute[j] >= deadline) or j > cancel_at:
   175	                break
   176	            F = L - fills.through  # a touch fills (owner rule); `through` asks for a trade beyond the limit
   177	            if V is not None and o[j] < V:  # opened beyond the void: cancelled before any fill
   178	                voided = j
   179	                break
   180	            if l[j] <= F:
   181	                # From the open price falls through F before V - 1 (the void break) unless V - 1 >= F: then the
   182	                # void breaks first (same price: order unknown, cancelled).
   183	                if V is None or o[j] <= F or F >= V:
   184	                    if K is not None and o[j] > F and h[j] >= K:  # fill level and kill in one bar: order unknown
   185	                        voided = j
   186	                        break
   187	                    entry_bar, E = j, min(o[j], L)
   188	                    break
   189	                voided = j
   190	                break
   191	            if V is not None and l[j] < V:  # void broken without reaching the fill level: cancelled
   192	                voided = j
   193	                break
   194	            if K is not None and h[j] >= K:  # kill touched before any fill: cancelled
   195	                voided = j
   196	                break
   197	            last_active = j
   198	        if entry_bar < 0:
   199	            if voided >= 0:  # the order worked into bar j until the void or kill cancelled it: free from j's close
   200	                next_free = voided
   201	                continue
   202	            next_free = last_active
   203	            if timed and last_active + 1 < n and minute[last_active + 1] >= deadline \
   204	                    and minute[last_active] + 1 < deadline:
   205	                next_free = last_active + 1  # a gap spans the deadline: the order still worked at last_active's close
   206	            continue
   207	        # --- position: per held bar, the open and worst price feed the Combine path check ---
   208	        j = entry_bar
   209	        X, reason = None, ""
   210	        rem, realized, PX, PB = qty, 0, None, -1  # contracts open, side-space ticks*contracts booked by the partial
   211	        p_open, p_worst = [0], [(l[j] - E) * qty]
   212	        best = h[j]
   213	        best_pnl = (h[j] - E) * qty  # best open P&L (ticks x contracts) for mfe
   214	        ctx = Ctx(i=int(i), j=j, m=j, side=side, E=int(E), S=int(S), T=None if T is None else int(T),
   215	                  qty=rem, best=int(best)) if manage is not None else None
   216	        if l[j] <= S:  # stop on the fill bar: assume it came after the fill
   217	            X, reason = min(E, S), "stop"
   218	            p_worst[0] = (X - E) * qty  # the bar low before the fill is not part of the trade
   219	        m = j
   220	        while X is None:
   221	            if m > j:
   222	                close_now = False
   223	                if manage is not None and ctx is not None:
   224	                    ctx.m, ctx.S, ctx.qty, ctx.best = m, int(S), rem, int(best)
   225	                    new_s, close_now = manage(ctx)
   226	                    S = _check_stop(new_s, i)
   227	                real0, rem0 = realized, rem  # booked P&L and contracts at the bar's open
   228	                part_at_open = False
   229	                if bars.sess_minute[m] >= flat:
   230	                    X, reason = o[m], "flatten"
   231	                elif close_now:
   232	                    X, reason = o[m], "manage"
   233	                elif o[m] <= S:
   234	                    X, reason = o[m], "stop"
   235	                elif T is not None and o[m] >= T:
   236	                    X, reason = o[m], "target"
   237	                else:
   238	                    if P is not None and PX is None and o[m] >= P:  # partial at the open (gap in our favour)
   239	                        PX, PB, realized, rem = o[m], m, realized + (o[m] - E) * pq, rem - pq
   240	                        part_at_open = True
   241	                    if l[m] <= S:
   242	                        X, reason = S, "stop"  # stop and any target in one bar: stop first
   243	                    else:
   244	                        if P is not None and PX is None and h[m] >= P:
   245	                            PX, PB, realized, rem = P, m, realized + (P - E) * pq, rem - pq
   246	                            best_pnl = max(best_pnl, realized + (P - E) * rem)
   247	                        if T is not None and h[m] >= T:
   248	                            X, reason = T, "target"
   249	                p_open.append(real0 + (o[m] - E) * rem0)
   250	                if X is not None and X == o[m]:
   251	                    p_worst.append(real0 + (X - E) * rem0)  # exit at the open: nothing after it counts
   252	                    best = max(best, X)
   253	                    best_pnl = max(best_pnl, real0 + (X - E) * rem0)
   254	                    break
   255	                if reason == "stop":
   256	                    p_worst.append(realized + (S - E) * rem)
   257	                elif part_at_open:  # the open comes first, so the low counts only for what is left
   258	                    p_worst.append(realized + (l[m] - E) * rem)
   259	                else:  # order inside the bar unknown: the low counts with the contracts held at the bar's open
   260	                    p_worst.append(real0 + (l[m] - E) * rem0)
   261	                if X is None or reason == "target":
   262	                    best = max(best, h[m])
   263	                    best_pnl = max(best_pnl, realized + (h[m] - E) * rem)
   264	                if X is not None:
   265	                    break
   266	            if m == n - 1:
   267	                X, reason = c[m], "data_end"
   268	            elif hold is not None and m - j >= hold:
   269	                X, reason = c[m], "time"
   270	            elif bars.last_of_sym[m]:
   271	                X, reason = c[m], "roll"
   272	            elif bars.last_of_day[m]:
   273	                X, reason = c[m], "day_end"
   274	            else:
   275	                m += 1
   276	        exit_bar = m
   277	        p_worst[-1] = min(p_worst[-1], realized + (X - E) * rem)
   278	        best_pnl = max(best_pnl, realized + (X - E) * rem)
   279	        fee = fills.fee * qty
   280	        total = realized + (X - E) * rem  # side-space ticks x contracts
   281	        path = (np.array(p_open, dtype=float) * TICK_VALUE - fee, np.array(p_worst, dtype=float) * TICK_VALUE - fee)
   282	        rows.append((i, entry_bar, exit_bar, bars.ts[entry_bar], bars.ts[exit_bar], bars.trading_day[entry_bar], side,
   283	                     qty, side * E * TICK, side * X * TICK, reason, int(X - E),
   284	                     np.nan if PX is None else side * PX * TICK, PB, 0 if PX is None else pq,
   285	                     total * TICK_VALUE, fee, total * TICK_VALUE - fee,
   286	                     float(path[1].min()), best_pnl * TICK_VALUE - fee, path))
   287	        next_free = exit_bar
   288	        if overlap:
   289	            held.append((entry_bar, exit_bar, qty, PB, 0 if PX is None else pq))
   290	    out = pd.DataFrame(rows, columns=TRADE_COLUMNS)
   291	    for col in ("entry", "exit", "part_exit"):
   292	        out[col] = out[col].astype(float).round(2)
   293	    return out
