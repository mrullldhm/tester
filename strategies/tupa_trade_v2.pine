// Tupa Trade v2 (owner strategy + interpretation switches) - Pine twin of strategies/tupa_trade_v2.py. Spec: docs/strategies/tupa_trade/README.md
// (sections 3b, 3c). Same properties, swings, bias and orders as the Python tester, bar by bar
// (tests/tupa_v2_literal.py is the line-for-line Python transcription of this script).
// Use on NYMEX:CL1!, 1-minute chart, Deep Backtesting for long ranges. CL only.
//
// Short side (long = mirror):
// - Swings: owner rule (indicators/structure_swings.pine). Higher timeframes 5m / 15m / 1H / 4H (anchored 18:00 New
//   York) / daily (CME day from 18:00 New York) are built from the 1m bars here, closed candles only. No
//   request.security, so the twin does not depend on its historical timing.
// - Trend per timeframe: down when the current swing low, labelled HL, is touched by a closed candle; up when the
//   current swing high, labelled LH, is touched.
// - Bias short: T = lowest timeframe from "Lowest tested timeframe" up to daily whose newest swing is a swing low;
//   every timeframe below T (down to 5m) in downtrend.
// - Entry: newest 1m swing is a swing high, the swing low before it is a HL not touched since. Sell stop-limit:
//   stop = that HL, limit = HL or (stop loss - max risk) when the stop loss is further than max risk.
//   Stop loss = the 1m swing high, take profit = TP ticks from the fill.
// - Before its trigger the order follows the setup each bar; after the trigger it stays until filled or the next
//   1m swing high is confirmed. New York 09:00-14:30 only, one trade per session, closed at the session end.
// Feature-2 interpretation switches (docs/strategies/tupa_trade_v2/optimize/README.md; first option = v1):
// T rule lowest/highest, trend sticky/fresh, touched break point skip/retest, order follow/freeze, TP expiry on/off.
// Not in the twin: the tester's roll exit (a position open on a contract's last bar closes at its close). Trades
// are intraday inside 09:00-14:30 New York and never cross the 00:00 UTC roll switch.
//@version=6
strategy("Tupa Trade v2 CL1! (tvtester twin)", overlay = true, initial_capital = 50000,
     default_qty_type = strategy.fixed, default_qty_value = 1,
     commission_type = strategy.commission.cash_per_contract, commission_value = 2.01, slippage = 0,
     pyramiding = 0, margin_long = 0, margin_short = 0, calc_on_every_tick = false, calc_on_order_fills = false,
     process_orders_on_close = false, backtest_fill_limits_assumption = 0, use_bar_magnifier = false)

string tMinInput = input.string("1h", "Lowest tested timeframe T", options = ["15m", "1h", "4h", "1d"])
int tpTicks = input.int(25, "Take profit (ticks from fill)", minval = 1)
int maxRisk = input.int(25, "Max risk (ticks, limit moves toward the stop loss)", minval = 1)
string tRule = input.string("lowest", "T rule (timeframe with a candidate swing)", options = ["lowest", "highest"])
string trendMode = input.string("sticky", "Trend (fresh: cleared by the next opposite swing)", options = ["sticky", "fresh"])
string touchedMode = input.string("skip", "Break point already touched", options = ["skip", "retest"])
string orderMode = input.string("follow", "Order before trigger", options = ["follow", "freeze"])
string tpExpiry = input.string("on", "Cancel unfilled order at planned TP", options = ["on", "off"])

const string NY = "America/New_York"
const int SH = 1
const int SL = -1
const int OPEN_MIN = 9 * 60
const int FLAT_MIN = 14 * 60 + 30
int k0 = tMinInput == "15m" ? 1 : tMinInput == "1h" ? 2 : tMinInput == "4h" ? 3 : 4

if not (timeframe.isminutes and timeframe.multiplier == 1)
    runtime.error("Use a 1-minute chart.")

// Broker-emulator path: high first when the high is nearer the open (tie -> low first)
openRule(float o, float h, float l) =>
    (h - o) < (o - l)

// Candle id of a bar open time. tf: 0 5m, 1 15m, 2 1H, 3 4H, 4 daily
candleId(int t, int tf) =>
    int m = hour(t, NY) * 60 + minute(t, NY)
    int td = t + 6 * 3600000
    int day = year(td, NY) * 10000 + month(td, NY) * 100 + dayofmonth(td, NY)
    int res = 0
    if tf == 0
        res := int(math.floor(t / 300000))
    else if tf == 1
        res := int(math.floor(t / 900000))
    else if tf == 2
        res := int(math.floor(t / 3600000))
    else if tf == 3
        res := day * 10 + int(math.floor(((m + 360) % 1440) / 240))
    else
        res := day
    res

// Id of the minute after the bar. No halt special case: the day's last 4H and daily candles run to 18:00 and close
// on the next session's first bar; bars inside the 17:00-18:00 halt (2010 data) stay in that candle (R19)
nextId(int t, int tf) =>
    candleId(t + 60000, tf)

type Zig
    int lastType = 0
    float lastPrice
    float curH
    float prevH
    float curL
    float prevL
    float hiSinceL
    float loSinceH
    int nH = 0
    int nL = 0
    bool pending = false
    float minSinceL
    float maxSinceH
    float savedMinSinceL
    float savedMaxSinceH
    int savedLastType = 0
    float savedLastPrice
    float savedCurH
    float savedPrevH
    float savedCurL
    float savedPrevL
    float savedHiSinceL
    float savedLoSinceH


// Only the newest endpoint is provisional. At a close, accept qualifying opposite pivots before touch removal.
method remember(Zig z) =>
    z.savedMinSinceL := z.minSinceL
    z.savedMaxSinceH := z.maxSinceH
    z.savedLastType := z.lastType
    z.savedLastPrice := z.lastPrice
    z.savedCurH := z.curH
    z.savedPrevH := z.prevH
    z.savedCurL := z.curL
    z.savedPrevL := z.prevL
    z.savedHiSinceL := z.hiSinceL
    z.savedLoSinceH := z.loSinceH
    z

method invalidate(Zig z, float h, float l) =>
    if not na(z.minSinceL)
        z.minSinceL := math.min(z.minSinceL, l)
    if not na(z.maxSinceH)
        z.maxSinceH := math.max(z.maxSinceH, h)
    if z.pending
        if not na(z.savedMinSinceL)
            z.savedMinSinceL := math.min(z.savedMinSinceL, l)
        if not na(z.savedMaxSinceH)
            z.savedMaxSinceH := math.max(z.savedMaxSinceH, h)
    bool removed = z.pending and (z.lastType == SH ? h >= z.lastPrice : l <= z.lastPrice)
    if removed
        float observedH = z.hiSinceL
        float observedL = z.loSinceH
        if z.lastType == SH
            z.nH += 1
        else
            z.nL += 1
        z.lastType := z.savedLastType
        z.lastPrice := z.savedLastPrice
        z.curH := z.savedCurH
        z.prevH := z.savedPrevH
        z.curL := z.savedCurL
        z.prevL := z.savedPrevL
        z.hiSinceL := z.savedHiSinceL
        z.loSinceH := z.savedLoSinceH
        z.pending := false
        z.minSinceL := z.savedMinSinceL
        z.maxSinceH := z.savedMaxSinceH
        if not na(observedH)
            z.hiSinceL := na(z.hiSinceL) ? observedH : math.max(z.hiSinceL, observedH)
        if not na(observedL)
            z.loSinceH := na(z.loSinceH) ? observedL : math.min(z.loSinceH, observedL)
        if not na(z.hiSinceL)
            z.hiSinceL := math.max(z.hiSinceL, h)
        if not na(z.loSinceH)
            z.loSinceH := math.min(z.loSinceH, l)
    removed

// Owner indicator push: same type replaces when at least as extreme (equal: the later), else dropped
method push(Zig z, int t, float p) =>
    bool added = true
    bool accepts = z.lastType != t or (t == SH ? p >= z.lastPrice : p <= z.lastPrice)
    if accepts
        if z.lastType != t or not z.pending
            z.remember()
        z.pending := true
    if z.lastType == t
        added := t == SH ? p >= z.lastPrice : p <= z.lastPrice
        if added
            z.lastPrice := p
            if t == SH
                z.curH := p
                z.nH += 1
            else
                z.curL := p
                z.nL += 1
    else
        if t == SH
            z.prevH := z.curH
            z.curH := p
            z.nH += 1
        else
            z.prevL := z.curL
            z.curL := p
            z.nL += 1
        z.lastType := t
        z.lastPrice := p
    added

// Owner clarification, 2026-11-05: observe every candle, accept only leg-extreme fixed-rule pivots.
method visit(Zig z, int t, float p, bool isPivot) =>
    bool extreme = t == SH ? (na(z.hiSinceL) or p >= z.hiSinceL) : (na(z.loSinceH) or p <= z.loSinceH)
    bool added = false
    if isPivot and extreme
        added := z.push(t, p)
        if added
            if t == SH
                z.loSinceH := p
            else
                z.hiSinceL := p
    if z.pending
        if t == SH and not na(z.savedHiSinceL)
            z.savedHiSinceL := math.max(z.savedHiSinceL, p)
        if t == SL and not na(z.savedLoSinceH)
            z.savedLoSinceH := math.min(z.savedLoSinceH, p)
    if t == SH and not na(z.hiSinceL)
        z.hiSinceL := math.max(z.hiSinceL, p)
    if t == SL and not na(z.loSinceH)
        z.loSinceH := math.min(z.loSinceH, p)
    added

method isHL(Zig z) =>
    not na(z.prevL) and z.curL > z.prevL

method isLH(Zig z) =>
    not na(z.prevH) and z.curH < z.prevH

type Tf
    int id = na
    float h
    float l
    int hiI
    int loI
    bool sameHf = false
    int fd = na
    int fu = na
    bool tieHf = false
    float h1
    float l1
    float h2
    float l2
    bool f2 = false
    float h3
    float l3
    bool f3 = false
    int nBuf = 0
    Zig z
    Zig opening
    int trend = 0
    bool dnUsed = false
    bool upUsed = false
    int fresh = 0
    int freshC = -1
    int nc = 0

method touch(Tf f) =>
    float dn = f.z.isHL() and not f.dnUsed ? f.z.curL : na
    float up = f.z.isLH() and not f.upUsed ? f.z.curH : na
    bool newD = na(f.fd) and not na(dn) and low <= dn
    bool newU = na(f.fu) and not na(up) and high >= up
    if newD
        f.fd := bar_index
    if newU
        f.fu := bar_index
    if newD and newU
        f.tieHf := openRule(open, high, low)
    f

method begin(Tf f, int cid) =>
    f.opening := f.z.copy()
    f.id := cid
    f.h := high
    f.l := low
    f.hiI := bar_index
    f.loI := bar_index
    f.sameHf := openRule(open, high, low)
    f.fd := na
    f.fu := na
    f.tieHf := false
    f.touch()

method add(Tf f) =>
    if high > f.h
        f.h := high
        f.hiI := bar_index
    if low < f.l
        f.l := low
        f.loI := bar_index
    if f.hiI == bar_index and f.loI == bar_index
        f.sameHf := openRule(open, high, low)
    f.touch()

// Candle closed: trend touches first, then the swing at the middle of the last three closed candles
method closeCandle(Tf f) =>
    bool hf = f.hiI < f.loI ? true : f.hiI > f.loI ? false : f.sameHf
    if not na(f.fd) and not na(f.fu)
        bool upLast = f.fd == f.fu ? not f.tieHf : f.fu > f.fd
        f.trend := upLast ? 1 : -1
        f.dnUsed := true
        f.upUsed := true
    else if not na(f.fd)
        f.trend := -1
        f.dnUsed := true
    else if not na(f.fu)
        f.trend := 1
        f.upUsed := true
    if not na(f.fd) or not na(f.fu)
        f.fresh := f.trend
        f.freshC := f.nc
    f.h1 := f.h2
    f.l1 := f.l2
    f.h2 := f.h3
    f.l2 := f.l3
    f.f2 := f.f3
    f.h3 := f.h
    f.l3 := f.l
    f.f3 := hf
    f.nBuf := math.min(f.nBuf + 1, 3)
    if f.nBuf == 3 and not na(f.opening) and f.opening.pending and not f.z.pending
        Zig probe = f.opening.copy()
        bool ph = f.h1 <= f.h2 and f.h3 < f.h2
        bool pl = f.l1 >= f.l2 and f.l3 > f.l2
        bool a = false
        bool b = false
        if f.f2
            a := probe.visit(SH, f.h2, ph)
            b := probe.visit(SL, f.l2, pl)
        else
            b := probe.visit(SL, f.l2, pl)
            a := probe.visit(SH, f.h2, ph)
        if a or b
            int nh = f.z.nH
            int nl = f.z.nL
            f.z := f.opening.copy()
            f.z.nH := nh
            f.z.nL := nl
    if f.nBuf == 3
        bool isH = f.h1 <= f.h2 and f.h3 < f.h2
        bool isL = f.l1 >= f.l2 and f.l3 > f.l2
        bool later = f.nc - 1 > f.freshC
        if f.f2
            if f.z.visit(SH, f.h2, isH)
                f.upUsed := false
                if later and f.fresh == -1
                    f.fresh := 0
            if f.z.visit(SL, f.l2, isL)
                f.dnUsed := false
                if later and f.fresh == 1
                    f.fresh := 0
        else
            if f.z.visit(SL, f.l2, isL)
                f.dnUsed := false
                if later and f.fresh == 1
                    f.fresh := 0
            if f.z.visit(SH, f.h2, isH)
                f.upUsed := false
                if later and f.fresh == -1
                    f.fresh := 0
    f.nc += 1
    f.id := na
    f

method feed(Tf f, int tf) =>
    int c = candleId(time, tf)
    int cn = nextId(time, tf)
    if not na(f.id) and c != f.id
        f.closeCandle()  // previous candle missed its last minute: closed now
    if na(f.id)
        f.begin(c)
    else
        f.add()
    if cn != c
        f.closeCandle()
    f.z.invalidate(high, low)
    f

var array<Tf> tfs = array.from(Tf.new(z = Zig.new()), Tf.new(z = Zig.new()), Tf.new(z = Zig.new()),
     Tf.new(z = Zig.new()), Tf.new(z = Zig.new()))
for k = 0 to 4
    tfs.get(k).feed(k)

// --- 1m swings: candle [1] confirmed by this bar ---
var Zig z1 = Zig.new()
if bar_index >= 2
    bool isH1 = high[2] <= high[1] and high < high[1]
    bool isL1 = low[2] >= low[1] and low > low[1]
    bool hf1 = openRule(open[1], high[1], low[1])
    if hf1
        if z1.visit(SH, high[1], isH1)
            z1.maxSinceH := high
        if z1.visit(SL, low[1], isL1)
            z1.minSinceL := low
    else
        if z1.visit(SL, low[1], isL1)
            z1.minSinceL := low
        if z1.visit(SH, high[1], isH1)
            z1.maxSinceH := high

z1.invalidate(high, low)

// --- bias ---
tfTrend(int j) =>
    trendMode == "fresh" ? tfs.get(j).fresh : tfs.get(j).trend

int kFrom = tRule == "highest" ? 4 : k0
int kTo = tRule == "highest" ? k0 : 4
int bias = 0
for k = kFrom to kTo
    if tfs.get(k).z.pending and tfs.get(k).z.lastType == SL
        bool ok = true
        for j = 0 to k - 1
            if tfTrend(j) != -1
                ok := false
        if ok
            bias := -1
        break
if bias == 0
    for k = kFrom to kTo
        if tfs.get(k).z.pending and tfs.get(k).z.lastType == SH
            bool ok = true
            for j = 0 to k - 1
                if tfTrend(j) != 1
                    ok := false
            if ok
                bias := 1
            break

// --- orders ---
type Pend
    int dir = 0
    float bp
    float sl
    float lim
    int cnt
    int bar
    bool trig = false

method cancelAll(Pend p) =>
    if p.dir != 0
        strategy.cancel(p.dir == 1 ? "Long" : "Short")
        strategy.cancel("Exit")
    p.dir := 0
    p.trig := false
    p

var Pend pend = Pend.new()
var Pend expired = Pend.new()
var int curDay = na
var bool traded = false
var int nClosed = 0

int mod = hour(time, NY) * 60 + minute(time, NY)
int dayKey = year(time, NY) * 10000 + month(time, NY) * 100 + dayofmonth(time, NY)
bool win = mod >= OPEN_MIN - 1 and mod < FLAT_MIN - 1
if na(curDay) or dayKey != curDay
    curDay := dayKey
    traded := false
if strategy.position_size != 0 or strategy.closedtrades != nClosed
    nClosed := strategy.closedtrades
    traded := true
    pend.dir := 0
    pend.trig := false

if strategy.position_size != 0
    if not win
        strategy.close_all(comment = "Session end")
else if not win or traded
    pend.cancelAll()
else
    bool keep = false
    if pend.dir != 0
        float plannedTp = pend.lim + pend.dir * tpTicks * syminfo.mintick
        bool tpReached = tpExpiry == "on" and (pend.dir == 1 ? high >= plannedTp : low <= plannedTp)
        if tpReached
            expired := Pend.new(pend.dir, pend.bp, pend.sl, pend.lim, pend.cnt, pend.bar, pend.trig)
            pend.cancelAll()
            keep := true
        if pend.dir != 0 and not pend.trig and bar_index > pend.bar and (pend.dir == -1 ? low <= pend.bp : high >= pend.bp)
            pend.trig := true  // the stop-limit is now a limit order
        if pend.dir != 0 and (pend.trig or orderMode == "freeze")
            int cnt = pend.dir == -1 ? z1.nH : z1.nL
            if cnt == pend.cnt
                keep := true
            else
                pend.cancelAll()  // next 1m swing high (long: swing low) confirmed before a fill
    if not keep
        int wDir = 0
        float wBp = na
        float wSl = na
        int wCnt = 0
        bool retest = touchedMode == "retest"
        if bias == -1 and z1.pending and z1.lastType == SH and z1.isHL() and (retest or z1.minSinceL > z1.curL)
            wDir := -1
            wBp := z1.curL
            wSl := z1.curH
            wCnt := z1.nH
        else if bias == 1 and z1.pending and z1.lastType == SL and z1.isLH() and (retest or z1.maxSinceH < z1.curH)
            wDir := 1
            wBp := z1.curH
            wSl := z1.curL
            wCnt := z1.nL
        if wDir == 0
            pend.cancelAll()
        else
            int riskTicks = int(math.round(math.abs(wBp - wSl) / syminfo.mintick))
            float wLim = riskTicks > maxRisk ? math.round_to_mintick(wSl + wDir * maxRisk * syminfo.mintick) : wBp
            bool isExpired = expired.dir == wDir and expired.bp == wBp and expired.sl == wSl and expired.lim == wLim and expired.cnt == wCnt
            if not isExpired and not (pend.dir == wDir and pend.bp == wBp and pend.sl == wSl and pend.lim == wLim)
                pend.cancelAll()
                string eid = wDir == 1 ? "Long" : "Short"
                bool through = wDir == -1 ? wBp >= close : wBp <= close  // retest only: already triggered
                if through
                    strategy.entry(eid, wDir == 1 ? strategy.long : strategy.short, limit = wLim)
                else
                    strategy.entry(eid, wDir == 1 ? strategy.long : strategy.short, stop = wBp, limit = wLim)
                strategy.exit("Exit", eid, stop = wSl, profit = tpTicks)
                pend.dir := wDir
                pend.bp := wBp
                pend.sl := wSl
                pend.lim := wLim
                pend.cnt := wCnt
                pend.bar := bar_index
                pend.trig := through

plot(pend.dir != 0 ? pend.bp : na, "Break point (stop-limit trigger)", color.orange, style = plot.style_linebr)
plot(pend.dir != 0 ? pend.sl : na, "Stop loss", color.red, style = plot.style_linebr)
plot(z1.curH, "1m swing high", color.teal, style = plot.style_stepline, display = display.data_window)
plot(z1.curL, "1m swing low", color.maroon, style = plot.style_stepline, display = display.data_window)
plot(bias, "Bias (+1 long, -1 short)", display = display.data_window)
