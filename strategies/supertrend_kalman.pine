// Pine twin of strategies/supertrend_kalman.py: Supertrend + ATR trailing stop (UT Bot) + Kalman trend + volatility
// filter, signals on completed M15 bars, traded on the 1-minute chart. Use on NYMEX:CL1!, 1-minute, standard
// candles, full electronic session, no back-adjustment, Deep Backtesting for long ranges.
// M15 values come from request.security(.., "15", values[1], lookahead_on): the last COMPLETED 15-minute bar,
// read on the first 1m bar of the next one (decision at its close, limit at that close active from the next 1m bar).
// Not in the twin: the tester's roll exit (a position open on a contract's last bar closes at its close). A
// contract's last bar can fall inside a session (NY has 10 such exits 2010-2023, Codex R10), so trades open at a
// roll differ in every variant, most in "All".
//@version=6
strategy("Supertrend Kalman M15 CL1! (tvtester twin)", overlay = true, initial_capital = 50000,
     default_qty_type = strategy.fixed, default_qty_value = 1,
     commission_type = strategy.commission.cash_per_contract, commission_value = 2.01, slippage = 0,
     pyramiding = 0, margin_long = 0, margin_short = 0, calc_on_every_tick = false, calc_on_order_fills = false,
     process_orders_on_close = false, backtest_fill_limits_assumption = 0, use_bar_magnifier = false)

// --- Inputs (set them to a combination from the results doc) ---
string hoursInput = input.string("All", "Hours", options = ["All", "Asia", "London", "NY"])
string triggerInput = input.string("st", "Trigger", options = ["st", "trail", "both"])
string volInput = input.string("none", "Volatility filter", options = ["none", "stop_atr", "atr_ratio", "rvi"])
float volX = input.float(1.5, "Volatility filter X (stop_atr / atr_ratio)", step = 0.1)
string exitInput = input.string("fixed", "Exit", options = ["fixed", "trail", "flip"])
int rrInput = input.int(2, "Target: RR x signal risk", minval = 1)
int swingInput = input.int(3, "Swing strength (M15 bars each side)", minval = 1)
float trailMult = input.float(2.0, "ATR trail multiple", step = 0.5)
float kalmanQ = input.float(0.01, "Kalman q", step = 0.0001)
float stFactor = input.float(3.0, "Supertrend factor")
int atrLen = input.int(10, "Supertrend / trail ATR length")

// --- Exit management (exit study, tvtester/exits.py). Defaults = off. T = target distance in ticks (profit ticks,
// or |limit - fill| for a price target). Stops move at the bar close, work from the next bar, never loosen ---
string X = "Exit management (exit study)"
string beStyle = input.string("none", "Breakeven", options = ["none", "touch", "close", "time"], group = X)
float beX = input.float(0, "Breakeven trigger (x T; bars for time)", step = 0.25, group = X)
int beOffset = input.int(0, "Breakeven offset (ticks beyond entry)", minval = 0, group = X)
string trailStyle = input.string("none", "Trailing", options = ["none", "frac", "atr", "swing", "step", "close", "ema", "sar"], group = X)
float trailAt = input.float(0, "Trailing starts at (x T)", step = 0.25, group = X)
float trailX = input.float(0, "Trailing setting (x T / ATR k / pivot or EMA bars / SAR set 0-1)", step = 0.25, group = X)
bool keepTarget = input.bool(true, "Keep target (off needs trailing or time exit)", group = X)
int timeExit = input.int(0, "Time exit after N bars (0 = off)", minval = 0, group = X)
if not keepTarget and trailStyle == "none" and timeExit == 0
    runtime.error("Keep target off needs a trailing stop or a time exit")

// --- Entry filters (feature 2, docs/strategies/supertrend_kalman/optimize/README.md). "off" = the plain strategy.
// A vetoed M15 event expires, as any untaken event does. NaN (na) fails an enabled filter.
string F = "Filters (feature 2)"
string fRiskMode = input.string("off", "Risk (ticks)", options = ["off", "min", "max"], group = F, inline = "f1")
float fRiskThr = input.float(0, "", group = F, inline = "f1")
string fRiskAtrMode = input.string("off", "Risk / ATR14", options = ["off", "min", "max"], group = F, inline = "f2")
float fRiskAtrThr = input.float(0, "", step = 0.25, group = F, inline = "f2")
string fAtrRatioMode = input.string("off", "ATR14 / ATR100", options = ["off", "min", "max"], group = F, inline = "f3")
float fAtrRatioThr = input.float(0, "", step = 0.1, group = F, inline = "f3")
string fErMode = input.string("off", "Efficiency ratio (20)", options = ["off", "min", "max"], group = F, inline = "f4")
float fErThr = input.float(0, "", step = 0.05, group = F, inline = "f4")
string fHoursMode = input.string("off", "Hours since 18:00 NY", options = ["off", "min", "max"], group = F, inline = "f5")
float fHoursThr = input.float(0, "", step = 1, group = F, inline = "f5")
string fRviMode = input.string("off", "RVI on trade side", options = ["off", "min", "max"], group = F, inline = "f6")
float fRviThr = input.float(0, "", step = 5, group = F, inline = "f6")

passes(string mode, float v, float thr) =>
    mode == "off" ? true : na(v) ? false : mode == "min" ? v >= thr : v <= thr

// --- M15 helpers (run inside the M15 context, on every M15 bar) ---
// UT Bot ATR trailing stop, close source
utStop(float src, float nLoss) =>
    var float t = na
    float p = nz(t[1], 0)
    float v = na
    if not na(nLoss)
        v := src > p and src[1] > p ? math.max(p, src - nLoss) : src < p and src[1] < p ? math.min(p, src + nLoss) : src > p ? src - nLoss : src + nLoss
    t := v
    t

// 2-state constant-velocity Kalman filter (level, slope); first bar: x = [z, 0], P = 100 I; Joseph update
kalmanSlope(float z, float q) =>
    var float x0 = na
    var float x1 = 0.0
    var float a = 100.0
    var float b = 0.0
    var float d = 100.0
    if na(x0)
        x0 := z
    else
        x0 := x0 + x1
        float pa = a + 2 * b + d + 0.25 * q
        float pb = b + d + 0.5 * q
        float pd = d + q
        float s = pa + 1.0
        float k0 = pa / s
        float k1 = pb / s
        float y = z - x0
        x0 := x0 + k0 * y
        x1 := x1 + k1 * y
        a := (1 - k0) * (1 - k0) * pa + k0 * k0
        b := (1 - k0) * (pb - k1 * pa) + k0 * k1
        d := k1 * k1 * pa - 2 * k1 * pb + pd + k1 * k1
    x1

// strict pivot confirmed `n` bars after its centre, last confirmed value carried forward
lastPivot(float x, int n, bool isHigh) =>
    var float last = na
    bool ok = not na(x[2 * n])
    if ok
        for k = 0 to 2 * n
            if k != n
                ok := ok and (isHigh ? x[n] > x[k] : x[n] < x[k])
    if ok
        last := x[n]
    last

m15() =>
    [stLine, stDir] = ta.supertrend(stFactor, atrLen)
    float t = utStop(close, trailMult * ta.atr(atrLen))
    float ks = kalmanSlope(close, kalmanQ)
    float swLo = lastPivot(low, swingInput, false)
    float swHi = lastPivot(high, swingInput, true)
    float a14 = ta.atr(14)
    float a100 = ta.atr(100)
    float sd = ta.stdev(close, 10)
    float ch = ta.change(close)
    float up = ta.ema(na(sd) or na(ch) ? na : ch <= 0 ? 0.0 : sd, 14)
    float dn = ta.ema(na(sd) or na(ch) ? na : ch > 0 ? 0.0 : sd, 14)
    float rv = up + dn > 0 ? 100 * up / (up + dn) : na
    float er = math.abs(close - close[20]) / math.sum(math.abs(ta.change(close)), 20)
    bool stUp = stDir == -1
    bool stDn = stDir == 1
    bool lg = false
    bool sh = false
    if triggerInput == "st"
        lg := stUp and stDn[1]
        sh := stDn and stUp[1]
    else if triggerInput == "trail"
        lg := close > t and close[1] <= t[1] and stUp
        sh := close < t and close[1] >= t[1] and stDn
    else
        bool aUp = stUp and close > t
        bool aDn = stDn and close < t
        lg := aUp and not aUp[1]
        sh := aDn and not aDn[1]
    int sig = lg and ks > 0 ? 1 : sh and ks < 0 ? -1 : 0
    [sig[1], stDir[1], t[1], swLo[1], swHi[1], a14[1], a100[1], rv[1], er[1], time[1]]

[sigB, stDirB, utB, swLoB, swHiB, a14B, a100B, rviB, erB, timeB] = request.security(syminfo.tickerid, "15", m15(),
     gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)

// --- 1m chart: hours, decisions, orders ---
string tz = hoursInput == "Asia" ? "Asia/Shanghai" : hoursInput == "London" ? "Europe/London" : "America/New_York"
int openMinute = hoursInput == "London" ? 8 * 60 : 9 * 60
int flatMinute = hoursInput == "Asia" ? 15 * 60 : hoursInput == "London" ? 13 * 60 : 14 * 60 + 30
int minuteOfDay = hour(time, tz) * 60 + minute(time, tz)
bool inHours = hoursInput == "All" or (minuteOfDay >= openMinute and minuteOfDay < flatMinute - 1)
bool newBucket = not na(timeB) and timeB != timeB[1]

// Exit-management indicators: computed on every bar, flat or not (as the Python twin)
int xLen = math.max(1, int(trailX))
float xAtr = ta.atr(14)
float xEma = ta.ema(close, xLen)
float xPl = ta.pivotlow(low, xLen, xLen)
float xPh = ta.pivothigh(high, xLen, xLen)
var float lastPl = na
var float lastPh = na
if not na(xPl)
    lastPl := xPl
if not na(xPh)
    lastPh := xPh
bool sarSlow = int(trailX) == 1
float xSar = ta.sar(sarSlow ? 0.01 : 0.02, sarSlow ? 0.01 : 0.02, sarSlow ? 0.1 : 0.2)
bool exitRuleOn = beStyle != "none" or trailStyle != "none" or timeExit > 0
f_toward(float x, bool isLong) =>
    isLong ? math.floor(x / syminfo.mintick + 1e-6) * syminfo.mintick : math.ceil(x / syminfo.mintick - 1e-6) * syminfo.mintick
// New stop at this close: tightest active level, only if tighter than stopNow (else na)
f_newStop(bool isLong, float entry, int tTicks, float stopNow, float best, float bestClose, int age) =>
    float dir = isLong ? 1.0 : -1.0
    float mt = syminfo.mintick
    float fav = math.round((best - entry) * dir / mt)
    float cfav = math.round((close - entry) * dir / mt)
    float lvl = na
    bool beHit = beStyle == "touch" ? fav >= math.round(beX * tTicks) : beStyle == "close" ? cfav >= math.round(beX * tTicks) : beStyle == "time" ? age >= beX and cfav > beOffset : false
    if beHit
        lvl := entry + dir * beOffset * mt
    if trailStyle != "none" and fav >= math.round(trailAt * tTicks)
        float t = na
        if trailStyle == "frac"
            t := best - dir * math.max(1, math.round(trailX * tTicks)) * mt
        else if trailStyle == "close"
            t := bestClose - dir * math.max(1, math.round(trailX * tTicks)) * mt
        else if trailStyle == "step"
            float s = math.max(1, math.round(trailX * tTicks))
            float m = math.floor(fav / s)
            t := m >= 1 ? entry + dir * (m - 1) * s * mt : na
        else if trailStyle == "atr"
            t := na(xAtr) ? na : f_toward(best - dir * trailX * xAtr, isLong)
        else if trailStyle == "swing"
            t := isLong ? lastPl : lastPh
        else
            float x = trailStyle == "ema" ? xEma : xSar
            t := na(x) or (x - close) * dir >= 0 ? na : f_toward(x, isLong)
        if not na(t)
            lvl := na(lvl) ? t : isLong ? math.max(lvl, t) : math.min(lvl, t)
    not na(lvl) and (lvl - stopNow) * dir > mt / 2 ? lvl : na
var float stopLvl = na
var int profitTicks = na
var float bestPx = na
var float bestClose = na
var string eid = ""
var int pendingDir = 0
var float pendingTp = na
var int pendingClosed = 0
if strategy.position_size != 0 or strategy.closedtrades != pendingClosed
    pendingDir := 0
pendingClosed := strategy.closedtrades
if strategy.position_size == 0 and pendingDir != 0
    bool tpReached = pendingDir == 1 ? high >= pendingTp : low <= pendingTp
    if tpReached or not inHours
        strategy.cancel(eid)
        strategy.cancel("Exit")
        pendingDir := 0


if strategy.position_size != 0
    bool isLong = strategy.position_size > 0
    if hoursInput != "All" and not inHours
        strategy.cancel("Exit")
        strategy.close_all(comment = "Session end")
    else if newBucket and exitInput == "flip" and stDirB == (isLong ? 1 : -1)
        strategy.cancel("Exit")
        strategy.close_all(comment = "ST flip")
    else
        int eb = strategy.opentrades.entry_bar_index(0)
        int age = bar_index - eb + 1
        if eb == bar_index
            bestPx := isLong ? high : low
            bestClose := close
        else
            bestPx := isLong ? math.max(bestPx, high) : math.min(bestPx, low)
            bestClose := isLong ? math.max(bestClose, close) : math.min(bestClose, close)
        if timeExit > 0 and age >= timeExit
            strategy.cancel("Exit")
            strategy.close_all(comment = "Time exit")
        else
            float ns = na
            if newBucket and exitInput == "trail" and not na(utB)
                float tt = isLong ? math.floor(utB / syminfo.mintick + 1e-6) * syminfo.mintick : math.ceil(utB / syminfo.mintick - 1e-6) * syminfo.mintick
                if (isLong and tt > stopLvl and tt < close) or (not isLong and tt < stopLvl and tt > close)
                    ns := tt
            if exitRuleOn
                float ms = f_newStop(isLong, strategy.position_avg_price, profitTicks, na(ns) ? stopLvl : ns, bestPx, bestClose, age)
                if not na(ms)
                    ns := ms
            if not na(ns)
                stopLvl := ns
                strategy.exit("Exit", eid, stop = stopLvl, profit = keepTarget ? profitTicks : na)
else if pendingDir == 0 and newBucket and sigB != 0 and inHours
    float lvl = sigB == 1 ? swLoB : swHiB
    if not na(lvl) and (sigB == 1 ? lvl < close : lvl > close)
        int riskTicks = math.round(math.abs(close - lvl) / syminfo.mintick)
        bool volOk = volInput == "stop_atr" ? riskTicks <= volX * a14B / syminfo.mintick : volInput == "atr_ratio" ? a14B <= volX * a100B : volInput == "rvi" ? (sigB == 1 ? rviB > 50 : rviB < 50) : true
        float riskT = float(riskTicks)
        float a14T = a14B / syminfo.mintick
        int nyMinute = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
        float hoursSince = math.floor(((nyMinute - 18 * 60 + 1440) % 1440) / 60)
        float rviSide = sigB == 1 ? rviB : 100 - rviB
        bool filtersOk = passes(fRiskMode, riskT, fRiskThr) and passes(fRiskAtrMode, a14T > 0 ? riskT / a14T : na, fRiskAtrThr) and passes(fAtrRatioMode, a100B > 0 ? a14B / a100B : na, fAtrRatioThr) and passes(fErMode, erB, fErThr) and passes(fHoursMode, hoursSince, fHoursThr) and passes(fRviMode, rviSide, fRviThr)
        if volOk and filtersOk
            eid := sigB == 1 ? "Long" : "Short"
            stopLvl := lvl
            profitTicks := riskTicks * rrInput
            pendingDir := sigB
            pendingTp := close + sigB * profitTicks * syminfo.mintick
            strategy.entry(eid, sigB == 1 ? strategy.long : strategy.short, limit = close)
            strategy.exit("Exit", eid, stop = lvl, profit = keepTarget ? profitTicks : na)

plot(strategy.position_size != 0 ? stopLvl : na, "Stop", color.red, style = plot.style_linebr)
