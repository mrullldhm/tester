// Pine twin of strategies/elliott_wave.py (Elliott Wave 5: AO wave count, wave-4 pullback limit entry).
// Sources: "10 Seconds Elliott Wave" (iTradeAIMS, after Bill Williams) and markokrivokapic.com Fibonacci ratios.
// Same properties, setups and trade rules as the Python tester, so trades can be checked against it.
// Use on NYMEX:CL1!, 1-minute chart, Deep Backtesting for long ranges.
// Not in the twin: the tester's roll rules (a position open on a contract's last bar closes at its close, and an
// unfilled entry is cancelled there). Intraday sessions never hold across the 00:00 UTC roll switch.
// AO is kept exact in ticks: ao = 34 * sum5(h + l) - 5 * sum34(h + l) = 340 x AO, same sign and order as AO.
//@version=6
strategy("Elliott Wave 5 CL1! (tvtester twin)", overlay = true, initial_capital = 50000,
     default_qty_type = strategy.fixed, default_qty_value = 1,
     commission_type = strategy.commission.cash_per_contract, commission_value = 2.01, slippage = 0,
     pyramiding = 0, margin_long = 0, margin_short = 0, calc_on_every_tick = false, calc_on_order_fills = false,
     process_orders_on_close = false, backtest_fill_limits_assumption = 0, use_bar_magnifier = false)

if not (timeframe.isminutes and timeframe.multiplier == 1)
    runtime.error("Use a 1-minute chart; owner swing ordering must use the underlying 1-minute candles.")

// --- Inputs (set them to a combination from docs/strategies/elliott_wave/results.md) ---
string sessionInput = input.string("NY", "Session", options = ["Asia", "London", "NY"])
int windowInput = input.int(120, "Wave window (bars; book: 100-140)", minval = 10, maxval = 500)
float entryRInput = input.float(0.382, "Entry: wave-4 retracement of L", minval = 0.01, maxval = 0.99, step = 0.001)
float stopRInput = input.float(0.618, "Stop: wave-4 retracement of L", minval = 0.01, maxval = 0.99, step = 0.001)
float tpXInput = input.float(0.618, "Target: x L from the limit (TZ1 0.618 / TZ2 1.0)", minval = 0.01, step = 0.001)
int minLenInput = input.int(20, "Minimum wave length L (ticks)", minval = 1)
if not (entryRInput < stopRInput)
    runtime.error("Entry retracement must be smaller than the stop retracement")

// --- Session clock: own time zone per session (US, UK and Asia change clocks on different dates) ---
string tz = sessionInput == "Asia" ? "Asia/Shanghai" : sessionInput == "London" ? "Europe/London" : "America/New_York"
int openMinute = sessionInput == "London" ? 8 * 60 : 9 * 60
int flatMinute = sessionInput == "Asia" ? 15 * 60 : sessionInput == "London" ? 13 * 60 : 14 * 60 + 30
int minuteOfDay = hour(time, tz) * 60 + minute(time, tz)
bool inSession = minuteOfDay >= openMinute and minuteOfDay < flatMinute - 1

// Mandatory owner swing state; no inputs can alter detection.
const int SH = 1
const int SL = -1
openRule(float o, float h, float l) =>
    (h - o) < (o - l)

type Zig
    int lastType = 0
    float lastPrice
    float curH
    float prevH
    float curL
    float prevL
    float hiSinceL
    float loSinceH
    int nH = 0
    int nL = 0
    bool pending = false
    int savedLastType = 0
    float savedLastPrice
    float savedCurH
    float savedPrevH
    float savedCurL
    float savedPrevL
    float savedHiSinceL
    float savedLoSinceH


// Only the newest endpoint is provisional. At a close, accept qualifying opposite pivots before touch removal.
method remember(Zig z) =>
    z.savedLastType := z.lastType
    z.savedLastPrice := z.lastPrice
    z.savedCurH := z.curH
    z.savedPrevH := z.prevH
    z.savedCurL := z.curL
    z.savedPrevL := z.prevL
    z.savedHiSinceL := z.hiSinceL
    z.savedLoSinceH := z.loSinceH
    z

method invalidate(Zig z, float h, float l) =>
    bool removed = z.pending and (z.lastType == SH ? h >= z.lastPrice : l <= z.lastPrice)
    if removed
        float observedH = z.hiSinceL
        float observedL = z.loSinceH
        if z.lastType == SH
            z.nH += 1
        else
            z.nL += 1
        z.lastType := z.savedLastType
        z.lastPrice := z.savedLastPrice
        z.curH := z.savedCurH
        z.prevH := z.savedPrevH
        z.curL := z.savedCurL
        z.prevL := z.savedPrevL
        z.hiSinceL := z.savedHiSinceL
        z.loSinceH := z.savedLoSinceH
        z.pending := false
        if not na(observedH)
            z.hiSinceL := na(z.hiSinceL) ? observedH : math.max(z.hiSinceL, observedH)
        if not na(observedL)
            z.loSinceH := na(z.loSinceH) ? observedL : math.min(z.loSinceH, observedL)
        if not na(z.hiSinceL)
            z.hiSinceL := math.max(z.hiSinceL, h)
        if not na(z.loSinceH)
            z.loSinceH := math.min(z.loSinceH, l)
    removed

// Owner indicator push: same type replaces when at least as extreme (equal: the later), else dropped
method push(Zig z, int t, float p) =>
    bool added = true
    bool accepts = z.lastType != t or (t == SH ? p >= z.lastPrice : p <= z.lastPrice)
    if accepts
        if z.lastType != t or not z.pending
            z.remember()
        z.pending := true
    if z.lastType == t
        added := t == SH ? p >= z.lastPrice : p <= z.lastPrice
        if added
            z.lastPrice := p
            if t == SH
                z.curH := p
                z.nH += 1
            else
                z.curL := p
                z.nL += 1
    else
        if t == SH
            z.prevH := z.curH
            z.curH := p
            z.nH += 1
        else
            z.prevL := z.curL
            z.curL := p
            z.nL += 1
        z.lastType := t
        z.lastPrice := p
    added

// Owner clarification, 2026-11-05: observe every candle, accept only leg-extreme fixed-rule pivots.
method visit(Zig z, int t, float p, bool isPivot) =>
    bool extreme = t == SH ? (na(z.hiSinceL) or p >= z.hiSinceL) : (na(z.loSinceH) or p <= z.loSinceH)
    bool added = false
    if isPivot and extreme
        added := z.push(t, p)
        if added
            if t == SH
                z.loSinceH := p
            else
                z.hiSinceL := p
    if z.pending
        if t == SH and not na(z.savedHiSinceL)
            z.savedHiSinceL := math.max(z.savedHiSinceL, p)
        if t == SL and not na(z.savedLoSinceH)
            z.savedLoSinceH := math.min(z.savedLoSinceH, p)
    if t == SH and not na(z.hiSinceL)
        z.hiSinceL := math.max(z.hiSinceL, p)
    if t == SL and not na(z.loSinceH)
        z.loSinceH := math.min(z.loSinceH, p)
    added

method isHL(Zig z) =>
    not na(z.prevL) and z.curL > z.prevL

method isLH(Zig z) =>
    not na(z.prevH) and z.curH < z.prevH

var Zig owner = Zig.new()
if bar_index >= 2 and barstate.isconfirmed
    bool isH = high[2] <= high[1] and high < high[1]
    bool isL = low[2] >= low[1] and low > low[1]
    if openRule(open[1], high[1], low[1])
        owner.visit(SH, high[1], isH)
        owner.visit(SL, low[1], isL)
    else
        owner.visit(SL, low[1], isL)
        owner.visit(SH, high[1], isH)
owner.invalidate(high, low)

// --- Awesome Oscillator (exact, ticks) and AO humps ---
float mt = syminfo.mintick
float hlT = math.round(high / mt) + math.round(low / mt)
float ao = bar_index >= 33 ? 34 * math.sum(hlT, 5) - 5 * math.sum(hlT, 34) : na
float prevAo = ao[1]
// Bull hump: from the bar AO turns >= 0. Highest high (equal: later), lowest low after it, largest AO. Bear: mirror.
var float bHi = na
var float bAfter = na
var float bAo = na
var float sLo = na
var float sAfter = na
var float sAo = na
if not na(ao)
    bool up = ao >= 0
    bool known = not na(prevAo)
    if up and known and prevAo < 0
        bHi := high
        bAfter := na
        bAo := ao
    else if not na(bHi)
        if high >= bHi
            bHi := high
            bAfter := na
        else
            bAfter := na(bAfter) ? low : math.min(bAfter, low)
        bAo := math.max(bAo, ao)
    if not up and known and prevAo >= 0
        sLo := low
        sAfter := na
        sAo := ao
    else if not na(sLo)
        if low <= sLo
            sLo := low
            sAfter := na
        else
            sAfter := na(sAfter) ? high : math.max(sAfter, high)
        sAo := math.min(sAo, ao)

float wMax = ta.highest(ao, windowInput)
float wMin = ta.lowest(ao, windowInput)
float loN = ta.lowest(low, windowInput)
float hiN = ta.highest(high, windowInput)

// --- Setups at this close: wave 3 = tallest AO peak of the window in the current hump, wave 4 = AO zero cross ---
bool longSig = false
bool shortSig = false
float sigLimit = na
float sigStop = na
float sigTp = na
if inSession and bar_index >= windowInput + 32 and not na(wMax) and not na(prevAo)
    if ao < 0 and prevAo >= 0 and not na(bAfter) and wMax > 0 and bAo == wMax and wMax > -wMin and owner.curH == bHi
        int topT = int(math.round(bHi / mt))
        int lenT = topT - int(math.round(loN / mt))
        int stT = topT - int(math.round(stopRInput * lenT))
        if lenT >= minLenInput and math.round(bAfter / mt) > stT
            int limT = math.min(topT - int(math.round(entryRInput * lenT)), int(math.round(close / mt)))
            longSig := true
            sigLimit := limT * mt
            sigStop := stT * mt
            sigTp := (limT + int(math.round(tpXInput * lenT))) * mt
    if ao >= 0 and prevAo < 0 and not na(sAfter) and wMin < 0 and sAo == wMin and -wMin > wMax and owner.curL == sLo
        int botT = int(math.round(sLo / mt))
        int lenT = int(math.round(hiN / mt)) - botT
        int stT = botT + int(math.round(stopRInput * lenT))
        if lenT >= minLenInput and math.round(sAfter / mt) < stT
            int limT = math.max(botT + int(math.round(entryRInput * lenT)), int(math.round(close / mt)))
            shortSig := true
            sigLimit := limT * mt
            sigStop := stT * mt
            sigTp := (limT - int(math.round(tpXInput * lenT))) * mt

// --- Trade rules: limit entry only, bracket attached; unfilled limit cancelled at a close that finds the
// planned target touched, or outside the session; position closed at the first close outside the session ---
var string eid = ""
var int pendingDir = 0
var float pendingTp = na
var int pendingClosed = 0
if strategy.position_size != 0 or strategy.closedtrades != pendingClosed
    pendingDir := 0
pendingClosed := strategy.closedtrades
if strategy.position_size == 0 and pendingDir != 0
    bool tpReached = pendingDir == 1 ? high >= pendingTp : low <= pendingTp
    if tpReached or not inSession
        strategy.cancel(eid)
        strategy.cancel("Exit")
        pendingDir := 0

if strategy.position_size != 0 and not inSession
    strategy.close_all(comment = "Session end")
else if strategy.position_size == 0 and pendingDir == 0 and inSession and (longSig or shortSig)
    eid := longSig ? "Long" : "Short"
    pendingDir := longSig ? 1 : -1
    pendingTp := sigTp
    strategy.entry(eid, longSig ? strategy.long : strategy.short, limit = sigLimit)
    strategy.exit("Exit", eid, stop = sigStop, limit = sigTp)

plotshape(longSig, title = "Wave 4 long", style = shape.labelup, location = location.belowbar, color = #089981, text = "W4", textcolor = color.white, size = size.tiny)
plotshape(shortSig, title = "Wave 4 short", style = shape.labeldown, location = location.abovebar, color = #f23645, text = "W4", textcolor = color.white, size = size.tiny)
plot(longSig or shortSig ? sigLimit : na, "Limit", color = #5b9cf6, style = plot.style_circles)
plot(longSig or shortSig ? sigStop : na, "Stop", color = #f23645, style = plot.style_circles)
plot(longSig or shortSig ? sigTp : na, "Target", color = #089981, style = plot.style_circles)
